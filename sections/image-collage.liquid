{{ 'section-image-collage.css' | asset_url | stylesheet_tag }}

{% liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank or section.settings.subheading != blank
      assign enable_animation = true
    endif
  endif

  assign heading_delay = 0

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign subheading_delay = heading_delay | plus: words_delay

  assign description_delay = subheading_delay | plus: 0.1
%}

{%- if section.settings.enable_parallax or enable_animation -%}
  <script src="{{ 'image-collage.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  {%- if section.blocks.size == 1 -%}
    {% style %}
      #shopify-section-{{ section.id }} .image-collage__grid {
        grid-template-columns: 31.11% ;
      }
    {% endstyle %}
  {%- endif -%}

  {%- if section.blocks.size == 2 -%}
    {% style %}
      #shopify-section-{{ section.id }} .image-collage__grid {
        grid-template-columns: 31.11% 32.22%;
      }
    {% endstyle %}
  {%- endif -%}

  {%- if section.blocks.size == 3 -%}
    {% style %}
      #shopify-section-{{ section.id }} .image-collage__grid {
        grid-template-columns: 1fr 1.01fr 1fr;
      }
    {% endstyle %}
  {%- endif -%}
{%- endif -%}

{% style %}
  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} .image-collage__grid{
      gap: 2.4rem;
    }

    #shopify-section-{{ section.id }} .image-collage__grid .image-collage-block+.image-collage-block {
      margin-top: 2.4rem;
    }
  }
  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} .image-collage__grid{
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }
{% endstyle %}

{% if enable_animation %}
  {% style %}
    #shopify-section-{{ section.id }} [data-enable-header-animation] .image-collage__heading .word {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
      white-space: nowrap;
    }

     #shopify-section-{{ section.id }} [data-enable-header-animation] .image-collage__subheading {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
    }

    #shopify-section-{{ section.id }} [data-enable-header-animation] .image-collage__description {
      opacity: 0;
      transform: translateY(20px);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .image-collage__heading .word {
      animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: calc(var(--heading-delay) + (var(--word-index) * 0.1s));
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .image-collage__subheading {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--subheading-delay);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .image-collage__description {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--description-delay);
    }
  {% endstyle %}
{% endif %}

<div
  class="image-collage image-collage-{{ section.id }} color-{{ section.settings.main_color_scheme }} background section-{{ section.id }}-padding{% if section.settings.enable_border_top %} image-collage--border-top{% endif %}{% if section.settings.enable_border_bottom %} image-collage--border-bottom{% endif %}"
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s; --subheading-delay: {{ subheading_delay }}s;"
  {% endif %}
>
  {% if section.settings.heading != blank
    or section.settings.description != blank
    or section.settings.subheading != blank
  %}
    <div class="container">
      <div class="image-collage__text-content image-collage__text-content--{{ section.settings.text_align }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_level }} class="image-collage__heading {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <{{ section.settings.heading_tag }} class="image-collage__subheading h4">
            {{- section.settings.subheading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="image-collage__description body-normal rte">
            {{- section.settings.description -}}
          </div>
        {%- endif -%}
      </div>
    </div>
  {% endif %}

  {%- if section.blocks.size > 0 -%}
    <div class="image-collage__grid">
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}
</div>

