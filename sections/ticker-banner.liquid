{{ 'section-ticker-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign language_code = request.locale.iso_code | split: '-' | first
  assign site_dir = 'ltr'

  case language_code
    when 'ae', 'ar', 'arc', 'bcc', 'bqi', 'ckb', 'dv', 'fa', 'glk', 'ha', 'he', 'kwh', 'ks', 'ku', 'mzn', 'nqo', 'pnb', 'ps', 'sd', 'ug', 'ur', 'yi'
      assign site_dir = 'rtl'
  endcase
%}

<div
  class="ticker-banner{% if section.settings.enable_border_top %} ticker-banner--border-top{% endif %}{% if section.settings.enable_border_bottom %} ticker-banner--border-bottom{% endif %}"
  id="ticker-banner-{{ section.id }}"
>
  <div class="ticker-banner__container color-{{ section.settings.color_scheme }} content">
    {% if section.blocks.size > 0 %}
      {% assign total_length = 0 %}

      {% assign is_image = false %}
      {% for block in section.blocks %}
        {% if block.settings.image != blank and block.settings.ticker_text == blank %}
          {% assign is_image = true %}
        {% endif %}
        {% assign text = block.settings.ticker_text | strip %}
        {% assign total_length = total_length | plus: text.size %}
      {% endfor %}

      {% if is_image and total_length == 0 %}
        {% assign total_length = 1 %}
      {% endif %}

      {% assign ticker_elements_count = 128 | divided_by: total_length | at_least: 1 | plus: 1 %}
      {% assign speed = 204 | minus: section.settings.ticker_speed %}
      <div class="ticker-banner__main">
        <div
          class="ticker-banner__ticker"
          style="--ticker-banner-ticker-speed: {{ speed }}s;"
        >
          <div class="ticker-banner__ticker-wrapper">
            {% if site_dir == 'rtl' %}
              {% for collection_index in (1..2) reversed %}
                <span class="ticker-banner__ticker-collection ticker-banner__ticker-collection--{{ collection_index }}">
                  {% for i in (1..ticker_elements_count) %}
                    {% for block in section.blocks %}
                      {% if forloop.index != section.blocks.size %}
                        {% assign next_index = forloop.index0 | plus: 1 %}
                      {% else %}
                        {% assign next_index = 0 %}
                      {% endif %}

                      {% assign next_block = section.blocks[next_index] %}
                      {% assign next_image = false %}
                      {% if next_block and next_block.settings.image != blank %}
                        {% assign next_image = true %}
                      {% endif %}
                      {% if block.settings.image != blank or block.settings.ticker_text != blank %}
                        <span
                          class="ticker-banner__ticker-item {{ section.settings.heading_size_ticker }} {% if next_image %} ticker-banner__ticker-item--small-margin {% endif %}"
                          {{ block.shopify_attributes }}
                        >
                          {% if block.settings.image %}
                            {{
                              block.settings.image
                              | image_url: width: 270
                              | image_tag: widths: '90, 180, 270', sizes: '90px', class: 'ticker-banner__ticker-image'
                            }}
                          {% endif %}
                          {% if block.settings.ticker_text != blank %}
                            <span class="ticker-banner__ticker-text">
                              {{ block.settings.ticker_text }}
                            </span>
                          {% endif %}
                        </span>
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </span>
              {% endfor %}
            {% else %}
              {% for collection_index in (1..2) %}
                <span class="ticker-banner__ticker-collection ticker-banner__ticker-collection--{{ collection_index }}">
                  {% for i in (1..ticker_elements_count) %}
                    {% for block in section.blocks %}
                      {% if forloop.index != section.blocks.size %}
                        {% assign next_index = forloop.index0 | plus: 1 %}
                      {% else %}
                        {% assign next_index = 0 %}
                      {% endif %}

                      {% assign next_block = section.blocks[next_index] %}
                      {% assign next_image = false %}
                      {% if next_block and next_block.settings.image != blank %}
                        {% assign next_image = true %}
                      {% endif %}
                      {% if block.settings.image != blank or block.settings.ticker_text != blank %}
                        <span
                          class="ticker-banner__ticker-item {{ section.settings.heading_size_ticker }} {% if next_image %} ticker-banner__ticker-item--small-margin {% endif %}"
                          {{ block.shopify_attributes }}
                        >
                          {% if block.settings.image %}
                            {{
                              block.settings.image
                              | image_url: width: 270
                              | image_tag: widths: '90, 180, 270', sizes: '90px', class: 'ticker-banner__ticker-image'
                            }}
                          {% endif %}
                          {% if block.settings.ticker_text != blank %}
                            <span class="ticker-banner__ticker-text">
                              {{ block.settings.ticker_text }}
                            </span>
                          {% endif %}
                        </span>
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </span>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.ticker-banner.name",
  "tag": "section",
  "class": "ticker-banner-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.ticker-banner.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "default": true,
      "label": "t:sections.all.enable_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_bottom",
      "default": true,
      "label": "t:sections.all.enable_border_bottom.label"
    },
    {
      "type": "select",
      "id": "heading_size_ticker",
      "options": [
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.ticker-banner.settings.heading_size_ticker.label"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "t:sections.ticker-banner.settings.ticker_speed.label",
      "min": 2,
      "max": 200,
      "step": 2,
      "default": 72
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "t:sections.ticker-banner.blocks.ticker_item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.ticker-banner.blocks.ticker_item.settings.image.label"
        },
        {
          "type": "text",
          "id": "ticker_text",
          "label": "t:sections.ticker-banner.blocks.ticker_item.settings.ticker_text.label",
          "default": "t:sections.ticker-banner.blocks.ticker_item.settings.ticker_text.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ticker-banner.name",
      "category": "t:sections.categories.banners",
      "blocks": [
        {
          "type": "ticker_item"
        },
        {
          "type": "ticker_item"
        },
        {
          "type": "ticker_item"
        }
      ]
    }
  ]
}
{% endschema %}
