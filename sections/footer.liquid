        {%- endif -%}

        {%- if section.settings.brand_image_left != blank or section.settings.brand_image_right != blank -%}
          <div class="footer-brand">
            {%- if section.settings.brand_image_left != blank -%}
              <div class="footer-brand__media">
                {{
                  section.settings.brand_image_left
                  | image_url: width: 800
                  | image_tag:
                    class: 'footer-brand__image',
                    widths: '200, 400, 800',
                    sizes: '240px',
                    alt: section.settings.brand_image_left.alt | default: shop.name
