                      {%- for index in (1..6) -%}
                        {%- liquid
                          assign label_key = 'link_' | append: index | append: '_label'
                          assign url_key = 'link_' | append: index | append: '_url'
                          assign link_label = block.settings[label_key]
                          assign link_url = block.settings[url_key]
                        -%}
                        {%- if link_label != blank -%}
                          <li class="footer-menu-block-list__item">
                            <a href="{{ link_url | default: '#' }}" class="footer-menu-block-list__link focus-inset">
                              <span class="body-small">{{ link_label | escape }}</span>
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
