            </ul>
          {%- endif -%}

          {% comment %} ----- POLICIES ----- {% endcomment %}
          {%- if section.settings.show_policy -%}
            <ul class="footer-policies footer-policies--compact list-unstyled">
              <li class="footer-policies__item">
                <a
                  href="{% if shop.privacy_policy != blank %}{{ shop.privacy_policy.url }}{% else %}/policies/privacy-policy{% endif %}"
                  class="footer-policies__link focus-inset"
                >
                  <span class="body-xs">Privacy Policy</span>
                </a>
              </li>
              <li class="footer-policies__item">
                <a
                  href="{% if shop.terms_of_service != blank %}{{ shop.terms_of_service.url }}{% else %}/policies/terms-of-service{% endif %}"
                  class="footer-policies__link focus-inset"
                >
                  <span class="body-xs">Terms of Service</span>
                </a>
              </li>
            </ul>
            <ul class="footer-policies list-unstyled">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
