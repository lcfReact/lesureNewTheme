{{- 'section-footer.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'footer.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-right: {{ section.settings.margin_right_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    margin-left: {{ section.settings.margin_left_mobile }}px;
  }
  #shopify-section-{{ section.id }} .footer.footer--brand {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-right: {{ section.settings.padding_right_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | plus: 13 }}px;
    padding-left: {{ section.settings.padding_left_mobile }}px;
  }
  #shopify-section-{{ section.id }} .footer--brand .container,
  #shopify-section-{{ section.id }} .footer--brand .footer-top-container,
  #shopify-section-{{ section.id }} .footer--brand .footer-main-container {
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .footer--brand .footer-subscribe-form__heading {
    margin-top: 0;
  }
  #shopify-section-{{ section.id }} .footer--brand .footer-brand {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .footer--brand .footer-brand__media {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    min-width: 0;
    max-width: 48%;
  }
  #shopify-section-{{ section.id }} .footer--brand .footer-brand__media--end {
    margin-left: auto;
    justify-content: flex-end;
  }
  #shopify-section-{{ section.id }} .footer--brand .footer-brand__image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 120px;
    object-fit: contain;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-right: {{ section.settings.margin_right_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
      margin-left: {{ section.settings.margin_left_desktop }}px;
    }
    #shopify-section-{{ section.id }} .footer.footer--brand {
      padding-top: {{ section.settings.padding_top }}px;
      padding-right: {{ section.settings.padding_right }}px;
      padding-bottom: {{ section.settings.padding_bottom | plus: 13 }}px;
      padding-left: {{ section.settings.padding_left }}px;
    }
  }
  #shopify-section-{{ section.id }} .footer.footer--brand {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
    {%- if section.settings.background_image != blank -%}
      background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    {%- endif -%}
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .footer.footer--brand {
      {%- if section.settings.background_image_mobile != blank -%}
        background-image: url('{{ section.settings.background_image_mobile | image_url: width: 1400 }}');
      {%- elsif section.settings.background_image != blank -%}
        background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
      {%- endif -%}
    }
  }
  #shopify-section-{{ section.id }} .footer-ruler {
    width: calc(100% + {{ section.settings.padding_left_mobile }}px + {{ section.settings.padding_right_mobile }}px);
    height: 13px;
    margin: {{ section.settings.padding_bottom_mobile }}px calc({{ section.settings.padding_right_mobile }}px * -1) calc({{ section.settings.padding_bottom_mobile | plus: 13 }}px * -1) calc({{ section.settings.padding_left_mobile }}px * -1);
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .footer-ruler__image {
    display: block;
    width: 100%;
    height: 13px;
    object-fit: fill;
    object-position: center;
  }
  #shopify-section-{{ section.id }} .footer-ruler--split .footer-ruler__image--mobile {
    display: none;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .footer-ruler--split .footer-ruler__image--desktop {
      display: none;
    }
    #shopify-section-{{ section.id }} .footer-ruler--split .footer-ruler__image--mobile {
      display: block;
    }
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .footer-ruler {
      width: calc(100% + {{ section.settings.padding_left }}px + {{ section.settings.padding_right }}px);
      margin: {{ section.settings.padding_bottom }}px calc({{ section.settings.padding_right }}px * -1) calc({{ section.settings.padding_bottom | plus: 13 }}px * -1) calc({{ section.settings.padding_left }}px * -1);
    }
  }
  {% if section.settings.text_font != blank %}
    {{ section.settings.text_font | font_face: font_display: 'swap' }}
    .footer--brand {
      font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      font-weight: {{ section.settings.text_font.weight }};
      font-style: {{ section.settings.text_font.style }};
    }
  {% endif %}
  .footer-policies--compact {
    display: none;
  }
  @media screen and (max-width: 749px) {
    .footer.footer--brand .footer-top-container,
    .footer.footer--brand .footer-main-container {
      padding-top: 0;
      padding-bottom: 0;
      border: 0;
    }
    .footer.footer--brand .footer-subscribe-form {
      align-items: stretch;
    }
    .footer.footer--brand .footer-subscribe-form__heading {
      margin: 0 0 12px;
      font-family: var(--font-heading-family);
      font-size: 26px;
      font-weight: 700;
      line-height: 1.15;
      text-align: center;
    }
    .footer.footer--brand .footer-subscribe-form__text {
      max-width: none;
      margin: 0 0 18px;
      font-size: 14px;
      line-height: 1.45;
      text-align: center;
    }
    .footer.footer--brand .footer-subscribe-form__main,
    .footer.footer--brand .footer-subscribe-form__inner,
    .footer.footer--brand .footer-subscribe-form__input-wrapper,
    .footer.footer--brand .footer-subscribe-form-checkbox {
      width: 100%;
      max-width: none;
    }
    .footer.footer--brand .footer-subscribe-form__inner {
      display: block;
      position: relative;
    }
    .footer.footer--brand .footer-subscribe-form__input {
      min-height: 48px;
      height: 48px;
      padding: 0 44px 0 16px;
      border: 0;
      border-radius: 8px;
      background: #f4f1ff;
      font-size: 15px;
      font-weight: 500;
    }
    .footer.footer--brand .footer-subscribe-form__input::placeholder {
      color: #9b97ad;
    }
    .footer.footer--brand .footer-subscribe-form__arrow {
      top: 0;
      right: 4px;
      width: 40px;
      height: 48px;
    }
    .footer.footer--brand .footer-subscribe-form__arrow .icon {
      width: 18px;
      height: 18px;
    }
    .footer.footer--brand .footer-subscribe-form-checkbox {
      align-items: flex-start;
      margin-top: 12px;
      padding-left: 0 !important;
    }
    .footer.footer--brand .footer-subscribe-form-checkbox__label {
      align-items: flex-start;
    }
    .footer.footer--brand .footer-subscribe-form-checkbox__label-icon {
      width: 16px;
      min-width: 16px;
      height: 16px;
      min-height: 16px;
      margin-top: 1px;
      margin-right: 8px;
      border-width: 1.5px;
      border-radius: 3px;
    }
    .footer.footer--brand .footer-subscribe-form-checkbox__label-text,
    .footer.footer--brand .footer-subscribe-form-checkbox__label-text a {
      font-size: 12px;
      line-height: 1.4;
      text-align: left;
    }
    .footer.footer--brand .footer-subscribe-form-checkbox__label-text a {
      background-image: none;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .footer.footer--brand .footer-subscribe-form-checkbox__label-text a {
      background-image: none;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .footer.footer--brand .footer-main {
      gap: 0;
      margin-top: 26px;
    }
    .footer.footer--brand .footer-blocks {
      gap: 0;
    }
    .footer.footer--brand .footer-contact {
      max-width: none;
      gap: 6px;
      margin: 0 0 18px;
      font-size: 12px;
      line-height: 1.35;
    }
    .footer.footer--brand .footer-contact__line {
      margin: 0;
      white-space: nowrap;
    }
    .footer.footer--brand .footer-contact__label {
      display: inline;
      margin-right: 0.35em;
    }
    .footer.footer--brand .footer-contact a {
      color: inherit;
      text-decoration: none;
    }
    .footer.footer--brand .footer-contact__socials {
      margin-top: 12px;
      gap: 16px;
    }
    .footer.footer--brand .footer-contact__social svg {
      width: 20px;
      height: 20px;
    }
    .footer.footer--brand .footer-blocks > .accordion {
      margin: 0 !important;
      border: 0 !important;
      border-top: 1px solid rgba(255, 255, 255, 0.35) !important;
    }
    .footer.footer--brand .footer-blocks > .accordion:last-of-type {
      border-bottom: 0 !important;
    }
    .footer.footer--brand .accordion summary {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding: 0 28px 0 0;
    }
    .footer.footer--brand .accordion__heading {
      margin: 0;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.06em;
      line-height: 1;
      text-transform: uppercase;
    }
    .footer.footer--brand .accordion summary .icon-caret {
      width: 18px;
      height: 18px;
      top: calc(50% - 9px);
      transform: rotate(-90deg);
    }
    .footer.footer--brand .accordion details[open] > summary .icon-caret {
      transform: rotate(0deg);
    }
    .footer.footer--brand .footer-block__details-content {
      margin: 0 0 12px;
    }
    .footer.footer--brand .footer-block__details-content li:first-child .list-menu__item--link {
      padding-top: 0;
    }
    .footer.footer--brand .footer-block__details-content .list-menu__item--link {
      padding: 5px 0;
      color: #fff;
      font-size: 14px;
      line-height: 1.3;
      text-decoration: none;
    }
    .footer.footer--brand .footer-block__details-content .list-menu__item--link span {
      background-image: none;
      color: #fff;
      font-size: 14px;
    }
    .footer.footer--brand .footer-bottom {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.45);
    }
    .footer.footer--brand .footer-bottom > .footer-policies.footer-policies,
    .footer.footer--brand .footer-bottom > .footer-copyright.footer-copyright {
      flex: 0 1 auto;
      width: auto;
      max-width: none;
      margin: 0;
    }
    .footer.footer--brand .footer-policies:not(.footer-policies--compact) {
      display: none;
    }
    .footer.footer--brand .footer-policies--compact {
      display: flex;
      flex: 1 1 auto;
      flex-wrap: nowrap;
      align-items: center;
      min-width: 0;
      gap: 0 22px;
    }
    .footer.footer--brand .footer-policies__link span,
    .footer.footer--brand .footer-copyright__content {
      font-size: 13px;
      line-height: 1.2;
    }
    .footer.footer--brand .footer-policies--compact .footer-policies__link span {
      background-image: none;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .footer.footer--brand .footer-copyright {
      margin-left: auto;
      text-align: right;
      white-space: nowrap;
    }
  }
{% endstyle %}

<footer
  class="footer footer--brand{% if section.settings.enable_border_top %} footer--border-top{% endif %} color-{{ section.settings.color_scheme }} background"
  style="
    --footer-size: {{ section.settings.font_size }}px;
    {% if section.settings.background_color != blank %}
      --footer-bg: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.text_color != blank %}
      --footer-fg: {{ section.settings.text_color }};
      --color-foreground: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
      color: {{ section.settings.text_color }};
    {% endif %}
  "
>
  {%- if section.settings.show_subscribe -%}
    <div class="footer-top-container">
      <div class="container">
        <div class="footer-top">
          {% comment %} ----- FOOTER SUBSCRIBE FORM ----- {% endcomment %}
          {%- if section.settings.show_subscribe -%}
            <div
              class="footer-subscribe-form-container"
              data-footer-subscribe
              data-klaviyo-company="{{ section.settings.klaviyo_company_id | escape }}"
              data-klaviyo-list="{{ section.settings.klaviyo_list_id | escape }}"
            >
              {% form 'customer', class: 'footer-subscribe-form' %}
                {%- if section.settings.subscribe_heading != blank -%}
                  <div class="footer-subscribe-form__heading {{ section.settings.subscribe_heading_size }}">
                    {{- section.settings.subscribe_heading -}}
                  </div>
                {%- endif -%}

                {%- if section.settings.subscribe_text != blank -%}
                  <div class="footer-subscribe-form__text body-normal">
                    {{ section.settings.subscribe_text }}
                  </div>
                {%- endif -%}

                <div class="footer-subscribe-form__main">
                  <div class="footer-subscribe-form__inner">
                    <input
                      type="hidden"
                      name="contact[tags]"
                      value="newsletter"
                    >
                      <div class="footer-subscribe-form__input-wrapper">
                      <input
                        id="NewsletterForm--{{ section.id }}"
                        type="email"
                        dir="ltr"
                        name="contact[email]"
                        class="footer-subscribe-form__input"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                        {% if form.errors %}
                          autofocus
                          aria-invalid="true"
                          aria-describedby="Newsletter-error--{{ section.id }}"
                        {% elsif form.posted_successfully? %}
                          aria-describedby="Newsletter-success--{{ section.id }}"
                        {% endif %}
                        placeholder="{{ 'newsletter.label' | t }}"
                        required
                      >
                      <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                        {{- 'newsletter.label' | t -}}
                      </label>
                    </div>
                    <button
                      type="submit"
                      class="footer-subscribe-form__arrow"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      {% render 'icon-arrow' %}
                    </button>
                  </div>

                  {%- if form.errors -%}
                    <small
                      class="footer-subscribe-form__message footer-subscribe-form__message--error body-normal"
                      id="Newsletter-error--{{ section.id }}"
                    >
                      {%- render 'icon-error' -%}
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                  {%- if form.posted_successfully? -%}
                    <small
                      class="footer-subscribe-form__message footer-subscribe-form__message--success h4"
                      id="Newsletter-success--{{ section.id }}"
                      tabindex="-1"
                      autofocus
                    >
                      {% render 'icon-success' -%}
                      {{- 'newsletter.success' | t }}
                    </small>
                  {%- endif -%}

                  {%- if section.settings.newsletter_require_consent and section.settings.newsletter_consent_text -%}
                    <div class="footer-subscribe-form-checkbox">
                      <input
                        type="checkbox"
                        name="footer_newsletter_checkbox"
                        id="footer_newsletter_checkbox"
                        required
                        oninvalid="this.classList.add('is-invalid')"
                        onchange="this.classList.remove('is-invalid')"
                        {% if section.settings.newsletter_consent_default %}
                          checked
                        {% endif %}
                      >
                      <label
                        class="footer-subscribe-form-checkbox__label"
                        for="footer_newsletter_checkbox"
                      >
                        <div class="footer-subscribe-form-checkbox__label-icon">
                          {% render 'icon-checkmark' %}
                        </div>
                        <p class="footer-subscribe-form-checkbox__label-text body-xs">
                          {%- liquid
                            assign consent_text = section.settings.newsletter_consent_text
                            if shop.privacy_policy != blank
                              assign policy_link = '<a href="' | append: shop.privacy_policy.url | append: '">' | append: shop.privacy_policy.title | append: '</a>'
                              assign consent_text = consent_text | replace: 'Privacy Policy', policy_link | replace: 'Privacy policy', policy_link
                            endif
                          -%}
                          {{ consent_text }}
                        </p>
                      </label>
                      <p class="footer-subscribe-form-checkbox__error body-xs">
                        {{ 'sections.footer.checkbox_error' | t }}
                      </p>
                    </div>
                  {%- endif -%}
                </div>
              {% endform %}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="footer-main-container">
    <div class="container">
      <div class="footer-main">
        {% comment %} ----- FOOTER BLOCKS ----- {% endcomment %}
        {%- liquid
          assign show_contact = false
          if section.settings.address != blank or section.settings.phone != blank or section.settings.email != blank or section.settings.social_1_url != blank or section.settings.social_2_url != blank or section.settings.social_3_url != blank or section.settings.social_4_url != blank
            assign show_contact = true
          endif
        -%}
        {%- if section.blocks.size > 0 or show_contact -%}
          <div class="footer-blocks footer-blocks--{{ section.blocks.size }}">
            {%- if show_contact -%}
              <div class="footer-block footer-contact">
                {%- if section.settings.address != blank -%}
                  <p class="footer-contact__line">
                    <span class="footer-contact__label">{{ 'sections.footer.address' | t }}</span>
                    {{ section.settings.address | newline_to_br }}
                  </p>
                {%- endif -%}
                {%- if section.settings.phone != blank -%}
                  {%- assign phone_href = section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: '.', '' -%}
                  <p class="footer-contact__line">
                    <a href="tel:{{ phone_href }}">{{ 'sections.footer.call_us' | t }} {{ section.settings.phone }}</a>
                  </p>
                {%- endif -%}
                {%- if section.settings.email != blank -%}
                  <p class="footer-contact__line">
                    <a href="mailto:{{ section.settings.email }}">{{ 'sections.footer.email' | t }} {{ section.settings.email }}</a>
                  </p>
                {%- endif -%}
                <ul class="footer-contact__socials list-unstyled" role="list">
                  {%- for index in (1..4) -%}
                    {%- liquid
                      assign icon_key = 'social_' | append: index | append: '_icon'
                      assign url_key = 'social_' | append: index | append: '_url'
                      assign social_icon = section.settings[icon_key]
                      assign social_url = section.settings[url_key]
                    -%}
                    {%- if social_url != blank -%}
                      <li>
                        <a href="{{ social_url }}" class="footer-contact__social" target="_blank" rel="noopener" aria-label="{{ social_icon | escape }}">
                          {%- case social_icon -%}
                            {%- when 'instagram' -%}{% render 'icon-instagram' %}
                            {%- when 'facebook' -%}{% render 'icon-facebook' %}
                            {%- when 'tiktok' -%}{% render 'icon-tiktok' %}
                            {%- when 'youtube' -%}{% render 'icon-youtube' %}
                            {%- when 'pinterest' -%}{% render 'icon-pinterest' %}
                            {%- when 'twitter' -%}{% render 'icon-twitter' %}
                            {%- else -%}{% render 'icon-instagram' %}
                          {%- endcase -%}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {% liquid
                assign block_class = 'first'

                assign forloop_modulo = forloop.index0 | modulo: 4

                if forloop_modulo == 0
                  assign block_class = 'first'
                endif

                if forloop_modulo == 1
                  assign block_class = 'second'
                endif

                if forloop_modulo == 2
                  assign block_class = 'third'
                endif

                if forloop_modulo == 3
                  assign block_class = 'fourth'
                endif
              %}
              {%- case block.type -%}
                  {% comment %} ----- FOOTER MENU BLOCK link_list ----- {% endcomment %}
                {%- when 'link_list' -%}
                  {%- if block.type == 'link_list'
                    and block.settings.heading != blank
                    and block.settings.menu != blank
                  -%}
                    <div class="accordion" {{ block.shopify_attributes }}>
                      <details
                        {% if block.settings.default_open %}
                          open
                        {% endif %}
                      >
                        <summary>
                          <{{ block.settings.heading_tag }} class="accordion__heading body-large">
                            {{ block.settings.heading | escape }}
                          </{{ block.settings.heading_tag }}>
                          {% render 'icon-caret' %}
                        </summary>
                        {%- if block.settings.menu != blank -%}
                          <ul class="footer-block__details-content list-unstyled">
                            {%- for link in block.settings.menu.links -%}
                              <li>
                                <a
                                  href="{{ link.url }}"
                                  {% if settings.links_blank and link.type == 'http_link' %}
                                    target="_blank"
                                  {% endif %}
                                  class="list-menu__item body-normal focus-inset list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                                >
                                  <span>{{ link.title }}</span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </details>
                    </div>

                    <div
                      class="footer-block footer-menu-block {{ block_class }}"
                      {{ block.shopify_attributes }}
                    >
                      <{{ block.settings.heading_tag }} class="footer-menu-block__heading h6">
                        {{- block.settings.heading | escape -}}
                      </{{ block.settings.heading_tag }}>

                      <ul class="footer-menu-block-list list-unstyled">
                        {%- for link in block.settings.menu.links -%}
                          <li class="footer-menu-block-list__item">
                            <a
                              href="{{ link.url }}"
                              {% if settings.links_blank and link.type == 'http_link' %}
                                target="_blank"
                              {% endif %}
                              class="footer-menu-block-list__link focus-inset{% if link.active %} footer-menu-block-list__link--active{% endif %}"
                            >
                              <span class="body-small">{{- link.title }}</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                {%- when 'nav_group' -%}
                  <div class="accordion" {{ block.shopify_attributes }}>
                    <details {% if block.settings.default_open %}open{% endif %}>
                      <summary>
                        <h2 class="accordion__heading body-large">{{ block.settings.heading | escape }}</h2>
                        {% render 'icon-caret' %}
                      </summary>
                      <ul class="footer-block__details-content list-unstyled">
                        {%- for index in (1..6) -%}
                          {%- liquid
                            assign label_key = 'link_' | append: index | append: '_label'
                            assign url_key = 'link_' | append: index | append: '_url'
                            assign link_label = block.settings[label_key]
                            assign link_url = block.settings[url_key]
                          -%}
                          {%- if link_label != blank -%}
                            <li>
                              <a href="{{ link_url | default: '#' }}" class="list-menu__item body-normal focus-inset list-menu__item--link">
                                <span>{{ link_label | escape }}</span>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </details>
                  </div>
                  <div class="footer-block footer-menu-block {{ block_class }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h2 class="footer-menu-block__heading h6">{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
