                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {% comment %} ----- FOLLOW ON SHOP ----- {% endcomment %}
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer-follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  <div class="footer-ruler{% if section.settings.bottom_image != blank and section.settings.bottom_image_mobile != blank %} footer-ruler--split{% endif %}">
      {%- if section.settings.bottom_image != blank -%}
        {{
          section.settings.bottom_image
          | image_url: width: 2400
          | image_tag:
            class: 'footer-ruler__image footer-ruler__image--desktop',
            widths: '375, 750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            alt: section.settings.bottom_image.alt | default: shop.name
        }}
      {%- endif -%}
      {%- if section.settings.bottom_image_mobile != blank -%}
        {{
          section.settings.bottom_image_mobile
          | image_url: width: 1400
          | image_tag:
            class: 'footer-ruler__image footer-ruler__image--mobile',
            widths: '375, 750, 1100, 1400',
            sizes: '100vw',
            alt: section.settings.bottom_image_mobile.alt | default: shop.name
        }}
      {%- endif -%}
    </div>
</footer>

<script>
  (function () {
    const roots = document.querySelectorAll('[data-footer-subscribe]');
    roots.forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const form = root.querySelector('form');
      if (!form) return;
      form.addEventListener('submit', (event) => {
        const company = root.dataset.klaviyoCompany;
        if (!company) return;
        const emailInput = form.querySelector('input[type="email"]');
        const email = emailInput ? emailInput.value : '';
        if (!email) return;
        const listId = root.dataset.klaviyoList;
        const attributes = {
          custom_source: 'Footer',
          profile: {
            data: {
              type: 'profile',
              attributes: {
                email: email,
                subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } }
              }
            }
          }
        };
        const payload = { data: { type: 'subscription', attributes: attributes } };
        if (listId) {
          payload.data.relationships = { list: { data: { type: 'list', id: listId } } };
        }
        event.preventDefault();
        fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(company), {
          method: 'POST',
          headers: { 'content-type': 'application/json', revision: '2024-10-15' },
          body: JSON.stringify(payload)
        }).finally(() => form.submit());
      });
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 9,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "default": false,
      "label": "t:sections.footer.settings.enable_border_top.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__subscribe.content"
    },
    {
      "type": "checkbox",
      "id": "show_subscribe",
      "default": true,
      "label": "t:sections.footer.settings.show_subscribe.label"
    },
    {
      "type": "text",
      "id": "subscribe_heading",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "subscribe_heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        }
      ],
      "default": "h3"
    },
    {
      "type": "inline_richtext",
      "id": "subscribe_text",
      "label": "t:sections.footer.settings.subscribe_text.label",
      "default": "t:sections.footer.settings.subscribe_text.default"
    },
    {
      "type": "text",
      "id": "subscribe_button_text",
      "label": "t:sections.footer.settings.subscribe_button_text.label",
      "default": "t:sections.footer.settings.subscribe_button_text.default"
    },
    {
      "type": "checkbox",
      "id": "newsletter_require_consent",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_require_consent.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_consent_text",
      "label": "t:sections.footer.settings.newsletter_consent_text.label",
      "default": "t:sections.footer.settings.newsletter_consent_text.default",
      "visible_if": "{{ section.settings.newsletter_require_consent == true }}"
    },
    {
      "type": "checkbox",
