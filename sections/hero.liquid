{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_logo == false -%}
  <script src="{{ 'hero.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.enable_content_animation %}
  <script src="{{ 'hero-text-animation.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% liquid
  assign images_fetch_priority = 'auto'
  assign images_loading = 'lazy'

  if section.index == 1
    assign images_fetch_priority = 'high'
    assign images_loading = 'eager'
  endif

  assign has_background_image = false
  if section.settings.background_image != blank or section.settings.mobile_background_image != blank
    assign has_background_image = true
  endif
%}

{% liquid
  if section.settings.mobile_background_image != blank
    assign mobile_image = section.settings.mobile_background_image
  elsif section.settings.background_image != blank
    assign mobile_image = section.settings.background_image
  else
    assign mobile_image = blank
  endif

  if section.settings.background_image != blank
    assign desktop_image = section.settings.background_image
  elsif section.settings.mobile_background_image != blank
    assign desktop_image = section.settings.mobile_background_image
  else
    assign desktop_image = blank
  endif

  if section.settings.image_ratio_mobile != 'adapt' and section.settings.image_ratio_mobile != 'full_height'
    assign aspect_ratio_mobile = section.settings.image_ratio_mobile | split: '/'
    assign temp = aspect_ratio_mobile[0] | append: '.0'
    assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp | times: 100 | round: 2 | append: '%'
  elsif section.settings.image_ratio_mobile == 'adapt'
    if section.settings.video != blank and section.settings.show_video
      assign padding_bottom_mobile = 1 | divided_by: section.settings.video.aspect_ratio | times: 100 | round: 2 | append: '%'
    elsif mobile_image != blank
      assign padding_bottom_mobile = 1 | divided_by: mobile_image.aspect_ratio | times: 100 | round: 2 | append: '%'
    else
      assign padding_bottom_mobile = 0
    endif
  elsif section.settings.image_ratio_mobile == 'full_height'
    assign padding_bottom_mobile = '100vh'
  else
    assign padding_bottom_mobile = 0
  endif

  if section.settings.image_ratio_desktop != 'adapt' and section.settings.image_ratio_desktop != 'full_height'
    assign aspect_ratio_desktop = section.settings.image_ratio_desktop | split: '/'
    assign temp = aspect_ratio_desktop[0] | append: '.0'
    assign padding_bottom_desktop = aspect_ratio_desktop[1] | divided_by: temp | times: 100 | round: 2 | append: '%'
  elsif section.settings.image_ratio_desktop == 'adapt'
    if section.settings.video != blank and section.settings.show_video
      assign padding_bottom_desktop = 1 | divided_by: section.settings.video.aspect_ratio | times: 100 | round: 2 | append: '%'
    elsif desktop_image != blank
      assign padding_bottom_desktop = 1 | divided_by: desktop_image.aspect_ratio | times: 100 | round: 2 | append: '%'
    else
      assign padding_bottom_desktop = 0
    endif
  elsif section.settings.image_ratio_desktop == 'full_height'
    assign padding_bottom_desktop = '100vh'
  else
    assign padding_bottom_desktop = 0
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} .hero::before {
  content: "";
  display: block;
  width: 0;
  padding-bottom: {{ padding_bottom_mobile }};
  }

  @media screen and (min-width: 576px) {
  #shopify-section-{{ section.id }} .hero::before {
    content: "";
    display: block;
    width: 0;
    padding-bottom: {{ padding_bottom_desktop }};
  }
  }
{% endstyle %}

{% style %}
  {% render 'section-margin' %}
{% endstyle %}

<div
  class="hero hero-{{ section.id }} color-{{ section.settings.color_scheme }} background{% if section.settings.show_secondary_media %} hero-has-secondary-image{% endif %}{% if section.index == 1 or section.index == null %} hero--first-section{% endif %}{% if section.settings.image_ratio_mobile == 'full_height' %} hero--mobile-full-height{% endif %}{% if section.settings.image_ratio_desktop == 'full_height' %} hero--desktop-full-height{% endif %}"
  id="hero-{{ section.id }}"
>
  {%- if section.settings.show_background_media -%}
    {%- if has_background_image and section.settings.background_video == blank -%}
      <div class="hero-bg-image-wrapper">
        {% liquid
          assign widths = '360, 535, 600, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800'
          assign widths_arr = widths | split: ', '

          assign one_bg_image = false
          if section.settings.background_image != blank and section.settings.mobile_background_image == blank
            assign one_bg_image = true
            assign section_bg_image = section.settings.background_image
          elsif section.settings.background_image == blank and section.settings.mobile_background_image != blank
            assign one_bg_image = true
            assign section_bg_image = section.settings.mobile_background_image
          endif

          assign calc_ratio = 1.2
        %}
        {%- capture sizes -%}
        calc({{ calc_ratio }} * 100vw)
      {%- endcapture -%}

        {%- if one_bg_image -%}
          {{
            section_bg_image
            | image_url: width: section_bg_image.width
            | image_tag:
              widths: widths,
              sizes: sizes,
              class: 'hero-bg-image',
              fetchpriority: images_fetch_priority,
              loading: images_loading
          }}
        {%- else -%}
          <picture style="display: block; width: 100%; height: 100%;">
            <source
              srcset="{% for width in widths_arr %}{{ section.settings.mobile_background_image | image_url: width: width }} {{ width }}w{% if forloop.last == false %}, {% endif %}{% endfor %}"
              media="(max-width: 575px)"
              sizes="{{ sizes }}"
            >
            <source
              srcset="{% for width in widths_arr %}{{ section.settings.background_image | image_url: width: width }} {{ width }}w{% if forloop.last == false %}, {% endif %}{% endfor %}"
              media="(min-width: 576px)"
              sizes="{{ sizes }}"
            >
            <img
              src="{{ section.settings.background_image | image_url: width: section.settings.background_image.width }}"
              alt="{{ section.settings.background_image.alt }}"
              width="{{ section.settings.background_image.width }}"
              height="{{ section.settings.background_image.height }}"
              sizes="{{ sizes }}"
              class="hero-bg-image"
              loading="{{ images_loading }}"
              fetchpriority="{{ images_fetch_priority }}"
              style="--focal_point_desktop: {{ section.settings.background_image.presentation.focal_point }}; --focal_point_mobile: {{ section.settings.mobile_background_image.presentation.focal_point }};"
            >
          </picture>
        {%- endif -%}
        {%- if section.settings.overlay_opacity > 0 -%}
          {%- if section.settings.overlay_as_gradient -%}
            {%- capture overlay_styles -%}
              background: linear-gradient(
                to bottom,
                rgba(var(--color-overlay), {{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.3 }}),
                rgba(var(--color-overlay), {{ section.settings.overlay_opacity | divided_by: 100.0 }})
              );
            {%- endcapture -%}
          {%- else -%}
            {%- capture overlay_styles -%}background: rgb(var(--color-overlay)); opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};{%- endcapture -%}
          {%- endif -%}
          <div
            class="hero-bg-image-overlay"
            style="{{ overlay_styles }}"
          ></div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="hero-bg-image-wrapper">
        {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--filled hero-bg-image' }}
        {%- if section.settings.overlay_opacity > 0 -%}
          {%- if section.settings.overlay_as_gradient -%}
            {%- capture overlay_styles -%}
              background: linear-gradient(
                to bottom,
                rgba(var(--color-overlay), {{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.3 }}),
                rgba(var(--color-overlay), {{ section.settings.overlay_opacity | divided_by: 100.0 }})
              );
            {%- endcapture -%}
          {%- else -%}
            {%- capture overlay_styles -%}background: rgb(var(--color-overlay)); opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};{%- endcapture -%}
          {%- endif -%}
          <div
            class="hero-bg-image-overlay"
            style="{{ overlay_styles }}"
          ></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.background_video != blank -%}
      <div class="hero-bg-image-wrapper">
        {{
          section.settings.background_video
          | video_tag:
            image_size: '2160x',
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            class: 'hero-bg-image hero-bg-image--video'
        }}
        {%- if section.settings.overlay_opacity > 0 -%}
          {%- if section.settings.overlay_as_gradient -%}
            {%- capture overlay_styles -%}
              background: linear-gradient(
                to bottom,
                rgba(var(--color-overlay), {{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.3 }}),
                rgba(var(--color-overlay), {{ section.settings.overlay_opacity | divided_by: 100.0 }})
              );
            {%- endcapture -%}
          {%- else -%}
            {%- capture overlay_styles -%}
              background: rgba(var(--color-overlay));
              opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
            {%- endcapture -%}
          {%- endif -%}
          <div
            class="hero-bg-image-overlay"
            style="{{ overlay_styles }}"
          ></div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="hero-main">
    {% if section.settings.section_heading != blank
      or section.settings.description != blank
      or section.settings.show_button
      or section.settings.hero_text != blank
    %}
      <div class="hero-content-wrapper">
        <div class="container">
          <div
            class="hero-content hero-content--{{ section.settings.content_order }}"
            {% if section.settings.enable_content_animation %}
              data-animation-ready="false"
            {%- endif -%}
          >
            <div
              class="hero-content-block hero-content-block--{{ section.settings.content_align }}"
            >
              {% if section.settings.enable_content_animation %}
                {%- if section.settings.section_heading != blank -%}
                  {%- assign words = section.settings.section_heading | split: ' ' -%}

                  <{{ section.settings.heading_tag }}
                    class="hero-heading {{ section.settings.section_heading_size }} animated-text"
                    id="hero-heading-text-{{ section.id }}"
                    data-section-id="{{ section.id }}"
                  >
                    {%- for word in words -%}
                      {%- if word != '' -%}
                        <span class="word" style="--word-index: {{ forloop.index0 }}">{{ word }}</span>
                        {%- unless forloop.last %}&nbsp;{% endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </{{ section.settings.heading_tag }}>
                {%- endif -%}

                {%- if section.settings.hero_description != blank -%}
                  <p class="hero-description body-normal animated-item">
                    {{- section.settings.hero_description | strip_html | truncate: 153 -}}
                  </p>
                {%- endif -%}

                {%- if section.settings.show_button -%}
                  <div class="hero-buttons animated-item">
                    {% render 'button',
                      btn_label: section.settings.button_label,
                      btn_style: section.settings.button_style,
                      btn_link: section.settings.button_link,
                      class: 'hero__button'
                    %}
                  </div>
                {%- endif -%}
              {% else %}
                {%- if section.settings.section_heading != blank -%}
                  <{{ section.settings.heading_tag }} class="hero-heading {{ section.settings.section_heading_size }}">
                    {{- section.settings.section_heading -}}
                  </{{ section.settings.heading_tag }}>
                {%- endif -%}

                {%- if section.settings.hero_description != blank -%}
                  <p class="hero-description body-normal">
                    {{- section.settings.hero_description | strip_html | truncate: 153 -}}
                  </p>
                {%- endif -%}

                {%- if section.settings.show_button -%}
                  <div class="hero-buttons">
                    {% render 'button',
                      btn_label: section.settings.button_label,
                      btn_style: section.settings.button_style,
                      btn_link: section.settings.button_link,
                      class: 'hero__button'
                    %}
                  </div>
                {%- endif -%}
              {% endif %}
            </div>

            {%- if section.settings.show_logo -%}
              {%- if section.settings.logo != blank -%}
                <div
                  class="hero-logo{% if section.settings.enable_content_animation %} animated-item{% endif %}"
                  style="--hero-logo-width: {{ section.settings.logo_width }}px;"
                >
                  {%- liquid
                    assign logo_img_loading = 'lazy'

                    if section.index == 1
                      assign logo_img_loading = 'eager'
                    endif

                    assign logo_alt = section.settings.logo.alt | default: shop.name | escape
                  -%}
                  {%- capture logo_sizes -%}
                    (min-width: {{ section.settings.logo_width }}px) {{ section.settings.logo_width }}px, 100vw
                  {%- endcapture -%}
                  {{
                    section.settings.logo
                    | image_url: width: section.settings.logo.width
                    | image_tag:
                      class: 'hero-logo__image',
                      widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
                      sizes: logo_sizes,
                      alt: logo_alt,
                      loading: logo_img_loading
                  }}
                </div>
              {%- else -%}
                <span
                  class="hero-logo__text{% if section.settings.enable_content_animation %} animated-item{% endif %} h3"
                >
                  {{- shop.name -}}
                </span>
              {%- endif -%}
            {%- else -%}
              {%- if section.settings.hero_text != blank -%}
                <div
                  id="resizingContainer"
                  {% if section.settings.enable_content_animation %}
                    class="hero-text-wrapper animated-item"
                  {% endif %}
                >
                  <div
                    class="hero-text hero-text--{{ section.settings.hero_text_align }}"
                    style="font-weight: {{section.settings.hero_text_font_weight}}; line-height: {{section.settings.hero_text_line_height}};"
                  >
                    {{ section.settings.hero_text }}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "class": "hero-section spaced-section overlay-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__media.content"
    },
    {
      "type": "checkbox",
      "id": "show_background_media",
      "default": true,
      "label": "t:sections.hero.settings.show_background_media.label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.hero.settings.background_image.label"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.aspect_ratio.options__1.label"
        },
        {
          "value": "2/1",
          "label": "t:sections.all.aspect_ratio.options__10.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.aspect_ratio.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.aspect_ratio.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.aspect_ratio.options__4.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.all.aspect_ratio.options__5.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.aspect_ratio.options__7.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.aspect_ratio.options__8.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.hero-split.settings.aspect_ratio.options__6.label"
        },
        {
          "value": "full_height",
          "label": "t:sections.hero-split.settings.aspect_ratio.options__7.label"
        }
      ],
      "default": "full_height",
      "label": "t:sections.hero-split.settings.aspect_ratio.label_desktop",
      "info": "t:sections.hero-split.settings.aspect_ratio.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "t:sections.hero.settings.mobile_background_image.label"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.aspect_ratio.options__1.label"
        },
        {
          "value": "2/1",
          "label": "t:sections.all.aspect_ratio.options__10.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.aspect_ratio.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.aspect_ratio.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.aspect_ratio.options__4.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.all.aspect_ratio.options__5.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.aspect_ratio.options__7.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.aspect_ratio.options__8.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.hero-split.settings.aspect_ratio.options__6.label"
        },
        {
          "value": "full_height",
          "label": "t:sections.hero-split.settings.aspect_ratio.options__7.label"
        }
      ],
      "default": "full_height",
      "label": "t:sections.hero-split.settings.aspect_ratio.label_mobile",
      "info": "t:sections.hero-split.settings.aspect_ratio.info"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:sections.hero.settings.background_video.label",
      "info": "t:sections.hero.settings.background_video.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.all.overlay_opacity.label"
    },
    {
      "type": "checkbox",
      "id": "overlay_as_gradient",
      "label": "t:sections.all.overlay_as_gradient.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__content.content"
    },
    {
      "type": "textarea",
      "id": "section_heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.hero.settings.section_heading.default"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        },
        {
          "value": "p",
          "label": "t:sections.all.heading_tag.options__8.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "section_heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "hero_description",
      "info": "t:sections.hero.settings.hero_description.info",
      "label": "t:sections.hero.settings.hero_description.label",
      "default": "t:sections.hero.settings.hero_description.default"
    },
    {
      "type": "text_alignment",
      "id": "content_align",
      "label": "t:sections.hero.settings.content_align.label",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "enable_content_animation",
      "label": "t:sections.hero.settings.enable_content_animation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "default": false,
      "label": "t:sections.footer.settings.show_logo.label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.footer.settings.logo.label",
      "visible_if": "{{ section.settings.show_logo == true }}"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 20,
      "max": 1860,
      "step": 20,
      "default": 580,
      "unit": "px",
      "label": "t:sections.footer.settings.logo_width.label",
      "visible_if": "{{ section.settings.show_logo == true }}"
    },
    {
      "type": "text",
      "id": "hero_text",
      "label": "t:sections.hero.settings.hero_text.label",
      "default": "t:sections.hero.settings.hero_text.default",
      "visible_if": "{{ section.settings.show_logo == false }}"
    },
    {
      "type": "select",
      "id": "hero_text_font_weight",
      "options": [
        {
          "value": "300",
          "label": "t:sections.hero.settings.hero_text_font_weight.options_1.label"
        },
        {
          "value": "400",
          "label": "t:sections.hero.settings.hero_text_font_weight.options_2.label"
        },
        {
          "value": "500",
          "label": "t:sections.hero.settings.hero_text_font_weight.options_3.label"
        },
        {
          "value": "600",
          "label": "t:sections.hero.settings.hero_text_font_weight.options_4.label"
        }
      ],
      "default": "600",
      "label": "t:sections.hero.settings.hero_text_font_weight.label",
      "visible_if": "{{ section.settings.show_logo == false }}"
    },
    {
      "type": "range",
      "id": "hero_text_line_height",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "label": "t:sections.hero.settings.hero_text_line_height.label",
      "default": 0.7,
      "visible_if": "{{ section.settings.show_logo == false }}"
    },
    {
      "type": "text_alignment",
      "id": "hero_text_align",
      "label": "t:sections.hero.settings.hero_text_align.label",
      "info": "t:sections.hero.settings.hero_text_align.info",
      "default": "center",
      "visible_if": "{{ section.settings.show_logo == false }}"
    },
    {
      "type": "select",
      "id": "content_order",
      "options": [
