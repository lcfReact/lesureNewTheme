{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  .recently-viewed__empty {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: center;
  }
  .recently-viewed__empty span {
    max-width: 550px;
    text-align: center;
  }
  .recently-viewed--empty .recently-viewed__empty {
    display: flex;
  }
  .recently-viewed .loading-overlay {
    position: relative;
    z-index: 6;
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 2rem 5rem;
  }
  .recently-viewed.recently-viewed--loading .loading-overlay {
    display: flex;
  }
  .recently-viewed.recently-viewed--loading .loading-overlay .loading-overlay__spinner {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
  }
  .recently-viewed.recently-viewed--loading .popular-products-nav,
  .recently-viewed.recently-viewed--empty .popular-products-nav {
    display: none;
  }
{%- endstyle -%}

{% liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank or section.settings.subheading != blank or section.settings.button_show and section.settings.button_label != blank
      assign enable_animation = true
    endif
  endif

  assign heading_delay = 0

  if section.settings.subheading != blank
    assign heading_delay = 0.1
  endif

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay

  assign button_delay = description_delay | plus: 0.1
%}

<div
  class="recently-viewed recently-viewed--loading{% if search.performed %} recently-viewed--search-perfomed{% endif %} popular-products popular-products--desktop-layout-{{ section.settings.desktop_layout }} popular-products--mobile-layout-{{ section.settings.mobile_layout }} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding{% if section.settings.enable_border_top %} popular-products--border-top{% endif %}{% if section.settings.enable_border_bottom %} popular-products--border-bottom{% endif %} no-js-hidden"
  data-layout="{{ section.settings.desktop_layout }}"
  data-layout-mobile="{{ section.settings.mobile_layout }}"
  data-base-url="{{ routes.search_url }}?section_id={{section.id}}&type=product"
  data-products-limit="{{ section.settings.products_limit }}"
  data-expiration-days="{{ settings.recently_product_record_lifetime }}"
  {% if request.page_type == 'product' and product != blank %}
    data-current-page-product-id="{{ product.id }}"
  {% endif %}
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s; --button-delay: {{ button_delay }}s;"
  {% endif %}
>
  {%- if section.settings.heading != blank
    or section.settings.description != blank
    or section.settings.subheading != blank
    or section.settings.button_show
    and section.settings.button_label != blank
  -%}
    <div class="popular-products-top popular-products-top--align-{{ section.settings.text_align }} container">
      <div class="popular-products-top__heading-group">
        {% render 'heading-group',
          section: section,
          class: 'popular-products',
          text_align: section.settings.text_align,
          enable_animation: section.settings.animate_section_header_on_scroll
        %}
      </div>

      {%- if section.settings.button_show and section.settings.button_label -%}
        {% render 'button',
          btn_label: section.settings.button_label,
          btn_style: section.settings.button_style,
          btn_link: section.settings.button_link,
          class: 'popular-products-button heading-group-button'
        %}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="popular-products-main container content">
    <div class="loading-overlay">
      <div class="loading-overlay__spinner">
        {% render 'icon-loading' %}
      </div>
    </div>

    <div class="recently-viewed__empty body-xl">
      <span class="body-xl">{{- 'sections.recently_viewed.empty_message' | t -}}</span>
    </div>

    <div
      class="popular-products-layout"
      data-columns="{{ section.settings.products_to_show }}"
      {% if section.settings.centered_slides %}
        data-centered-slides="true"
      {% endif %}
    >
      <div
        class="popular-products-list{% if section.settings.desktop_layout == 'grid' %} popular-products-desktop-grid popular-products-desktop-grid--{{ section.settings.products_to_show }}{% endif %}{% if section.settings.desktop_layout == 'slider' %} popular-products-desktop-slider{% endif %}{% if section.settings.mobile_layout == 'slider' %} popular-products-mobile-slider{% endif %}{% if section.settings.mobile_layout == 'column' %} popular-products-mobile-column{% endif %}"
      >
        {% liquid
          assign product_list = search.results | where: 'object_type', 'product'
          assign product_count = 0

          for product in product_list
            assign product_count = product_count | plus: 1
          endfor
        %}

        {%- for product in product_list -%}
          <div
            class="popular-products-item collection-product-card"
          >
            {% render 'product-card',
              product_card_product: product,
              media_ratio: section.settings.image_ratio,
              media_fit: section.settings.image_fit,
              show_vendor: section.settings.show_vendor,
              show_desc: section.settings.show_desc,
              section_id: section.id,
              add_id: forloop.index,
              columns: section.settings.products_to_show,
              color_scheme: section.settings.color_scheme
            %}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.desktop_layout == 'slider' or section.settings.mobile_layout == 'slider' -%}
        <div class="popular-products-nav{% if section.settings.show_nav_buttons_desktop %} popular-products-nav--show-desktop{% endif %}{% if section.settings.show_nav_buttons_mobile %} popular-products-nav--show-mobile{% endif %} no-js-hidden">
          {% render 'slider-button',
            direction: 'prev',
            classnames: 'popular-products-nav-button popular-products-nav-button--prev'
          %}
          {% render 'slider-button',
            direction: 'next',
            classnames: 'popular-products-nav-button popular-products-nav-button--next'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
