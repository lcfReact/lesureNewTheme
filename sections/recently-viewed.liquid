  "tag": "section",
  "class": "recently-viewed-section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "default": true,
      "label": "t:sections.all.enable_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_bottom",
      "default": false,
      "label": "t:sections.all.enable_border_bottom.label"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 6,
      "label": "t:sections.recently-viewed.settings.products_limit.label"
    },
    {
      "type": "checkbox",
      "id": "animate_section_header_on_scroll",
      "default": true,
      "label": "t:sections.all.animate_section_header_on_scroll.label",
      "info": "t:sections.all.animate_section_header_on_scroll.info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.recently-viewed.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_level",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_level.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_level.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_level.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_level.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_level.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_level.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_level.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_level.label"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.popular-products.settings.heading__2.content"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:sections.popular-products.settings.desktop_layout.label",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.popular-products.settings.desktop_layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.popular-products.settings.desktop_layout.options__2.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons_desktop",
      "label": "t:sections.popular-products.settings.show_nav_buttons.label",
      "visible_if": "{{ section.settings.desktop_layout == 'slider' }}",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.popular-products.settings.mobile_layout.label",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.popular-products.settings.mobile_layout.options__1.label"
        },
        {
          "value": "column",
          "label": "t:sections.popular-products.settings.mobile_layout.options__2.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons_mobile",
      "label": "t:sections.popular-products.settings.show_nav_buttons_mobile.label",
      "visible_if": "{{ section.settings.mobile_layout == 'slider' }}",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "centered_slides",
      "label": "t:sections.popular-products.settings.centered_slides.label",
      "info": "t:sections.popular-products.settings.centered_slides.info",
      "default": false,
      "visible_if": "{{ section.settings.desktop_layout == 'slider' or section.settings.mobile_layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.popular-products.settings.products_to_show.label",
      "visible_if": "{{ section.settings.desktop_layout != 'slider' or section.settings.centered_slides == false }}"
    },
    {
      "type": "header",
      "content": "t:sections.popular-products.settings.heading__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "portrait",
      "label": "t:sections.popular-products.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
