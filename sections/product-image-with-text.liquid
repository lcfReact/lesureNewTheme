    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:sections.product-image-with-text.settings.vertical_alignment.label",
      "options": [
        { "value": "top", "label": "t:sections.product-image-with-text.settings.vertical_alignment.options__1.label" },
        { "value": "middle", "label": "t:sections.product-image-with-text.settings.vertical_alignment.options__2.label" },
