      "label": "t:sections.product-image-with-text.settings.heading_gap.label",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.product-image-with-text.settings.heading_gap_mobile.label",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:sections.product-image-with-text.settings.header_style.content"
    },
    {
      "type": "color",
      "id": "text_background",
      "label": "t:sections.product-image-with-text.settings.text_background.label",
      "default": "#F6F3EE"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.product-image-with-text.settings.section_width.label",
      "options": [
        { "value": "page", "label": "t:sections.product-image-with-text.settings.section_width.options__1.label" },
        { "value": "full", "label": "t:sections.product-image-with-text.settings.section_width.options__2.label" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "module_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.product-image-with-text.settings.module_radius.label",
      "default": 4
