    },
    {
      "type": "range",
      "id": "text_size",
      "min": 1,
      "max": 2.4,
      "step": 0.1,
      "unit": "rem",
      "label": "t:sections.product-image-with-text.settings.text_size.label",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "label": "t:sections.product-image-with-text.settings.text_size_mobile.label",
      "default": 1.4
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "t:sections.product-image-with-text.settings.heading_line_height.label",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "text_line_height",
      "min": 1,
      "max": 2.2,
      "step": 0.1,
      "label": "t:sections.product-image-with-text.settings.text_line_height.label",
      "default": 1.6
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.product-image-with-text.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.product-image-with-text.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.product-image-with-text.settings.text_alignment.options__2.label" },
        { "value": "right", "label": "t:sections.product-image-with-text.settings.text_alignment.options__3.label" }
