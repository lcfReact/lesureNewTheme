{{ 'section-benefits.css' | asset_url | stylesheet_tag }}
{% if section.settings.animate_on_scroll %}
  <script src="{{ 'benefits.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  .section-{{ section.id }}-padding .benefits-grid {
    --column-gap: {{ section.settings.column_gap }}rem;
  }
{%- endstyle -%}

{% liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank 
      assign enable_animation = true
    endif
  endif

  assign heading_delay = 0

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay
%}

{% if enable_animation %}
  {% style %}
    #shopify-section-{{ section.id }} [data-enable-header-animation] .benefits__title .word {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} [data-enable-header-animation] .benefits__description {
      opacity: 0;
      transform: translateY(20px);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .benefits__title .word {
      animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: calc(var(--heading-delay) + (var(--word-index) * 0.1s));
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .benefits__description {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--description-delay);
    }
  {% endstyle %}
{% endif %}

<div class="benefits {% if section.settings.top_border %}benefits--border-top{% endif %} {% if section.settings.bottom_border %}benefits--border-bottom{% endif %} {% if section.settings.animate_on_scroll %}benefits--enable-animate{% endif %} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding" 
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s;"
  {% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="benefits-header benefits-header--alignment-{{ section.settings.text_align }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_level }} class="benefits__title {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="benefits__description body-normal">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% if section.blocks.size > 0 %}
      <div class="benefits-grid benefits-grid--{{ section.settings.benefit_per_row }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank or block.settings.text != blank -%}
              {% if block.settings.benefit_link != blank %}
                <a 
                  class="benefit__link" 
                  aria-describedby="a11y-external-message"
                  {%- if settings.links_blank -%}
                    target="_blank"
                  {%- endif -%}
                  href="{{ block.settings.benefit_link }}">
              {% endif %}

              <div class="benefit benefit--border-radius-{{ section.settings.benefit_border_radius }}" style="--benefit-delay: {{ forloop.index0 | times: 150 }}ms" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <span class="benefit__title h3">
                    {{ block.settings.title | truncate: 20 }}
                  </span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="benefit__text body-normal">
                    {{ block.settings.text | truncate: 30 }}
                  </span>
                {%- endif -%}
              </div>

              {% if block.settings.benefit_link != blank %}
                </a>
              {% endif %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</div>

