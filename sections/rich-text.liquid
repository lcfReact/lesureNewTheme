{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="rich-text rich-text--align-{{ section.settings.alignment }}{% if section.settings.full_width %}  rich-text--full-width color-{{ section.settings.color_scheme }} background{% else %} container{% endif %}">
  <div class="rich-text__blocks section-{{ section.id }}-padding{% if section.settings.full_width %} container{% else %} color-{{ section.settings.color_scheme }} background{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading body-xl"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <{{ block.settings.heading_tag }}
            class="rich-text__heading title--section {{ block.settings.heading_size }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </{{ block.settings.heading_tag }}>
        {%- when 'text' -%}
          <div class="rich-text__text body-normal rte" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          {%- if block.settings.button_label != blank -%}
            {% render 'button',
              btn_label: block.settings.button_label,
              btn_style: block.settings.button_style,
              btn_link: block.settings.button_link,
              class: 'rich-text__button',
              block_shopify_attributes: block.shopify_attributes
            %}
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

