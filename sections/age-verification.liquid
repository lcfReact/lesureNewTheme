<div
  class="age-verification popup"
  data-exit-animation="popupExitFade"
  data-body-scroll-disable="true"
  data-open-trigger="none"
  data-id="{{ section.id }}"
  data-limit-display="1"
  data-limit-lifetime="30"
  tabindex="0"
>
  <div class="age-verification__wrapper popup-wrap">
    <div class="age-verification__content">
      <div class="age-verification__question show">
        <div class="age-verification__text-content">
          {%- if section.settings.heading -%}
            <{{ section.settings.heading_tag }} class="popup-heading age-verification__heading {{ section.settings.heading_size }}">
              {{- section.settings.heading -}}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          {%- if section.settings.text -%}
            <div class="popup-text rte">
              {{- section.settings.text -}}
            </div>
          {%- endif -%}
        </div>
        <div class="age-verification__buttons">
          <button class="age-verification__button age-verification__popup-close focus-inset">
            <span class="age-verification__button-label h2" data-label="{{- section.settings.button_label_yes -}}">
              {{- section.settings.button_label_yes -}}
            </span>
            <span class="animated-button-circle"></span>
          </button>
          <button class="age-verification__button age-verification__button-no focus-inset">
            <span class="age-verification__button-label h2" data-label="{{- section.settings.button_label_no -}}">
              {{- section.settings.button_label_no -}}
            </span>
            <span class="animated-button-circle"></span>
          </button>
        </div>
      </div>

      <div class="age-verification__declined">
        <div class="age-declined__wrapper">
          {%- if section.settings.heading_declined -%}
            <{{ section.settings.heading_tag_second }} class="popup-heading age-verification__heading {{ section.settings.heading_size }}">
              {{- section.settings.heading_declined -}}
            </{{ section.settings.heading_tag_second }}>
          {%- endif -%}
          {%- if section.settings.text_declined -%}
            <div class="popup-text rte">
              {{- section.settings.text_declined -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
