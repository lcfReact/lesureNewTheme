{{ 'section-blog-posts.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-blog.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll and section.settings.heading != blank
    assign enable_animation = true
  endif

  case section.settings.image_position
    when 'top'
      assign fb_image_position = 'center top'
    when 'bottom'
      assign fb_image_position = 'center bottom'
    when 'left'
      assign fb_image_position = 'left center'
    when 'right'
      assign fb_image_position = 'right center'
    else
      assign fb_image_position = 'center center'
  endcase

  assign fb_button_label = 'sections.blog-posts.read_all_button_label' | t
  assign fb_button_link = section.settings.blog.url
  if section.settings.button_label != blank
    assign fb_button_label = section.settings.button_label
  endif
  if section.settings.button_link != blank
    assign fb_button_link = section.settings.button_link
  endif
%}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  {% if enable_animation -%}
  #shopify-section-{{ section.id }} [data-enable-header-animation] .blog-posts__heading .word {
    opacity: 0;
    transform: translateY(20px);
    display: inline-block;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .blog-posts__heading .word {
    animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
    animation-delay: calc((var(--word-index) * 0.1s));
  }
  {%- endif -%}
{%- endstyle -%}

<div
  class="blog-posts color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding{% if section.settings.show_border_top %} blog-posts--border-top{% endif %}{% if section.settings.show_border_bottom %} blog-posts--border-bottom{% endif %}"
  style="--fb-active: {{ section.settings.active_color }}; --fb-bg: {{ section.settings.background_color }};"
  {% if enable_animation %}
    data-enable-header-animation="true"
  {% endif %}
>
  <div class="container">
    <div class="blog-posts-content">
      {%- if section.settings.heading != blank -%}
        <div class="blog-posts__header">
          <{{ section.settings.heading_level }} class="blog-posts__heading {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        </div>
      {%- endif -%}

      <div class="fb-layout" data-featured-blog>
        <div
          class="fb-visual"
          style="--fb-image-position: {{ fb_image_position }};{% if section.settings.image != blank %}--fb-ratio: {{ section.settings.image.aspect_ratio }};{% endif %}"
        >
          {% if section.settings.image != blank %}
            {% assign fb_image_alt = section.settings.image.alt | default: section.settings.heading | escape %}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 750px) 46vw, 92vw',
                alt: fb_image_alt,
                class: 'fb-visual__img',
                loading: 'lazy'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'fb-visual__img' }}
          {% endif %}
        </div>

        <div class="fb-list">
          {% if section.blocks.size > 0 %}
            {%- for block in section.blocks limit: 3 -%}
              {% liquid
                assign article = block.settings.article
                assign item_title = 'sections.blog-posts.placeholder_title' | t
                assign item_excerpt = 'sections.blog-posts.placeholder_excerpt' | t
                assign item_image = blank
                assign item_url = blank
                if article != blank
                  assign item_title = article.title | escape
                  assign item_excerpt = article.excerpt_or_content | strip_html | truncate: 140 | escape
                  assign item_image = article.image
                  assign item_url = article.url
                endif
              %}
              {% render 'featured-blog-item',
                title: item_title,
                excerpt: item_excerpt,
                image: item_image,
                url: item_url,
                open: forloop.first,
                placeholder_svg: 'image',
                shopify_attributes: block.shopify_attributes
              %}
            {%- endfor -%}
          {% elsif section.settings.blog != blank %}
            {%- for article in section.settings.blog.articles limit: 3 -%}
              {% liquid
                assign item_title = article.title | escape
                assign item_excerpt = article.excerpt_or_content | strip_html | truncate: 140 | escape
              %}
              {% render 'featured-blog-item',
                title: item_title,
                excerpt: item_excerpt,
                image: article.image,
                url: article.url,
                open: forloop.first,
                placeholder_svg: 'image',
                shopify_attributes: blank
              %}
            {%- endfor -%}
          {% else %}
            {%- for i in (1..3) -%}
              {% liquid
                assign item_title = 'sections.blog-posts.placeholder_title' | t
                assign item_excerpt = 'sections.blog-posts.placeholder_excerpt' | t
              %}
              {% render 'featured-blog-item',
                title: item_title,
                excerpt: item_excerpt,
                image: blank,
                url: blank,
                open: forloop.first,
                placeholder_svg: 'lifestyle-2',
                shopify_attributes: blank
              %}
            {%- endfor -%}
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_button and fb_button_label != blank %}
        <div class="blog-posts__button-wrapper">
          {% render 'button',
            btn_link: fb_button_link,
            btn_label: fb_button_label,
            btn_style: section.settings.button_style,
            class: 'blog-posts__button'
          %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.blog-posts.name",
  "tag": "section",
  "class": "spaced-section section-blog-posts",
  "enabled_on": {
    "templates": ["*"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.blog-posts.settings.header__1.content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog-posts.settings.blog.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left image",
      "info": "Stays fixed and does not change with the selected article."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image crop position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Selected card color",
      "default": "#DDD4F2"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "default": false,
      "label": "t:sections.blog-posts.settings.show_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "default": false,
      "label": "t:sections.blog-posts.settings.show_border_bottom.label"
    },
    {
      "type": "paragraph",
      "content": "Title, excerpt and cover image are taken from each article. Add up to 3 articles and drag to reorder."
    },
    {
      "type": "header",
      "content": "t:sections.blog-posts.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "animate_section_header_on_scroll",
      "default": true,
      "label": "t:sections.all.animate_section_header_on_scroll.label",
      "info": "t:sections.all.animate_section_header_on_scroll.info"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.blog-posts.settings.section_header_text.default"
    },
    {
      "type": "select",
      "id": "heading_level",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_level.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_level.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_level.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_level.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_level.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_level.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_level.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_level.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__4.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.blog-posts.settings.header__7.content"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": true,
      "label": "t:sections.blog-posts.settings.show_button.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.blog-posts.settings.button_label.label",
      "info": "t:sections.blog-posts.settings.button_label.info",
      "default": "t:sections.blog-posts.settings.button_label.default"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.blog-posts.settings.button_link.label",
      "info": "t:sections.blog-posts.settings.button_link.info"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "xl",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "xl",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog-posts.presets.name",
      "category": "t:sections.categories.storytelling",
      "blocks": [
        {
          "type": "article"
        },
