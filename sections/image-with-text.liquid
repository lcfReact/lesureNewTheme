{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank or section.settings.subheading != blank
      assign enable_animation = true
    endif
  endif
-%}

{%- if section.settings.enable_parallax or enable_animation -%}
  <script src="{{ 'image-with-text.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign heading_delay = 0

  if section.settings.subheading != blank
    assign heading_delay = 0.1
  endif

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay
%}

<div
  class="image-with-text{% if section.settings.enable_border_top %} image-with-text--border-top{% endif %}{% if section.settings.enable_border_bottom %} image-with-text--border-bottom{% endif %} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding"
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s;"
  {% endif %}
>
  <div class="container">
    {% render 'heading-group',
      section: section,
      class: 'image-with-text',
      text_align: section.settings.text_align,
      enable_animation: section.settings.animate_section_header_on_scroll
    %}

    <div
      class="content image-with-text__main image-with-text__main--align-image-{{ section.settings.img_position }}{% if section.blocks.size == 0 %} image-with-text__main--full-width{% endif %}"
    >
      <div
        class="image-with-text__img-wrapper"
        {% if section.settings.aspect_ratio != 'adapt' %}
          style="aspect-ratio: {{ section.settings.aspect_ratio }}"
        {% else %}
          {%- if section.settings.image == blank -%}
            style="aspect-ratio: 1"
          {% else %}
            style="aspect-ratio: {{ section.settings.image.aspect_ratio }}"
          {% endif %}
        {% endif %}
      >
        {% if section.settings.rotating_text != blank %}
          {% liquid
            assign rotating_text = section.settings.rotating_text | truncate: 20, ''
            assign char_count = rotating_text | size
            assign total_sum = 0
          %}

          {% for i in (1..char_count) %}
            {% assign total_sum = total_sum | plus: section.settings.rotating_text_letter_spacing %}
          {% endfor %}

          <div class="image-with-text__rotating-text color-{{ section.settings.color_scheme_rotating_text }}">
            <svg viewBox="0 0 132 132">
              <defs>
                <path
                  id="circlePath"
                  d="
                    M 66,66
                    m -38, 0
                    a 38,38 0 1,1 76,0
                    a 38,38 0 1,1 -76,0"
                  transform="rotate(180,66,66)"
                />
              </defs>
              <text>
                <textPath xlink:href="#circlePath" textLength="{{ total_sum }}">
                  {{ rotating_text }}
                </textPath>
              </text>
            </svg>
          </div>
        {% endif %}
        {% if section.settings.enable_parallax %}
          <div
            class="image-with-text__parallax-wrapper js-parallax"
            data-parallax-property="translateY"
            data-parallax-property-value="100"
            data-parallax-steps="0, 100"
          >
        {% endif %}
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign object_fit = 'object-fit: ' | append: section.settings.object_fit

            assign settings_aspect_ratio = 1

            if section.settings.aspect_ratio != 'adapt'
              assign settings_aspect_ratio_numbers = section.settings.aspect_ratio | split: '/'
              assign settings_aspect_ratio = settings_aspect_ratio_numbers[0] | append: '.0' | divided_by: settings_aspect_ratio_numbers[1]
            endif

            assign calc_ratio = 1

            if section.settings.image.aspect_ratio > settings_aspect_ratio
              assign calc_ratio = section.settings.image.aspect_ratio | divided_by: settings_aspect_ratio | round: 2
            endif

            assign img_loading = 'lazy'

            if section.index == 1
              assign img_loading = 'eager'
            endif
          -%}
          {%- capture sizes -%}
              {%- if section.settings.img_position == 'top' or section.settings.img_position == 'bottom' or section.blocks.size == 0 -%}
                calc(100vw * {{ calc_ratio }})
              {%- else -%}
                (min-width: 1440px) calc(66vw - {{ calc_ratio }}), (min-width: 1200px) calc(44vw * {{ calc_ratio }}), (min-width: 750px) calc(48vw * {{ calc_ratio }}), 92vw
              {%- endif -%}
            {%- endcapture -%}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              sizes: sizes,
              widths: '300, 400, 600, 700, 800, 900, 1000, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 3000',
              style: object_fit,
              loading: img_loading
          }}
        {%- else -%}
          {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--filled' }}
        {%- endif -%}
        {% if section.settings.enable_parallax %}
          </div>
        {% endif %}
      </div>
      {% if section.blocks.size > 0 %}
        <div
          class="
            image-with-text__content image-with-text__content--align-{{ section.settings.inner_content_align }}
            {% if section.settings.img_position == 'left' or section.settings.img_position == 'right' %} image-with-text__content--vertical-align-{{ section.settings.vertical_inner_content_align }} {% endif %}
          "
        >
          <div class="image-with-text__items image-with-text__items--{{ section.settings.content_width }}">
            {% for block in section.blocks %}
              {% assign show_button = false %}
              {% if block.settings.show_button and block.settings.button_label != blank %}
                {% assign show_button = true %}
              {% endif %}

              {% if block.settings.heading != blank or block.settings.text != blank or show_button %}
                <div class="image-with-text__item" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}
                    <{{ block.settings.heading_tag }} class="image-with-text__inner-heading {{ block.settings.heading_size }}">
                      {{ block.settings.heading | newline_to_br }}
                    </{{ block.settings.heading_tag }}>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="image-with-text__inner-text">
                      {{ block.settings.description | newline_to_br }}
                    </div>
                  {% endif %}

                  {% if block.settings.show_button %}
                    {% render 'button', layout: block, class: 'image-with-text__button' %}
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

