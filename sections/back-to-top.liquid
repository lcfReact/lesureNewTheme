{%- liquid
  assign back_to_top_show = false
  if section.settings.enabled
    case request.page_type
      when 'index'
        if section.settings.page_index
          assign back_to_top_show = true
        endif
      when 'product'
        if section.settings.page_product
          assign back_to_top_show = true
        endif
      when 'collection'
        if section.settings.page_collection
          assign back_to_top_show = true
        endif
      when 'page'
        if section.settings.page_page
          assign back_to_top_show = true
        endif
      when 'blog'
        if section.settings.page_blog
          assign back_to_top_show = true
        endif
      when 'article'
        if section.settings.page_article
          assign back_to_top_show = true
        endif
      when 'cart'
        if section.settings.page_cart
          assign back_to_top_show = true
        endif
      when 'search'
        if section.settings.page_search
          assign back_to_top_show = true
        endif
      else
        if section.settings.page_other
          assign back_to_top_show = true
        endif
    endcase
  endif
-%}
{%- if back_to_top_show or request.design_mode and section.settings.enabled -%}
  {% style %}
    #BackToTop-{{ section.id }} {
      --back-bg: {{ section.settings.background }};
      --back-icon: {{ section.settings.icon_color }};
      --back-right: {{ section.settings.desktop_right }}px;
      --back-bottom: {{ section.settings.desktop_bottom }}px;
      --back-right-mobile: {{ section.settings.mobile_right }}px;
      --back-bottom-mobile: {{ section.settings.mobile_bottom }}px;
    }
  {% endstyle %}

  <button
    type="button"
    id="BackToTop-{{ section.id }}"
    class="back-to-top"
    aria-label="{{ 'general.back_to_top' | t | escape }}"
  >
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M5 12.5L10 7.5L15 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
{%- endif -%}

{% stylesheet %}
  .back-to-top-section {
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    background: transparent;
  }

  .back-to-top {
    position: fixed;
    right: var(--back-right, 24px);
    bottom: var(--back-bottom, 24px);
    z-index: 31;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 35px;
    height: 35px;
    margin: 0;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--back-icon, #1d2433) 12%, transparent);
    border-radius: 50%;
    background: var(--back-bg, #fff);
    color: var(--back-icon, #1d2433);
    box-shadow: 0 4px 14px rgba(16, 24, 40, 0.16);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .back-to-top svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  @media (max-width: 749px) {
    .back-to-top {
      right: var(--back-right-mobile, 16px);
      bottom: var(--back-bottom-mobile, 16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (window.backToTopBoot) return;
    window.backToTopBoot = true;

    const observed = new WeakSet();
    const observer = new MutationObserver(() => updateAll());
    let frame = 0;
    let settle = 0;

    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const place = (button) => {
      const card = document.querySelector(".sticky-atc.is-visible");
      const rect = card ? card.getBoundingClientRect() : null;
      if (!rect || rect.width < 8 || rect.height < 8) {
        button.style.right = "";
        button.style.bottom = "";
        return;
      }
      const gap = 12;
      const cardStyle = window.getComputedStyle(card);
      const cardBottom = parseFloat(cardStyle.bottom) || 0;
      const anchor = card.querySelector(".sticky-atc__submit") || card;
      const scrollbar = window.innerWidth - document.documentElement.clientWidth;
      const anchorRight = anchor.getBoundingClientRect().right;
      button.style.right = `${Math.max(0, Math.round(window.innerWidth - anchorRight - scrollbar))}px`;
      button.style.bottom = `${Math.round(cardBottom + card.offsetHeight + gap)}px`;
    };

    const updateOne = (button) => {
      const pastFirstScreen = window.scrollY > document.documentElement.clientHeight;
      const show = pastFirstScreen || window.Shopify?.designMode === true;
      button.classList.toggle("is-visible", show);
      button.setAttribute("aria-hidden", show ? "false" : "true");
      if ("inert" in button) button.inert = !show;
      if (show) {
        place(button);
      } else {
        button.style.right = "";
        button.style.bottom = "";
      }
    };

    const updateAll = () => {
      document.querySelectorAll(".back-to-top").forEach(updateOne);
    };

    const watchCards = () => {
      document.querySelectorAll(".sticky-atc").forEach((card) => {
        if (observed.has(card)) return;
        observed.add(card);
        observer.observe(card, { attributes: true, attributeFilter: ["class", "style"] });
      });
    };

    const onScroll = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateAll();
      });
      window.clearTimeout(settle);
      settle = window.setTimeout(updateAll, 900);
    };

    document.addEventListener("click", (event) => {
      const button = event.target.closest?.(".back-to-top");
      if (!button) return;
      window.scrollTo({ top: 0, behavior: reduceMotion() ? "auto" : "smooth" });
    });

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    document.addEventListener("shopify:section:load", () => {
      watchCards();
      updateAll();
    });

    const boot = () => {
      watchCards();
      updateAll();
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
{% endjavascript %}

