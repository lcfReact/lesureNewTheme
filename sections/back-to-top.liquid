      "label": "t:sections.back-to-top.settings.page_product.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "page_collection",
      "label": "t:sections.back-to-top.settings.page_collection.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "page_page",
      "label": "t:sections.back-to-top.settings.page_page.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "page_blog",
      "label": "t:sections.back-to-top.settings.page_blog.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "page_article",
      "label": "t:sections.back-to-top.settings.page_article.label",
      "default": true
    },
    {
      "type": "checkbox",
