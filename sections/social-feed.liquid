{{ 'section-social-feed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'social-feed-stage.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div
  class="social-feed ugc-stage color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding{% if section.settings.background_color != blank %} ugc-stage--custom-bg{% endif %}{% if section.settings.enable_border_top %} social-feed--border-top{% endif %}{% if section.settings.enable_border_bottom %} social-feed--border-bottom{% endif %}"
  data-ugc-stage
  style="
    --ugc-title-size: {{ section.settings.heading_font_size }}px;
    --ugc-text-size: {{ section.settings.text_font_size }}px;
    --ugc-radius: {{ section.settings.card_radius }}px;
    --ugc-title-color: {{ section.settings.heading_color }};
    --ugc-text-color: {{ section.settings.text_color }};
    {% if section.settings.background_color != blank %}--ugc-bg: {{ section.settings.background_color }};{% endif %}
  "
>
  <div class="ugc-stage__head">
    {%- if section.settings.subheading != blank -%}
      <p class="ugc-stage__eyebrow">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_level | default: 'h2' }} class="ugc-stage__title">
        {{ section.settings.heading | escape | newline_to_br }}
      </{{ section.settings.heading_level | default: 'h2' }}>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="ugc-stage__text">{{ section.settings.description }}</div>
    {%- endif -%}
    {%- if section.settings.social_tiktok != blank
      or section.settings.social_instagram != blank
      or section.settings.social_facebook != blank
    -%}
      <div class="ugc-stage__social">
        {%- if section.settings.social_tiktok != blank -%}
          <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok">
            {% render 'icon-tiktok' %}
          </a>
        {%- endif -%}
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" aria-label="Instagram">
            {% render 'icon-instagram' %}
          </a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" aria-label="Facebook">
            {% render 'icon-facebook' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ugc-stage__main">
      <button type="button" class="ugc-stage__arrow ugc-stage__arrow--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
        {% render 'icon-caret-left' %}
      </button>
      <div class="ugc-stage__slider swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_product = block.settings.product
              assign quick_buy_key = section.id | append: '-' | append: card_product.id | append: '-' | append: block.id
            -%}
            <div class="ugc-slide swiper-slide" {{ block.shopify_attributes }}>
              <article class="ugc-card">
                <div class="ugc-card__media">
                  {%- if block.settings.video != blank -%}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '800x',
                        autoplay: false,
                        loop: true,
                        muted: true,
                        controls: false,
                        class: 'ugc-card__video'
                    }}
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        class: 'ugc-card__cover',
                        widths: '300, 500, 800',
                        sizes: '(min-width: 750px) 491px, 68vw',
                        alt: card_product.title | default: section.settings.heading | escape
                    }}
                  {%- elsif block.settings.video == blank -%}
                    {{ 'image' | placeholder_svg_tag: 'ugc-card__cover ugc-card__cover--placeholder' }}
                  {%- endif -%}
                  {%- if block.settings.video != blank -%}
                    <button type="button" class="ugc-card__play" aria-label="{{ 'general.video.play' | t }}">
                      {% render 'icon-play' %}
                    </button>
                  {%- endif -%}
                </div>
                {%- if card_product != blank and block.settings.show_product -%}
                  <div class="ugc-product">
                    <a class="ugc-product__media" href="{{ card_product.url }}">
                      {%- if card_product.featured_image -%}
                        {{
                          card_product.featured_image
                          | image_url: width: 400
                          | image_tag:
                            widths: '160, 320, 400',
                            sizes: '(min-width: 750px) 122px, 48px',
                            alt: card_product.title
                        }}
                      {%- endif -%}
                    </a>
                    <a class="ugc-product__meta" href="{{ card_product.url }}">
                      <span class="ugc-product__title">{{ card_product.title | escape }}</span>
                      <span class="ugc-product__price">{{ card_product.price | money }}</span>
                    </a>
                    <button
                      type="button"
                      class="ugc-product__add quick-buy-open"
                      aria-label="{{ 'products.product.add_to_cart' | t }} {{ card_product.title | escape }}"
                      data-product-url="{{ card_product.url }}"
                      data-swatch-id="QuickBuySwatches-{{ quick_buy_key }}"
                    >
                      {% render 'icon-plus' %}
                    </button>
                  </div>
                  {% render 'quick-buy-swatches',
                    product_card_product: card_product,
                    section_id: section.id,
                    add_id: block.id
                  %}
                {%- endif -%}
              </article>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <button type="button" class="ugc-stage__arrow ugc-stage__arrow--next" aria-label="{{ 'general.slider.next_slide' | t }}">
        {% render 'icon-caret-right' %}
      </button>
    </div>
  {%- endif -%}
</div>

