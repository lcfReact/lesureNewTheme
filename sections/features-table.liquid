{{ 'section-features-table.css' | asset_url | stylesheet_tag }}

{% liquid
  assign anchor = section.settings.anchor_id | handleize
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank
      assign enable_animation = true
    endif
  endif
%}

{%- if enable_animation -%}
  <script src="{{ 'features-table.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% if section.settings.column_bg_color != 0 and section.settings.column_bg_color != blank %}
  <style>
    #shopify-section-{{ section.id }} {
      --column-bg-color: {{ section.settings.column_bg_color.red }},{{ section.settings.column_bg_color.green }},{{ section.settings.column_bg_color.blue }};
    }
  </style>
{% endif %}

{% style %}
  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row:nth-child(1) .features-table-cell:nth-child({{ section.settings.column_index }})::before{
    border-top-left-radius: var(--border-radius-block);
    border-top-right-radius: var(--border-radius-block);
  }
  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }})::before{
    background-color: rgba(var(--column-bg-color, var(--color-background-secondary)));
  }

  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__text {
    color: rgba(var(--color-foreground));
  }

  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }}) svg{
    fill: rgba(var(--color-background-secondary));
  }

  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__icon svg rect,
  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__icon svg path{
    stroke:rgba(var(--color-foreground));
  }

  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__text,
  .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__icon{
    padding-left: 0.8rem;
    padding-right: 0.8rem;
  }

  @media screen and (hover: hover) and (pointer: fine) {
    .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row--with-hover:hover .features-table-cell:nth-child({{ section.settings.column_index }})::before {
      background-color: rgba(var(--color-foreground));
    }
    .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row--with-hover:hover .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__text {
      color: rgba(var(--color-background));
    }
    .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row--with-hover:hover .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__icon svg{
      fill: rgba(var(--color-foreground));
    }
    .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row--with-hover:hover .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__icon svg rect,
    .features-table-body--column-highlight-{{ section.settings.column_index }} .features-table-row--with-hover:hover .features-table-cell:nth-child({{ section.settings.column_index }}) .features-table-cell__icon svg path{
      stroke:rgba(var(--color-background));;
    }
  }
{% endstyle %}

{% liquid
  assign heading_delay = 0

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay
%}

{%- if enable_animation -%}
  {% style %}
    #shopify-section-{{ section.id }} [data-enable-header-animation] .features-table-header__title .word {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} [data-enable-header-animation] .features-table-header__description {
      opacity: 0;
      transform: translateY(20px);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .features-table-header__title .word {
      animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: calc(var(--heading-delay) + (var(--word-index) * 0.1s));
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .features-table-header__description {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--description-delay);
    }
  {% endstyle %}
{%- endif -%}

<div
  class="features-table-wrapper {% if section.settings.top_border %}features-table-wrapper--border-top{% endif %} {% if section.settings.bottom_border %}features-table-wrapper--border-bottom{% endif %} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding"
  {% if anchor != blank %}
    id="{{ anchor }}"
    data-anchor="{{ anchor }}"
  {% endif %}
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s;"
  {% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="features-table-header features-table-header--alignment-{{ section.settings.text_align }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_level }} class="features-table-header__title {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="features-table-header__description body-normal">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="features-table-container">
      <table class="features-table {% if section.settings.enable_table_border %}features-table--border-bottom{% endif %}">
        <tbody class="features-table-body {% if section.settings.enable_column_highlight %}features-table-body--column-highlight-{{ section.settings.column_index }}{% endif %}">
          {% content_for 'blocks' %}
        </tbody>
      </table>
    </div>
  </div>
</div>

