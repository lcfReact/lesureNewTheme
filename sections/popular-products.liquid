{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}

<script src="{{ 'popular-products.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign block_product_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign block_product_count = block_product_count | plus: 1
    endif
  endfor
  assign list_product_count = section.settings.product_list.count | default: 0
  assign chosen_product_count = block_product_count | plus: list_product_count
  assign slides_count_diff = chosen_product_count | minus: section.settings.products_to_show

  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank or section.settings.subheading != blank or section.settings.button_show and section.settings.button_label != blank
      assign enable_animation = true
    endif
  endif

  assign heading_delay = 0

  if section.settings.subheading != blank
    assign heading_delay = 0.1
  endif

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay

  assign button_delay = description_delay | plus: 0.1
%}

<div
  class="popular-products popular-products--desktop-layout-{{ section.settings.desktop_layout }} popular-products--mobile-layout-{{ section.settings.mobile_layout }} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding{% if section.settings.enable_border_top %} popular-products--border-top{% endif %}{% if section.settings.enable_border_bottom %} popular-products--border-bottom{% endif %}"
  data-layout="{{ section.settings.desktop_layout }}"
  data-layout-mobile="{{ section.settings.mobile_layout }}"
  {% if enable_animation %}
    data-enable-header-animation="true"
  {% endif %}
  style="--popular-columns: {{ section.settings.products_to_show }};{% if enable_animation %} --heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s; --button-delay: {{ button_delay }}s;{% endif %}"
>
  {%- if section.settings.heading != blank
    or section.settings.description != blank
    or section.settings.subheading != blank
    or section.settings.button_show
    and section.settings.button_label != blank
  -%}
    <div class="popular-products-top popular-products-top--align-{{ section.settings.text_align }} container">
      <div class="popular-products-top__heading-group">
        {% render 'heading-group',
          section: section,
          class: 'popular-products',
          text_align: section.settings.text_align,
          enable_animation: section.settings.animate_section_header_on_scroll
        %}
      </div>

      {%- if section.settings.button_show and section.settings.button_label -%}
        {% render 'button',
          btn_label: section.settings.button_label,
          btn_style: section.settings.button_style,
          btn_link: section.settings.button_link,
          class: 'popular-products-button heading-group-button'
        %}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="popular-products-main container content">
    <div
      class="popular-products-layout"
      data-columns="{{ section.settings.products_to_show }}"
      {% if section.settings.enable_loop and slides_count_diff > 1 %}
        data-loop="true"
      {% endif %}
      {% if section.settings.centered_slides %}
        data-centered-slides="true"
      {% endif %}
    >
      <div
        class="popular-products-list{% if section.settings.desktop_layout == 'grid' %} popular-products-desktop-grid popular-products-desktop-grid--{{ section.settings.products_to_show }}{% endif %}{% if section.settings.desktop_layout == 'slider' %} popular-products-desktop-slider{% endif %}{% if section.settings.mobile_layout == 'slider' %} popular-products-mobile-slider{% endif %}{% if section.settings.mobile_layout == 'column' %} popular-products-mobile-column{% endif %}"
      >
        {%- liquid
          assign shown_ids = '|'
          assign shown_count = 0
        -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- assign shown_ids = shown_ids | append: block.settings.product.id | append: '|' -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
            <div class="popular-products-item collection-product-card" {{ block.shopify_attributes }}>
              {% render 'product-card',
                product_card_product: block.settings.product,
                media_ratio: section.settings.image_ratio,
                media_fit: section.settings.image_fit,
                show_vendor: section.settings.show_vendor,
                show_desc: section.settings.show_desc,
                reserve_description: true,
                section_id: section.id,
                add_id: block.id,
                columns: section.settings.products_to_show,
                color_scheme: section.settings.color_scheme
              %}
            </div>
          {%- else -%}
            <div class="popular-products-item popular-products-item--placeholder collection-product-card" {{ block.shopify_attributes }}>
              {% render 'product-card-placeholder',
                media_ratio: section.settings.image_ratio,
                show_vendor: section.settings.show_vendor,
                product_number: forloop.index,
                color_scheme: section.settings.color_scheme,
                show_desc: section.settings.show_desc
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- for product in section.settings.product_list -%}
          {%- assign product_token = '|' | append: product.id | append: '|' -%}
          {%- unless shown_ids contains product_token -%}
            {%- assign shown_ids = shown_ids | append: product.id | append: '|' -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
            <div class="popular-products-item collection-product-card">
              {% render 'product-card',
                product_card_product: product,
                media_ratio: section.settings.image_ratio,
                media_fit: section.settings.image_fit,
                show_vendor: section.settings.show_vendor,
                show_desc: section.settings.show_desc,
                reserve_description: true,
                section_id: section.id,
                add_id: forloop.index,
                columns: section.settings.products_to_show,
                color_scheme: section.settings.color_scheme
              %}
            </div>
          {%- endunless -%}
        {%- endfor -%}
        {%- if shown_count == 0 and section.blocks.size == 0 -%}
          {% if section.settings.desktop_layout == 'slider' %}
            {% assign number_placeholders = 6 %}
          {% else %}
            {% assign number_placeholders = section.settings.products_to_show %}
          {% endif %}
          {%- for i in (1..number_placeholders) -%}
            <div
              class="popular-products-item popular-products-item--placeholder collection-product-card"
            >
              {% render 'product-card-placeholder',
                media_ratio: section.settings.image_ratio,
                show_vendor: section.settings.show_vendor,
                product_number: forloop.index,
                color_scheme: section.settings.color_scheme,
                show_desc: section.settings.show_desc
              %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.desktop_layout == 'slider' or section.settings.mobile_layout == 'slider' -%}
        <div class="popular-products-nav{% if section.settings.show_nav_buttons_desktop %} popular-products-nav--show-desktop{% endif %}{% if section.settings.show_nav_buttons_mobile %} popular-products-nav--show-mobile{% endif %} no-js-hidden">
          {% render 'slider-button',
            direction: 'prev',
            classnames: 'popular-products-nav-button popular-products-nav-button--prev'
          %}
          {% render 'slider-button',
            direction: 'next',
            classnames: 'popular-products-nav-button popular-products-nav-button--next'
          %}
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.desktop_layout == 'slider' or section.settings.mobile_layout == 'slider' -%}
      <div class="popular-products-progress" hidden>
        <span class="popular-products-progress__track" aria-hidden="true">
          <span class="popular-products-progress__bar"></span>
        </span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.popular-products.name",
  "tag": "section",
  "class": "popular-products-section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "default": false,
      "label": "t:sections.all.enable_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_bottom",
      "default": false,
      "label": "t:sections.all.enable_border_bottom.label"
    },
    {
      "type": "checkbox",
      "id": "animate_section_header_on_scroll",
      "default": true,
      "label": "t:sections.all.animate_section_header_on_scroll.label",
      "info": "t:sections.all.animate_section_header_on_scroll.info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_level",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_level.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_level.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_level.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_level.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_level.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_level.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_level.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_level.label"
    },

    {
      "type": "inline_richtext",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "default": "left"
    },
    {
      "type": "paragraph",
      "content": "t:sections.popular-products.settings.products_info.content"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "limit": 16,
      "label": "t:sections.popular-products.settings.product_list.label",
      "info": "t:sections.popular-products.settings.product_list.info"
    },
    {
      "type": "header",
      "content": "t:sections.popular-products.settings.heading__2.content"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:sections.popular-products.settings.desktop_layout.label",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.popular-products.settings.desktop_layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.popular-products.settings.desktop_layout.options__2.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons_desktop",
      "label": "t:sections.popular-products.settings.show_nav_buttons.label",
      "visible_if": "{{ section.settings.desktop_layout == 'slider' }}",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.popular-products.settings.mobile_layout.label",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.popular-products.settings.mobile_layout.options__1.label"
        },
        {
          "value": "column",
          "label": "t:sections.popular-products.settings.mobile_layout.options__2.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons_mobile",
      "label": "t:sections.popular-products.settings.show_nav_buttons_mobile.label",
      "visible_if": "{{ section.settings.mobile_layout == 'slider' }}",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "default": false,
      "label": "t:sections.popular-products.settings.enable_loop.label",
      "info": "t:sections.popular-products.settings.enable_loop.info",
      "visible_if": "{{ section.settings.desktop_layout == 'slider' or section.settings.mobile_layout == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "centered_slides",
      "label": "t:sections.popular-products.settings.centered_slides.label",
      "info": "t:sections.popular-products.settings.centered_slides.info",
      "default": false,
      "visible_if": "{{ section.settings.desktop_layout == 'slider' or section.settings.mobile_layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.popular-products.settings.products_to_show.label",
      "info": "t:sections.popular-products.settings.products_to_show.info",
      "visible_if": "{{ section.settings.centered_slides == false }}"
    },
    {
      "type": "header",
      "content": "t:sections.popular-products.settings.heading__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "portrait",
      "label": "t:sections.popular-products.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.all.card.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "default": true,
      "label": "t:sections.popular-products.settings.show_desc.label",
      "info": "t:sections.popular-products.settings.show_desc.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "checkbox",
      "id": "button_show",
      "default": false,
      "label": "t:sections.all.button.button_show.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button.button_label.label",
      "default": "t:sections.popular-products.settings.button_label.default"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.popular-products.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.popular-products.blocks.product.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.popular-products.presets.name",
      "category": "t:sections.categories.products"
    }
  ]
}
{% endschema %}
