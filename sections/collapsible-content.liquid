{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}

<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign anchor = section.settings.anchor_id | handleize
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank
      assign enable_animation = true
    endif
  endif

  assign heading_delay = 0

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay
%}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  /* Critical styles to prevent FOUC in Safari */

  .collapsible-content {
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .collapsible-content__header {
    max-width: 67.6rem;
    width: 100%;
  }

  .collapsible-content__header--center {
    margin-left: auto;
    margin-right: auto;
  }

  .collapsible-content__header--center .collapsible-content__heading,
  .collapsible-content__header--center .collapsible-content__description {
    text-align: center;
  }

  .collapsible-content__header--left {
    margin-right: auto;
  }

  .collapsible-content__header--left .collapsible-content__heading,
  .collapsible-content__header--left .collapsible-content__description {
    text-align: left;
  }

  .collapsible-content__header--right {
    margin-left: auto;
  }

  .collapsible-content__header--right .collapsible-content__heading,
  .collapsible-content__header--right .collapsible-content__description {
    text-align: right;
  }

  .collapsible-content__content {
    margin-top: 4rem;
    max-width: 91rem;
    width: 100%;
  }

  .collapsible-content__content--center {
    margin-left: auto;
    margin-right: auto;
  }

  .collapsible-content__content--left {
    margin-right: auto;
  }

  .collapsible-content__content--right {
    margin-left: auto;
  }

  .collapsible-content__items {
    display: flex;
    flex-direction: column;
  }

  .collapsible-content__item {
    overflow: hidden;
    padding: 2.2rem 0;
  }

  .collapsible-content__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    column-gap: 1.6rem;
    width: 100%;
  }

  .collapsible-content__toggle-group {
    display: flex;
    align-items: center;
  }

  .collapsible-content__question {
    margin: 0;
    text-align: left;
    max-width: 74.4rem;
    width: 100%;
  }

  .collapsible-content__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    position: relative;
  }

  .collapsible-content__answer {
    margin: 0;
    max-width: 67.6rem;
    width: 100%;
  }

  /* Animation styles */

  {% if enable_animation -%}
    #shopify-section-{{ section.id }} [data-enable-header-animation] .collapsible-content__heading .word {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} [data-enable-header-animation] .collapsible-content__description {
      opacity: 0;
      transform: translateY(20px);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .collapsible-content__heading .word {
      animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: calc(var(--heading-delay) + (var(--word-index) * 0.1s));
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .collapsible-content__description {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--description-delay);
    }
  {%- endif -%}
{%- endstyle -%}

<div
  class="collapsible-content color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding{% if section.settings.show_border_top %} collapsible-content--border-top{% endif %}{% if section.settings.show_border_bottom %} collapsible-content--border-bottom{% endif %}"
  {% if anchor != blank %}
    id="{{ anchor }}"
    data-anchor="{{ anchor }}"
  {% endif %}
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s;"
  {% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="collapsible-content__header collapsible-content__header--{{ section.settings.content_align }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_level }} class="collapsible-content__heading {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="collapsible-content__description body-normal">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collapsible-content__content content collapsible-content__content--{{ section.settings.content_align }}">
      <div class="collapsible-content__items">
        {%- for block in section.blocks -%}
          <div
            class="collapsible-content__item {% if block.settings.opened %} active {% endif %}"
            {{ block.shopify_attributes }}
          >
            <button class="collapsible-content__toggle button--unstyled focus-inset">
              <div class="collapsible-content__toggle-group">
                {%- if block.settings.question != blank -%}
                  <p class="collapsible-content__question {{ section.settings.question_size }}">
                    {{ block.settings.question | escape }}
                  </p>
                {%- endif -%}
              </div>
              <div class="collapsible-content__icon"></div>
            </button>

            {%- if block.settings.answer != blank -%}
              <div
                class="collapsible-content__answer body-normal rte"
                {% if block.settings.opened == false %}
                  style="display: none;"
                {% endif %}
              >
                {{ block.settings.answer }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

