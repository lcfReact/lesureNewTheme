      "label": "t:sections.multicolumn.settings.caption_size.label",
      "default": 1.4
    },
    {
      "type": "range",
      "id": "caption_size_mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "label": "t:sections.multicolumn.settings.caption_size_mobile.label",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "caption_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.caption_gap.label",
      "default": 12
    },
    {
      "type": "range",
