      "type": "header",
      "content": "t:sections.testimonials.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "product_card_color_scheme",
      "default": "background-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
