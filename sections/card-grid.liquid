{{ 'section-card-grid.css' | asset_url | stylesheet_tag }}

{% liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank
      assign enable_animation = true
    endif
  endif
%}

{%- if enable_animation -%}
  <script src="{{ 'card-grid.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

{% liquid
  assign image_styles = 'object-fit: cover;'

  if section.settings.object_fit == 'contain'
    assign image_styles = 'object-fit: contain;'
  endif

  assign heading_delay = 0

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay
%}

{%- if section.blocks.size > 0 -%}
  {%- if section.settings.grid_count == 1 -%}
    {% style %}
      #shopify-section-{{ section.id }} .card-grid__grid--1{
        max-width: 44.3rem;
      }
    {% endstyle %}
  {%- endif -%}

  {%- if section.settings.grid_count == 2 -%}
    {% style %}
      #shopify-section-{{ section.id }} .card-grid__grid--2{
        max-width: 91rem;
      }
    {% endstyle %}
  {%- endif -%}

  {%- if section.settings.grid_count == 3 -%}
    {% style %}
      #shopify-section-{{ section.id }} .card-grid__grid--3{
        max-width: 137.7rem;
      }
    {% endstyle %}
  {%- endif -%}
{%- endif -%}

{%- if enable_animation -%}
  {% style %}
    #shopify-section-{{ section.id }} [data-enable-header-animation] .card-grid__heading .word {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} [data-enable-header-animation] .card-grid__description {
      opacity: 0;
      transform: translateY(20px);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .card-grid__heading .word {
      animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: calc(var(--heading-delay) + (var(--word-index) * 0.1s));
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .card-grid__description {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--description-delay);
    }
  {% endstyle %}
{%- endif -%}

<div
  class="card-grid card-grid-{{ section.id }} color-{{ section.settings.main_color_scheme }} background section-{{ section.id }}-padding{% if section.settings.enable_border_top %} card-grid--border-top{% endif %}{% if section.settings.enable_border_bottom %} card-grid--border-bottom{% endif %}"
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s;"
  {% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="card-grid__header card-grid__header--{{ section.settings.text_align }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_level }} class="card-grid__heading {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="card-grid__description body-normal">
            {{- section.settings.description -}}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% if section.blocks.size > 0 %}
      <div class="card-grid__grid card-grid__grid--{{ section.settings.grid_count }}">
        {%- for block in section.blocks -%}
          <div
            class="card-grid__card card-grid__card--{{ section.settings.card_border_radius }} color-{{ block.settings.card_color_scheme }} background"
            {{ block.shopify_attributes }}
          >
            <div class="card-grid__card-image-wrapper card-grid__card-image-wrapper--{{ section.settings.aspect_ratio }}">
              {% liquid
                if section.settings.aspect_ratio == 'landscape'
                  assign settings_aspect_ratio = 1.77
                elsif section.settings.aspect_ratio == 'portrait'
                  assign settings_aspect_ratio = 0.8
                else
                  assign settings_aspect_ratio = 1
                endif

                assign calc_ratio = 1
                if block.settings.image.aspect_ratio > settings_aspect_ratio
                  assign calc_ratio = block.settings.image.aspect_ratio | divided_by: settings_aspect_ratio | round: 2
                endif
              %}

              {%- capture img_sizes -%}
                {%- if section.settings.grid_count == 1 -%}
                  (min-width: 1440px) calc(1280px * {{ calc_ratio }}), (min-width: 1200px) calc(88vw * {{ calc_ratio }}), (min-width: 750px) calc(97vw * {{ calc_ratio }}), (min-width: 576px) calc(95vw * {{ calc_ratio }}), calc(91vw * {{ calc_ratio }})
                {%- elsif section.settings.grid_count == 2 -%}
                  (min-width: 1440px) calc(632px * {{ calc_ratio }}), (min-width: 1200px) calc(44vw * {{ calc_ratio }}), (min-width: 750px) calc(48vw * {{ calc_ratio }}), (min-width: 576px) calc(95vw * {{ calc_ratio }}), calc(91vw * {{ calc_ratio }})
                {%- elsif section.settings.grid_count == 3 -%}
                  (min-width: 1440px) calc(416px * {{ calc_ratio }}), (min-width: 1200px) calc(29vw * {{ calc_ratio }}), (min-width: 750px) calc(48vw * {{ calc_ratio }}), (min-width: 576px) calc(95vw * {{ calc_ratio }}), calc(91vw * {{ calc_ratio }})
                {%- else -%}
                  100vw
                {%- endif -%}
              {%- endcapture -%}

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    loading: 'lazy',
                    widths: '308, 416, 632, 700, 800, 900, 1000, 1200, 1400, 1600, 1800, 2000, 2200, 2560',
                    sizes: img_sizes,
                    class: 'card-grid__card-img',
                    style: image_styles
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'card-grid__card-img placeholder-svg motion-reduce' }}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank
              or block.settings.subheading != blank
              or block.settings.description != blank
            -%}
              <div class="card-grid__card-content card-grid__card-content--{{ block.settings.text_align }}">
                {%- if block.settings.heading != blank -%}
                  <span class="card-grid__card-heading h4">
                    {{ block.settings.heading }}
                  </span>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <span class="card-grid__card-subheading body-small">
                    {{ block.settings.subheading }}
                  </span>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="card-grid__card-description body-small">
                    {{ block.settings.description | truncate: 500 }}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
