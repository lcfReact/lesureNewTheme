<style>
  :root {
    --header-height: 50px;
  }
  @media screen and (min-width: 1100px) {
    :root {
      --header-height: 80px;
    }
  }

  @media screen and (min-width: 1100px) {
    header-drawer {
      display: none;
    }
  }

  burger-menu {
    position: relative;
  }

  .burger-menu {
    position: fixed;
    z-index: 1000;
    width: 100%;
    height: calc(100vh - (var(--ann-height)));
    height: calc(var(--vh, 1vh) * 100 - var(--ann-height));
    height: calc(100dvh - var(--ann-height));
    top: 0;
    left: 0;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    background-color: rgb(var(--color-background));
    transition: opacity 0.35s ease, visibility 0.35s ease;
    display: flex;
    overflow: hidden;
  }

  .burger-menu__button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    background: transparent;
    color: rgb(var(--color-foreground));
    transition: opacity var(--duration-default) ease-in-out;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .burger-menu__button svg {
    transition: color 0.4s cubic-bezier(0.602, 0.007, 0.374, 0.995);
  }

  @media screen and (hover: hover) and (pointer: fine) {
    .burger-menu__button:hover {
      opacity: var(--hover-opacity);
    }
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu__item {
    display: inline;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 1rem;
      padding-top: 1rem;
    }
  }

  {% if section.settings.sticky_header_type == "always" %}
    .shopify-section-header {
      position: sticky;
      top: 0;
    }
  {% endif %}

  .header__menu-item,
  .header__heading-link,
  .header__cart,
  .menu-drawer__utility-account-body,
  .menu-drawer__menu-item,
  .mobile-mega-menu__tab,
  .mega-menu__menu-list-link,
  .predictive-search__result-tab-title,
  .mega-menu-menu__heading,
  .mobile-mega-menu-menu__heading,
  .header__search-subtitle,
  .menu-drawer__search-and-account,
  .header__column .header__search-text,
  .header__column .header__localization-button,
  .header__account-text {
    font-family: var(--font-header-menu-family);
    font-style: var(--font-header-menu-style);
    font-weight: var(--font-header-menu-weight);
    font-size: calc(var(--font-header-menu-text-scale) * 1rem);
    text-transform: var(--font-header-menu-text-transform);
    letter-spacing: var(--font-header-menu-letter-spacing);
  }

  .header__account-text {
    text-rendering: geometricPrecision;
  }

  .mega-menu-menu__heading,
  .mobile-mega-menu-menu__heading,
  .header__search-subtitle {
    font-weight: bold;
  }

  #shopify-section-{{ section.id }} .header__heading-link {
    width: var(--logo-width-mobile, var(--logo-width));
  }
  #shopify-section-{{ section.id }} .header__heading-link::after {
    padding-bottom: var(--padding_bottom_mobile, var(--padding_bottom));
  }
  #shopify-section-{{ section.id }} .header__heading-logo {
    width: 100%;
    max-width: none;
    height: auto;
  }
  @media screen and (max-width: 1099px) {
    #shopify-section-{{ section.id }} .header__heading-logo--desktop {
      display: none;
    }
  }
  @media screen and (min-width: 1100px) {
    #shopify-section-{{ section.id }} .header__heading-link {
      width: var(--logo-width, var(--logo-width-mobile));
    }
    #shopify-section-{{ section.id }} .header__heading-link::after {
      padding-bottom: var(--padding_bottom, var(--padding_bottom_mobile));
    }
    #shopify-section-{{ section.id }} .header__heading-logo--mobile {
      display: none;
    }
  }

  #shopify-section-{{ section.id }} .header-wrapper,
  #shopify-section-{{ section.id }} .header {
    height: 50px;
    min-height: 50px;
    max-height: 50px;
  }
  #shopify-section-{{ section.id }} .header {
    align-items: center;
  }
  #shopify-section-{{ section.id }} .header__heading,
  #shopify-section-{{ section.id }} .header > .header__heading-link,
  #shopify-section-{{ section.id }} .header__heading-link {
    height: 34px;
    max-height: 34px;
  }
  #shopify-section-{{ section.id }} .header__heading-link::after {
    display: none;
  }
  #shopify-section-{{ section.id }} .header__heading-logo {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    height: auto;
    object-fit: contain;
  }
  @media screen and (min-width: 1100px) {
    #shopify-section-{{ section.id }} .header-wrapper,
    #shopify-section-{{ section.id }} .header {
      height: 80px;
      min-height: 80px;
      max-height: 80px;
    }
    #shopify-section-{{ section.id }} .header__heading,
    #shopify-section-{{ section.id }} .header > .header__heading-link,
    #shopify-section-{{ section.id }} .header__heading-link {
      height: 56px;
      max-height: 56px;
    }
  }

  {%- if section.settings.background_image != blank or section.settings.background_image_mobile != blank -%}
    {%- liquid
      assign header_bg_desktop = section.settings.background_image
      assign header_bg_mobile = section.settings.background_image_mobile
      if header_bg_desktop == blank
        assign header_bg_desktop = header_bg_mobile
      endif
      if header_bg_mobile == blank
        assign header_bg_mobile = header_bg_desktop
      endif

      assign header_bg_ratio = 0.041666
      assign header_bg_ratio_mobile = header_bg_ratio
      if header_bg_desktop.aspect_ratio > 0
        assign header_bg_ratio = 1.0 | divided_by: header_bg_desktop.aspect_ratio
      endif
      if header_bg_mobile.aspect_ratio > 0
        assign header_bg_ratio_mobile = 1.0 | divided_by: header_bg_mobile.aspect_ratio
      endif

      assign header_nav_color = ''
      if section.settings.text_color == blank and section.settings.icon_color == blank
        assign header_scheme = section.settings.color_scheme
        assign header_text_luma_r = header_scheme.settings.colors_text.red | times: 0.299
        assign header_text_luma_g = header_scheme.settings.colors_text.green | times: 0.587
        assign header_text_luma_b = header_scheme.settings.colors_text.blue | times: 0.114
        assign header_text_luma = header_text_luma_r | plus: header_text_luma_g | plus: header_text_luma_b
        if header_text_luma > 180
          assign header_bg_luma_r = header_scheme.settings.colors_background_1.red | times: 0.299
          assign header_bg_luma_g = header_scheme.settings.colors_background_1.green | times: 0.587
          assign header_bg_luma_b = header_scheme.settings.colors_background_1.blue | times: 0.114
          assign header_bg_luma = header_bg_luma_r | plus: header_bg_luma_g | plus: header_bg_luma_b
          if header_bg_luma < 180
            assign header_nav_color = header_scheme.settings.colors_background_1
          else
            assign header_nav_color = '#1a1a1a'
          endif
        endif
      endif
    -%}
    :root {
      --header-height: calc(100vw * {{ header_bg_ratio_mobile }});
    }
    @media screen and (min-width: 1100px) {
      :root {
        --header-height: calc(100vw * {{ header_bg_ratio }});
      }
    }

    #shopify-section-{{ section.id }} .header-wrapper,
    #shopify-section-{{ section.id }} .header {
      height: auto;
      min-height: 0;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .header-wrapper {
      background-image: none !important;
      background-attachment: scroll !important;
    }
    #shopify-section-{{ section.id }} .header-bg {
      display: block;
      line-height: 0;
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} .header-bg__img {
      display: block;
      width: 100%;
      height: auto;
      max-width: none;
    }
    #shopify-section-{{ section.id }} .header {
      position: absolute;
      inset: 0;
      z-index: 4;
      background: transparent !important;
    }
    #shopify-section-{{ section.id }} .header__heading,
    #shopify-section-{{ section.id }} .header > .header__heading-link,
    #shopify-section-{{ section.id }} .header__heading-link {
      height: auto;
      max-height: 62%;
    }

    {%- if header_nav_color != blank -%}
      #shopify-section-{{ section.id }} .header__menu-item,
      #shopify-section-{{ section.id }} .list-menu--inline .list-menu-item > .header__menu-item > span,
      #shopify-section-{{ section.id }} .header__icon,
      #shopify-section-{{ section.id }} .header__icon svg,
      #shopify-section-{{ section.id }} .header__icon-text,
      #shopify-section-{{ section.id }} .header__icon-name,
      #shopify-section-{{ section.id }} .header__account-text,
      #shopify-section-{{ section.id }} .header__search-text,
      #shopify-section-{{ section.id }} .header__localization-button,
      #shopify-section-{{ section.id }} .burger-menu__button {
        color: {{ header_nav_color }};
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.text_color != blank -%}
    #shopify-section-{{ section.id }} .header__menu-item,
    #shopify-section-{{ section.id }} .list-menu--inline .list-menu-item > .header__menu-item > span,
    #shopify-section-{{ section.id }} .header__heading-link,
    #shopify-section-{{ section.id }} .header__icon-text,
    #shopify-section-{{ section.id }} .header__icon-name,
    #shopify-section-{{ section.id }} .header__account-text,
    #shopify-section-{{ section.id }} .header__search-text,
    #shopify-section-{{ section.id }} .header__localization-button {
      color: {{ section.settings.text_color }};
    }
  {%- endif -%}

  {%- if section.settings.icon_color != blank -%}
    #shopify-section-{{ section.id }} .header__icon,
    #shopify-section-{{ section.id }} .header__icon svg,
    #shopify-section-{{ section.id }} .burger-menu__button {
      color: {{ section.settings.icon_color }};
    }
  {%- endif -%}
</style>

