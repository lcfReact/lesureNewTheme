{{ 'section-hero-split.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-split.js' | asset_url }}" defer="defer"></script>

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{% endstyle %}

{% liquid
  if section.settings.hero_split_mobile_image != blank
    assign mobile_image = section.settings.hero_split_mobile_image
  elsif section.settings.image != blank
    assign mobile_image = section.settings.hero_split_image
  else
    assign mobile_image = blank
  endif

  if section.settings.hero_split_image != blank
    assign desktop_image = section.settings.hero_split_image
  elsif section.settings.hero_split_mobile_image != blank
    assign desktop_image = section.settings.hero_split_mobile_image
  else
    assign desktop_image = blank
  endif

  if section.settings.image_ratio_mobile != 'adapt'
    assign aspect_ratio_mobile = section.settings.image_ratio_mobile | split: '/'
    assign temp = aspect_ratio_mobile[0] | append: '.0'
    assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp | times: 100 | round: 2 | append: '%'
  elsif section.settings.image_ratio_mobile == 'adapt'
    if section.settings.video != blank and section.settings.show_video
      assign padding_bottom_mobile = 1 | divided_by: section.settings.video.aspect_ratio | times: 100 | round: 2 | append: '%'
    elsif mobile_image != blank
      assign padding_bottom_mobile = 1 | divided_by: mobile_image.aspect_ratio | times: 100 | round: 2 | append: '%'
    else
      assign padding_bottom_mobile = '110%'
    endif
  else
    assign padding_bottom_mobile = 0
  endif

  if section.settings.image_ratio_desktop != 'adapt'
    assign aspect_ratio_desktop = section.settings.image_ratio_desktop | split: '/'
    assign temp = aspect_ratio_desktop[0] | append: '.0'
    assign padding_bottom_desktop = aspect_ratio_desktop[1] | divided_by: temp | times: 100 | round: 2 | append: '%'
  elsif section.settings.image_ratio_desktop == 'adapt'
    if section.settings.video != blank and section.settings.show_video
      assign padding_bottom_desktop = 1 | divided_by: section.settings.video.aspect_ratio | times: 100 | round: 2 | append: '%'
    elsif desktop_image != blank
      assign padding_bottom_desktop = 1 | divided_by: desktop_image.aspect_ratio | times: 100 | round: 2 | append: '%'
    else
      assign padding_bottom_desktop = '110%'
    endif
  else
    assign padding_bottom_desktop = 0
  endif
%}

{% style %}
  .section-{{ section.id }} .hero-split__media::before {
    content: "";
    display: block;
    width: 0;
    padding-bottom: {{ padding_bottom_mobile }};
  }

  @media screen and (min-width: 1100px) {
    .section-{{ section.id }} .hero-split__media::before {
      content: "";
      display: block;
      width: 0;
      padding-bottom: {{ padding_bottom_desktop }};
    }
  }
{% endstyle %}

{% if section.settings.enable_text_animation %}
  {% liquid
    assign heading_delay = 0
    if section.settings.show_label
      assign heading_delay = 0.1
    endif

    if section.settings.heading != blank
      assign heading_words = section.settings.heading | split: ' '
      assign words_delay = 0.1 | times: heading_words.size
    else
      assign words_delay = 0
    endif

    assign description_delay = heading_delay | plus: words_delay
    assign button_delay = description_delay | plus: 0.1
  %}
{% endif %}

<div class="section-{{ section.id }} hero-split{% if section.settings.show_border_top %} hero-split--border-top{% endif %}{% if section.settings.show_border_bottom %} hero-split--border-bottom{% endif %} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  <div class="container">
    <div class="hero-split__container{% if section.settings.show_button != true and section.settings.show_label != true and section.settings.heading == blank and section.settings.description == blank %} hero-split__container--without-content{% endif %}">
      <div
        class="hero-split-content hero-split-content--{{ section.settings.align_content }}"
        {% if section.settings.enable_text_animation %}
          data-enable-header-animation
          style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s; --button-delay: {{ button_delay }}s;"
        {% endif %}
      >
        {%- if section.settings.show_label -%}
          <div class="hero-split__label hero-split__label--{{ section.settings.label_border_radius }}">
            <div class="hero-split__label-icons">
              {% for icon in (1..section.settings.label_count) -%}
                <div class="hero-split__label-icon-wrapper">
                  {%- if section.settings.override_label_icon != blank -%}
                    {{
                      section.settings.override_label_icon
                      | image_url: width: section.settings.override_label_icon.width
                      | image_tag: class: 'hero-split__label-icon', loading: 'lazy', sizes: '20', widths: '20'
                    }}
                  {% else %}
                    {% render 'icon-star' %}
                  {%- endif -%}
                </div>
              {%- endfor %}
            </div>
            {%- if section.settings.label_text != blank -%}
              <span class="hero-split__label-text body-small">
                {{- section.settings.label_text | truncate: 53 -}}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }}
            id="hero-text"
            class="hero-split-heading {{ section.settings.heading_size }}"
          >
            {%- if section.settings.enable_text_animation -%}
              {%- assign lines = section.settings.heading | split: '\n' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading | newline_to_br -}}
            {%- endif -%}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="hero-split-description body-normal">
            {{- section.settings.description -}}
          </p>
        {%- endif -%}

        {%- if section.settings.show_button -%}
          <div class="hero-split-buttons">
            {% render 'button',
              btn_label: section.settings.button_label,
              btn_style: section.settings.button_style,
              btn_link: section.settings.button_link,
              class: 'hero-split__button'
            %}
          </div>
        {%- endif -%}
      </div>

      {% liquid
        assign has_block_image = false
        if section.settings.hero_split_image != blank or section.settings.hero_split_mobile_image != blank
          assign has_block_image = true
        endif

        if has_block_image
          if section.settings.hero_split_mobile_image != blank
            assign mobile_image = section.settings.hero_split_mobile_image
          else
            assign mobile_image = section.settings.hero_split_image
          endif

          if section.settings.hero_split_image != blank
            assign desktop_image = section.settings.hero_split_image
          else
            assign desktop_image = section.settings.hero_split_mobile_image
          endif
        endif
      %}

      <div class="hero-split__media">
        {% if section.settings.rotating_text != blank %}
          {% liquid
            assign rotating_text = section.settings.rotating_text | truncate: 20, ''
            assign char_count = rotating_text | size
            assign total_sum = 0
          %}

          {% for i in (1..char_count) %}
            {% assign total_sum = total_sum | plus: section.settings.rotating_text_letter_spacing %}
          {% endfor %}

          <div class="hero-split-rotating-text color-{{ section.settings.color_scheme_rotating_text }}">
            <svg viewBox="0 0 132 132">
              <defs>
              <path
                  id="circlePath"
                  d="
                  M 66,66
                  m -38, 0
                  a 38,38 0 1,1 76,0
                  a 38,38 0 1,1 -76,0"
                  transform="rotate(180,66,66)"
              />
              </defs>
              <text>
                  <textPath xlink:href="#circlePath" textLength="{{ total_sum }}">
                      {{ rotating_text }}
                  </textPath>
              </text>
            </svg>
          </div>
        {% endif %}
        {%- if section.settings.show_video == true and section.settings.video != blank -%}
          <div class="hero-split__video autoplay" data-video-id="{{ section.settings.video.id }}">
            {{
              section.settings.video
              | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false
            }}
          </div>
        {%- elsif has_block_image -%}
          {% liquid
            if section.settings.full_width
              assign max_image_desktop_width = '100vw'
            else
              assign max_image_desktop_width = '1280px'
            endif

            assign fetch_priority = 'auto'
            assign image_loading = 'lazy'

            if section.index == 1
              assign fetch_priority = 'high'
              assign image_loading = 'eager'
            endif

            assign one_image = false
            if section.settings.hero_split_image != blank and section.settings.hero_split_mobile_image == blank
              assign one_image = true
              assign section_image = section.settings.hero_split_image
            elsif section.settings.image == blank and section.settings.hero_split_mobile_image != blank
              assign one_image = true
              assign section_image = section.settings.hero_split_mobile_image
            endif

            assign widths = '550, 720, 990, 1200, 1500, 1800, 2200, 2600, 3000, 3200, 3600'
            assign widths_arr = widths | split: ', '

            # get mobile calc ratio
            if section.settings.image_ratio_mobile != 'adapt'
              assign aspect_ratio_mobile = section.settings.image_ratio_mobile | split: '/'
              assign temp = aspect_ratio_mobile[0] | append: '.0'
              assign settings_mobile_aspect_ratio = temp | divided_by: aspect_ratio_mobile[1] | round: 2
            else
              assign settings_mobile_aspect_ratio = mobile_image.aspect_ratio
            endif

            assign init_calc_ratio_mobile = 1
            if mobile_image.width > mobile_image.height
              assign init_calc_ratio_mobile = 1.4
            endif

            assign calc_ratio_mobile = init_calc_ratio_mobile
            if mobile_image.aspect_ratio > settings_mobile_aspect_ratio
              assign calc_ratio_mobile_temp = mobile_image.aspect_ratio | divided_by: settings_mobile_aspect_ratio | round: 2
              assign calc_ratio_mobile = calc_ratio_mobile_temp | times: init_calc_ratio_mobile | round: 2
            endif

            # get desktop calc ratio
            if section.settings.image_ratio_desktop != 'adapt'
              assign aspect_ratio_desktop = section.settings.image_ratio_desktop | split: '/'
              assign temp = aspect_ratio_desktop[0] | append: '.0'
              assign settings_desktop_aspect_ratio = temp | divided_by: aspect_ratio_desktop[1] | round: 2
              assign settings_tablet_aspect_ratio = temp | divided_by: aspect_ratio_desktop[1] | round: 2
            else
              assign settings_tablet_aspect_ratio = desktop_image.aspect_ratio
              assign settings_desktop_aspect_ratio = desktop_image.aspect_ratio
            endif

            assign calc_ratio_tablet = 1
            if desktop_image.aspect_ratio > settings_tablet_aspect_ratio
              assign calc_ratio_tablet = desktop_image.aspect_ratio | divided_by: settings_tablet_aspect_ratio | round: 2
            endif

            assign calc_ratio_desktop = 1
            if desktop_image.aspect_ratio > settings_desktop_aspect_ratio
              assign calc_ratio_desktop = desktop_image.aspect_ratio | divided_by: settings_desktop_aspect_ratio | round: 2
            endif
          %}

          {%- capture sizes -%}
                (min-width: 1440px) calc({{ calc_ratio_desktop }} * {{ max_image_desktop_width }}), (min-width: 990px) calc({{ calc_ratio_desktop }} * 100vw), (min-width: 576px) calc({{ calc_ratio_tablet }} * 100vw), calc({{ calc_ratio_mobile }} * 100vw)
                {%- endcapture -%}
          {%- if one_image -%}
            {%- capture style -%}
                    object-position: {{ section_image.presentation.focal_point }};
                {%- endcapture -%}
            {{
              section_image
              | image_url: width: section_image.width
              | image_tag:
                class: 'hero-split__image',
                loading: image_loading,
                sizes: sizes,
                widths: widths,
                style: style,
                fetchpriority: fetch_priority
            }}
          {%- else -%}
            <picture>
              <source
                srcset="{% for width in widths_arr %}{{ section.settings.hero_split_mobile_image | image_url: width: width }} {{ width }}w{% if forloop.last == false %}, {% endif %}{% endfor %}"
                media="(max-width: 575px)"
                sizes="{{ sizes }}"
              >
              <source
                srcset="{% for width in widths_arr %}{{ section.settings.hero_split_image | image_url: width: width }} {{ width }}w{% if forloop.last == false %}, {% endif %}{% endfor %}"
                media="(min-width: 576px)"
                sizes="{{ sizes }}"
              >
              <img
                src="{{ section.settings.hero_split_image | image_url: width: section.settings.hero_split_image.width }}"
                alt="{{ section.settings.hero_split_image.alt }}"
                width="{{ section.settings.hero_split_image.width }}"
                height="{{ section.settings.hero_split_image.height }}"
                sizes="{{ sizes }}"
                class="hero-split__image"
                loading="{{ image_loading }}"
                fetchpriority="{{ fetch_priority }}"
                style="--focal_point_desktop: {{ section.settings.hero_split_image.presentation.focal_point }}; --focal_point_mobile: {{ section.settings.mobile_image.presentation.focal_point }};"
              >
            </picture>
          {%- endif -%}
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hero-split__image placeholder-svg--filled' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero-split.name",
  "tag": "section",
  "class": "section-hero-split",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero-split.settings.header_main.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "default": false,
      "label": "t:sections.hero-split.settings.show_border_top.label"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "default": false,
      "label": "t:sections.hero-split.settings.show_border_bottom.label"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.aspect_ratio.options__1.label"
        },
        {
          "value": "2/1",
          "label": "t:sections.all.aspect_ratio.options__10.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.aspect_ratio.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.aspect_ratio.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.aspect_ratio.options__4.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.aspect_ratio.options__7.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.aspect_ratio.options__8.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.hero-split.settings.aspect_ratio.options__6.label"
        }
      ],
      "default": "4/5",
      "label": "t:sections.hero-split.settings.aspect_ratio.label_desktop"
    },
    {
      "type": "image_picker",
      "id": "hero_split_image",
      "label": "t:sections.hero-split.settings.hero_split_image.label"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.aspect_ratio.options__1.label"
        },
        {
          "value": "2/1",
          "label": "t:sections.all.aspect_ratio.options__10.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.aspect_ratio.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.aspect_ratio.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.aspect_ratio.options__4.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.aspect_ratio.options__7.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.aspect_ratio.options__8.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.hero-split.settings.aspect_ratio.options__6.label"
        }
      ],
      "default": "4/5",
      "label": "t:sections.hero-split.settings.aspect_ratio.label_mobile"
    },
    {
      "type": "image_picker",
      "id": "hero_split_mobile_image",
      "label": "t:sections.hero-split.settings.hero_split_mobile_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "t:sections.all.video.show_video.label",
      "info": "t:sections.all.video.show_video.info",
      "default": false
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.all.video.video.label"
    },
    {
      "type": "select",
      "id": "align_content",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.all.text_align.options__4.label"
        },
        {
          "value": "left",
          "label": "t:sections.all.text_align.options__1.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.all.text_align.options__5.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.all.text_align.options__6.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_align.options__2.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.all.text_align.options__7.label"
        }
      ],
      "default": "top-left",
      "info": "t:sections.hero-split.settings.align_content.info",
      "label": "t:sections.hero-split.settings.align_content.label"
    },
    {
      "type": "header",
      "content": "t:sections.hero-split.settings.header_rotating_text.content"
    },
    {
      "type": "text",
      "id": "rotating_text",
      "label": "t:sections.hero-split.settings.rotating_text.label",
      "info": "t:sections.hero-split.settings.rotating_text.info",
      "default": "t:sections.hero-split.settings.rotating_text.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_rotating_text",
      "default": "background-1",
      "label": "t:sections.hero-split.settings.color_scheme_rotating_text.label"
    },
    {
      "type": "range",
      "id": "rotating_text_letter_spacing",
      "min": 10,
      "max": 20,
      "step": 0.2,
      "label": "t:sections.hero-split.settings.rotating_text_letter_spacing.label",
      "default": 10.8
    },
    {
      "type": "header",
      "content": "t:sections.hero-split.settings.header_content.content"
    },
    {
      "type": "checkbox",
      "id": "enable_text_animation",
      "label": "t:sections.hero-split.settings.enable_text_animation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "default": true,
      "label": "t:sections.hero-split.settings.show_label.label"
    },
    {
      "type": "select",
      "id": "label_border_radius",
      "options": [
        {
          "value": "sharp",
          "label": "t:sections.hero-split.settings.label_border_radius.sharp.label"
        },
        {
          "value": "rounded",
          "label": "t:sections.hero-split.settings.label_border_radius.rounded.label"
        },
        {
          "value": "pill",
          "label": "t:sections.hero-split.settings.label_border_radius.pill.label"
        }
      ],
      "default": "pill",
      "label": "t:sections.hero-split.settings.label_border_radius.label",
      "visible_if": "{{ section.settings.show_label }}"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "t:sections.hero-split.settings.label_text.label",
      "default": "t:sections.hero-split.settings.label_text.default",
      "info": "t:sections.hero-split.settings.label_text.info",
      "visible_if": "{{ section.settings.show_label }}"
    },
    {
      "type": "image_picker",
      "id": "override_label_icon",
      "label": "t:sections.hero-split.settings.override_label_icon.label",
      "visible_if": "{{ section.settings.show_label }}"
    },
    {
      "type": "range",
      "id": "label_count",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "t:sections.hero-split.settings.label_count.label",
      "default": 5,
      "visible_if": "{{ section.settings.show_label }}"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.hero-split.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        },
        {
          "value": "p",
          "label": "t:sections.all.heading_tag.options__8.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.text.label",
      "default": "t:sections.hero-split.settings.description.default"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": true,
      "label": "t:sections.all.button.button_show.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
