{{ 'section-collections-list.css' | asset_url | stylesheet_tag }}
{{ 'component-collection-card.css' | asset_url | stylesheet_tag }}

{%- if settings.pagination_type == 'load_more' or settings.pagination_type == 'infinite_scroll' -%}
  <script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{% endstyle %}

{%- style -%}
  .collections-list-grid {
    --column-gap: {{ section.settings.collections_column_gap }}rem;
  }
{%- endstyle -%}

<div class="container collections-list color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank or section.settings.description != blank -%}
    <div class="collections-list-header collections-list-header--alignment-{{ section.settings.text_align }}">
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_level }} class="collections-list__title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </{{ section.settings.heading_level }}>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="collections-list__description body-normal">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {% if collections.size > 0 %}
    {%- liquid
      case section.settings.sort
        when 'products_high', 'products_low'
          assign collections = collections | sort: 'all_products_count'
        when 'date', 'date_reversed'
          assign collections = collections | sort: 'published_at'
        when 'alphabetical', 'alphabetical_reversed'
          assign collections = collections | sort: 'title'
      endcase

      if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
        assign collections = collections | reverse
      endif

      assign paginate_by = section.settings.collections_column_count | times: 3
    -%}

    {%- paginate collections by paginate_by -%}
      {%- if paginate.current_page == 1 -%}
        {% assign items_first = 1 %}
      {%- else -%}
        {% assign items_first = paginate.current_page | times: paginate_by | minus: paginate_by | plus: 1 %}
      {%- endif -%}
      {% assign items_last = paginate.current_page | times: paginate_by %}

      <ul
        class="collections-list-grid collections-list-grid--{{ section.settings.collections_column_count }} load-more-grid content"
        role="list"
      >
        {% liquid
          assign button_label = 'sections.collections_list.button_label' | t
        %}

        {%- for collection in collections -%}
          {%- if forloop.index >= items_first and forloop.index <= items_last -%}
            <li>
              {% render 'collection-card',
                card_type: section.settings.card_type,
                card_collection: collection,
                card_color_scheme: section.settings.card_color_scheme,
                card_title: collection.title,
                card_title_size: section.settings.collections_titles_size,
                card_link: collection.url,
                image_ratio: section.settings.aspect_ratio,
                image_fit: section.settings.object_fit,
                columns_count: section.settings.collections_column_count,
                card_button_label: button_label
              %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {%- if settings.pagination_type == 'load_more' -%}
          {% render 'load-more',
            next_url: paginate.next.url,
            count_pages: paginate.pages,
            current_page: paginate.current_page
          %}
          <div class="js-hidden">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- elsif settings.pagination_type == 'infinite_scroll' -%}
          {% render 'infinite-scroll',
            next_url: paginate.next.url,
            count_pages: paginate.pages,
            current_page: paginate.current_page
          %}
          <div class="js-hidden">
            {% render 'pagination', paginate: paginate %}
          </div>
        {% else %}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {% else %}
    {% liquid
      assign no_collections_text = 'sections.collections_list.no_collections' | t
    %}
    <div class="collections-list-no-collections body-xl">
      {{ no_collections_text }}
    </div>
  {% endif %}
</div>

