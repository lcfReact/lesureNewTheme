{{ 'section-collections-list.css' | asset_url | stylesheet_tag }}
{{ 'component-collection-card.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-margin' %}

  #shopify-section-{{ section.id }} .collections-list {
    --scene-heading: {{ section.settings.heading_color }};
    --scene-heading-size: {{ section.settings.heading_font_size }}px;
    --scene-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --scene-heading-gap: {{ section.settings.heading_gap }}px;
    --scene-heading-gap-mobile: {{ section.settings.heading_gap_mobile }}px;
    --scene-button: {{ section.settings.button_color }};
    --scene-button-text: {{ section.settings.button_text_color }};
    --scene-radius: {{ section.settings.card_radius }}px;
    --column-gap: {{ section.settings.card_gap_mobile }}px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .collections-list {
      --column-gap: {{ section.settings.card_gap }}px;
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}

{% liquid
  assign enable_animation = false

  if section.settings.animate_section_header_on_scroll
    if section.settings.heading != blank or section.settings.description != blank
      assign enable_animation = true
    endif
  endif

  assign heading_delay = 0

  assign heading_words = section.settings.heading | split: ' '
  assign words_delay = 0.1 | times: heading_words.size

  assign description_delay = heading_delay | plus: words_delay
%}

{%- if enable_animation -%}
  <script src="{{ 'collections-list.js' | asset_url }}" defer="defer"></script>

  {% style %}
    #shopify-section-{{ section.id }} [data-enable-header-animation] .collections-list__title .word {
      opacity: 0;
      transform: translateY(20px);
      display: inline-block;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} [data-enable-header-animation] .collections-list__description {
      opacity: 0;
      transform: translateY(20px);
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .collections-list__title .word {
      animation: fadeInWord 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: calc(var(--heading-delay) + (var(--word-index) * 0.1s));
    }

    #shopify-section-{{ section.id }}.anim-active [data-enable-header-animation] .collections-list__description {
      animation: fadeInUp 0.4s cubic-bezier(0.5, 0, 0, 1) forwards;
      animation-delay: var(--description-delay);
    }
  {% endstyle %}
{%- endif -%}

<div
  class="collections-list color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  {% if enable_animation %}
    data-enable-header-animation="true"
    style="--heading-delay: {{ heading_delay }}s; --description-delay: {{ description_delay }}s;"
  {% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="collections-list-header collections-list-header--alignment-{{ section.settings.text_align }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_level }} class="collections-list__title {{ section.settings.heading_size }}">
            {%- if enable_animation == true -%}
              {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
              {%- assign word_idx = 0 -%}
              {%- for line in lines -%}
                {%- assign words = line | split: ' ' -%}
                {%- for word in words -%}
                  {%- if word != '' -%}
                    <span class="word" style="--word-index: {{ word_idx }}">{{ word }}</span>
                    {%- unless forloop.last %}&#32;{% endunless -%}
                    {%- assign word_idx = word_idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last %}<br>{% endunless -%}
              {%- endfor -%}
            {%- else -%}
              {{- section.settings.heading -}}
            {%- endif -%}
          </{{ section.settings.heading_level }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="collections-list__description body-normal">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="collections-list-grid collections-list-grid--{{ section.settings.collections_column_count }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            case block.settings.image_position
              when 'top'
                assign scene_image_position = 'center top'
              when 'bottom'
                assign scene_image_position = 'center bottom'
              when 'left'
                assign scene_image_position = 'left center'
              when 'right'
                assign scene_image_position = 'right center'
              else
                assign scene_image_position = 'center center'
            endcase
          -%}
          {%- if block.settings.collection != blank or block.settings.image != blank -%}
            {% render 'collection-card',
              card_type: section.settings.card_type,
              card_collection: block.settings.collection,
              card_color_scheme: section.settings.card_color_scheme,
              card_title: block.settings.title,
              card_title_size: section.settings.collections_titles_size,
              card_link: block.settings.card_url,
              card_button_label: block.settings.button_label,
              image_ratio: section.settings.aspect_ratio,
              image_fit: 'cover',
              image_position: scene_image_position,
              overwrite_image: block.settings.image,
              columns_count: section.settings.collections_column_count,
              block_shopify_attributes: block.shopify_attributes
            %}
          {%- else -%}
            {% liquid
              assign placeholder_index = forloop.index0 | modulo: 3 | plus: 1
            %}
            {% render 'collection-card-placeholder',
              card_type: section.settings.card_type,
              card_color_scheme: section.settings.card_color_scheme,
              card_title_size: section.settings.collections_titles_size,
              image_ratio: section.settings.aspect_ratio,
              card_index: placeholder_index,
              block_shopify_attributes: block.shopify_attributes
            %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

