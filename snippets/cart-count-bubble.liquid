{% render 'icon-cart' %}
<span class="header__cart-text header__icon-text">
  {{ 'general.cart.name' | t }} ({{ cart.item_count }})
</span>

{% if cart.item_count != 0 %}
  <span class="visually-hidden">{{ 'general.cart.view' | t }}</span>
  <div class="cart-count-bubble">
    <span class="visually-hidden">{{- 'sections.header.cart_count' | t: count: cart.item_count -}}</span>
  </div>
{% endif %}