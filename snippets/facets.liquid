{% comment %}
  	Renders facets (filtering and sorting)

  	Accepts:
  	- results: {Object} Collection or Search object
  	- enable_filtering: {Boolean} Show filtering when true
  	- enable_sorting: {Boolean} Show sorting when true
    - color_scheme: {String} Color scheme,
    - header_color_scheme: {String} Header color scheme

  	Usage:
  {% render 'facets', results: collection, enable_filtering: true, enable_sorting: true %}
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0
  assign default_presentation = 'text'
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}

{%- if filter_type == 'sidebar' -%}
  {% style %}
    .facets__wrapper--sidebar {
      pointer-events: none;
      visibility: hidden;
      opacity: 0;
    }

    .facets__wrapper--sidebar.active {
      pointer-events: all;
      visibility: visible;
      opacity: 1;
    }
  {% endstyle %}
{%- endif -%}

<div
  class="
    facets-container
    {% if enable_filtering == false %} facets-container_no-filter {% endif %}
    facets-container--{{ filter_type }}
  "
>
  <facet-filters-form
    class="facets facets--desktop small-hide"
    facets-desktop-type="{{ filter_type }}"
  >
    <form id="FacetFiltersForm" class="facets__form facets__form--{{ filter_type }}">
      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}

      {% if enable_filtering %}
        <div
          id="FacetsWrapperDesktop"
          class="facets__wrapper facets__wrapper--{{ filter_type }}{% if enable_default_open and filter_type == "vertical" %} active animate{% endif %}"
          {% if filter_type == 'sidebar' %}
            role="dialog"
            aria-modal="true"
            tabindex="-1"
          {% endif %}
        >
          <div class="facets__inner facets__inner--{{ filter_type }}{% if filter_type == 'sidebar' %} color-{{ color_scheme }}{% endif %}">
            <div class="facets__inner-container">
              {% if filter_type == 'sidebar' %}
                <div class="facets__inner-top color-{{ header_color_scheme }} no-js-hidden">
                  <div class="facets__inner-label">
                    {% render 'icon-filter' %}
                    <span class="facets__inner-label-text body-xl">{{ 'products.facets.filter_by' | t }}</span>
                  </div>
                  <button
                    type="button"
                    class="facets__close focus-inset"
                    aria-label="{{ 'accessibility.close' | t }}"
                    data-facets-close="true"
                  >
                    {% render 'icon-modal-close' %}
                  </button>
                </div>
              {% endif %}
              <div class="facets__inner-filters">
                {%- for filter in results.filters -%}
                  {% liquid
                    assign presentation = filter.presentation | default: default_presentation
                  %}
                  {%- assign total_active_values = total_active_values | plus: filter.active_values.size -%}
                  {% case filter.type %}
                    {% when 'boolean', 'list' %}
                      {% liquid
                        assign is_color_filter = false

                        # for metafields color
                        for value in filter.values
                          if settings.enable_color_swatch and presentation == 'swatch' and value.swatch.color != blank
                            assign is_color_filter = true
                          endif
                        endfor

                        # for custom option color
                        assign color_trigger = settings.trigger_swatch | strip | newline_to_br | split: '<br />'
                        assign name_filter = filter.label | handle | strip
                        for item in color_trigger
                          assign item_temp = item | handle | strip
                          if settings.enable_color_swatch and name_filter == item_temp
                            assign is_color_filter = true
                          endif
                        endfor
                      %}
                      <details
                        id="Details-{{ forloop.index }}-{{ section.id }}"
                        class="disclosure-has-popup facets__disclosure js-filter"
                        data-index="{{ forloop.index }}"
                        open
                      >
                        <summary class="facets__summary focus-inset">
                          <span class="facets__summary-title body-normal">
                            {{ filter.label | escape }}
                          </span>
                          <facet-remove>
                            <a href="{{ filter.url_to_remove }}" class="facets__reset body-xs">
                              {{ 'products.facets.reset' | t }}
                            </a>
                          </facet-remove>

                          <div class="facets__summary-icon">
                            {% render 'icon-caret' %}
                          </div>
                        </summary>
                        <div id="Facet-{{ forloop.index }}-{{ section.id }}" class="facets__display">
                          <ul
                            class="facets__list list-unstyled{% if is_color_filter %} facets__list--color{% elsif presentation == 'image' %} facets__list--image{% endif %}"
                            role="list"
                            style="--image_filter_columns: {{ image_filter_columns }};"
                          >
                            {%- for value in filter.values -%}
                              {% liquid
                                if is_color_filter
                                  if presentation == 'swatch'
                                    assign swatch = value.swatch
                                    assign init_color_value = value.label | handle | strip
                                    if swatch.image != blank
                                      assign color_image = swatch.image | image_url: width: 60
                                      assign color_value = 'url(' | append: color_image | append: ') no-repeat center/cover'
                                    elsif swatch.color != blank
                                      assign color_value = 'rgb(' | append: swatch.color.rgb | append: ')'
                                    endif
                                  else
                                    assign init_color_value = value.value | handle | strip
                                    assign color_value = init_color_value | remove: '-'
                                  endif

                                  # overwrite from custom colors textarea
                                  if settings.custom_colors != blank
                                    assign custom_colors_string = settings.custom_colors | strip
                                    assign custom_colors_obj = custom_colors_string | newline_to_br | split: '<br />'

                                    for obj in custom_colors_obj
                                      assign obj_strip = obj | strip
                                      assign obj_key = obj_strip | split: ':' | first
                                      assign obj_value = obj_strip | split: ':' | last
                                      assign obj_color_name = obj_key | handle | strip

                                      if init_color_value == obj_color_name
                                        assign obj_color_value = obj_value | strip
                                        if obj_color_value contains 'gradient'
                                          assign color_value = obj_color_value
                                        else
                                          assign color_value = obj_color_value | remove: '-'
                                        endif
                                        break
                                      endif
                                    endfor
                                  endif
                                endif
                              %}

                              <li
                                class="facets__item{% if is_color_filter %} facets__item--color{% elsif presentation == 'image' %} facets__item--image{% endif %}"
                                {% if is_color_filter %}
                                  style="--border-radius: {{ settings.swatch_border_radius }}px; --swatch-color: {{ color_value }};"
                                {% endif %}
                              >
                                <input
                                  type="checkbox"
                                  class="focus-inset"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  id="Filter-{{ filter.label | escape }}-{{ forloop.index }}"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                  {% if value.count == 0 and value.active == false %}
                                    disabled
                                  {% endif %}
                                >
                                <label
                                  for="Filter-{{ filter.label | escape }}-{{ forloop.index }}"
                                  class="facet-checkbox{% if value.count == 0 and value.active == false %} facet-checkbox--disabled{% endif %}{% if is_color_filter %} facet-checkbox--color{% elsif presentation == 'image' %} facet-checkbox--image{% endif %}"
                                  {% if is_color_filter %}
                                    title="{{ value.label | escape }}"
                                  {% endif %}
                                >
                                  {%- if presentation == 'image' -%}
                                    <div
                                      class="facets__image-wrapper"
                                      style="--image_filter_ratio: {{ image_filter_ratio }}; --image_filter_fit: {{ image_filter_fit }};"
                                    >
                                      {% liquid
                                        if image_filter_ratio == '3/4'
                                          assign settings_aspect_ratio = 0.75
                                        elsif block.settings.aspect_ratio == '3/2'
                                          assign settings_aspect_ratio = 1.5
                                        else
                                          assign settings_aspect_ratio = 1
                                        endif

                                        assign calc_ratio = 1.1

                                        if value.image.aspect_ratio > settings_aspect_ratio
                                          assign calc_ratio = value.image.aspect_ratio | divided_by: settings_aspect_ratio | round: 2
                                        endif

                                        if image_filter_fit == 'contain'
                                          assign calc_ratio = 1
                                        endif
                                      %}
                                      {%- capture sizes -%}
                                        {%- if image_filter_columns == 1 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 568px), (min-width: 990px) calc({{ calc_ratio }} * 584px), (min-width: 750px) calc({{ calc_ratio }} * 95vw), (min-width: 576px) calc({{ calc_ratio }} * 95vw), calc({{ calc_ratio }} * 95vw)
                                        {%- elsif image_filter_columns == 2 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 278px), (min-width: 990px) calc({{ calc_ratio }} * 286px), (min-width: 750px) calc({{ calc_ratio }} * 49vw), (min-width: 576px) calc({{ calc_ratio }} * 48vw), calc({{ calc_ratio }} * 49vw)
                                        {%- elsif image_filter_columns == 3 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 182px), (min-width: 990px) calc({{ calc_ratio }} * 187px), (min-width: 750px) calc({{ calc_ratio }} * 33vw), (min-width: 576px) calc({{ calc_ratio }} * 32vw), calc({{ calc_ratio }} * 33vw)
                                        {%- elsif image_filter_columns == 4 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 133px), (min-width: 990px) calc({{ calc_ratio }} * 137px), (min-width: 750px) calc({{ calc_ratio }} * 25vw), (min-width: 576px) calc({{ calc_ratio }} * 24vw), calc({{ calc_ratio }} * 24vw)
                                        {%- endif -%}
                                      {%- endcapture -%}
                                      {%- if value.image -%}
                                        {{
                                          value.image
                                          | image_url: width: value.image.width
                                          | image_tag:
                                            class: 'facets__image',
                                            alt: value.alt,
                                            widths: '100, 140, 160, 180, 200, 220, 278, 296, 350, 400, 450, 568, 750, 800, 912, 1100, 1800',
                                            sizes: sizes,
                                            loading: 'lazy',
                                            fetchpriority: 'low'
                                        }}
                                      {%- endif -%}
                                    </div>
                                  {%- else -%}
                                    <span class="facet-checkbox__checkbox">
                                      {% render 'icon-checkmark' %}
                                    </span>
                                  {%- endif -%}
                                  <span class="facet-checkbox__label body-normal{% if is_color_filter %} visually-hidden{% endif %}">
                                    {{- value.label | escape }} ({{ value.count -}}
                                    )
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </details>
                    {% when 'price_range' %}
                      {% if filter.range_max != 0 %}
                        <details
                          id="Details-{{ forloop.index }}-{{ section.id }}"
                          class="disclosure-has-popup facets__disclosure facets__disclosure-price js-filter"
                          data-index="{{ forloop.index }}"
                          open
                        >
                          <summary class="facets__summary">
                            <span class="facets__summary-title body-normal">
                              {{ filter.label | escape }}
                            </span>
                            <facet-remove>
                              <a href="{{ filter.url_to_remove }}" class="facets__reset body-xs">
                                {{ 'products.facets.reset' | t }}
                              </a>
                            </facet-remove>
                            <div class="facets__summary-icon">
                              {% render 'icon-caret' %}
                            </div>
                          </summary>
                          <div id="Facet-{{ forloop.index }}-{{ section.id }}" class="facets__display">
                            <price-range class="facets__price">
                              {% liquid
                                assign min_value = filter.min_value.value | default: 0.0 | divided_by: 100.0
                                assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
                                assign filter_range_max = filter.range_max | divided_by: 100.0 | ceil
                                assign range_min = min_value | divided_by: filter_range_max | times: 100.0
                                assign range_max = max_value | divided_by: filter_range_max | times: 100.0
                              %}

                              <div class="facets__price-wrapper">
                                <div class="field">
                                  <label
                                    class="field__label body-normal"
                                    for="Filter-{{ filter.label | escape }}-GTE"
                                  >
                                    {{- 'products.facets.from' | t -}}
                                  </label>
                                  <div class="field__input-wrapper">
                                    <span class="field__currency">{{ cart.currency.symbol }}</span>
                                    <input
                                      dir="ltr"
                                      class="field__input"
                                      name="{{ filter.min_value.param_name }}"
                                      id="Filter-{{ filter.label | escape }}-GTE"
                                      {%- if filter.min_value.value -%}
                                        value="{{ min_value | ceil }}"
                                      {%- endif -%}
                                      type="number"
                                      placeholder="0"
                                      inputmode="numeric"
                                      step="1"
                                      min="0"
                                      max="{{ max_value | ceil }}"
                                      autocomplete="off"
                                      tabindex="0"
                                    >
                                  </div>
                                </div>

                                <div class="field">
                                  <label
                                    class="field__label body-normal"
                                    for="Filter-{{ filter.label | escape }}-LTE"
                                  >
                                    {{- 'products.facets.to' | t -}}
                                  </label>
                                  <div class="field__input-wrapper">
                                    <span class="field__currency">{{ cart.currency.symbol }}</span>
                                    <input
                                      dir="ltr"
                                      class="field__input"
                                      name="{{ filter.max_value.param_name }}"
                                      id="Filter-{{ filter.label | escape }}-LTE"
                                      {%- if filter.max_value.value -%}
                                        value="{{ max_value | ceil }}"
                                      {%- endif -%}
                                      type="number"
                                      inputmode="numeric"
                                      step="1"
                                      min="0"
                                      max="{{ filter_range_max | ceil }}"
                                      placeholder="{{ filter_range_max | ceil }}"
                                      tabindex="0"
                                    >
                                  </div>
                                </div>
                              </div>

                              <div
                                class="facets__range no-js-hidden"
                                style="--range-min: {{ range_min }}%; --range-max: {{ range_max }}%"
                              >
                                <label class="visually-hidden" for="Filter-{{ filter.label | escape }}-Min">
                                  {{- 'products.facets.from' | t -}}
                                </label>
                                <input
                                  dir="ltr"
                                  type="range"
                                  value="{{ min_value | ceil }}"
                                  min="0"
                                  max="{{ filter_range_max | ceil }}"
                                  step="1"
                                  class="field__range"
                                  id="Filter-{{ filter.label | escape }}-Min"
                                >
                                <label class="visually-hidden" for="Filter-{{ filter.label | escape }}-Max">
                                  {{- 'products.facets.to' | t -}}
                                </label>
                                <input
                                  dir="ltr"
                                  type="range"
                                  value="{{ max_value | ceil }}"
                                  min="0"
                                  max="{{ filter_range_max | ceil }}"
                                  step="1"
                                  class="field__range"
                                  id="Filter-{{ filter.label | escape }}-Max"
                                >
                              </div>
                            </price-range>
                          </div>
                        </details>
                      {% endif %}
                  {% endcase %}
                {%- endfor -%}
              </div>
              <div class="facets__inner-bottom">
                <button type="submit" class="facets__button facets__submit button button--primary">
                  <div class="button__content">
                    <span class="button__label" data-label="{{ 'products.facets.filter_button' | t }}">
                      {{- 'products.facets.filter_button' | t -}}
                    </span>
                  </div>
                  <span class="animated-button-circle"></span>
                </button>
                <facet-remove>
                  <a href="{{ results_url }}" class="active-facets__button-remove button button--transparent">
                    <div class="button__content">
                      <span class="button__label" data-label="{{ 'products.facets.clear_all' | t }}">
                        {{- 'products.facets.clear_all' | t -}}
                      </span>
                    </div>
                    <span class="animated-button-circle"></span>
                  </a>
                </facet-remove>
              </div>
            </div>
          </div>
          {%- if filter_type == 'sidebar' -%}
            <button
              type="button"
              class="facets__close-btn"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {% render 'icon-modal-close' %}
            </button>
            <div class="facets__overlay no-js-hidden"></div>
          {%- endif -%}
        </div>
      {% endif %}

      {% if results.current_vendor or results.current_type %}
        <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
      {% endif %}
    </form>
  </facet-filters-form>

  <menu-drawer class="mobile-facets__wrapper" data-breakpoint="mobile">
    <details class="disclosure-has-popup medium-hide large-up-hide">
      <summary>
        <div class="mobile-facets__open button button--primary focus-inset">
          {% liquid
            if enable_filtering and enable_sorting
              assign button_label = 'products.facets.filter_and_sort' | t
            elsif enable_filtering
              assign button_label = 'products.facets.filter' | t
            elsif enable_sorting
              assign button_label = 'products.facets.sort_button' | t
            endif
          %}
          <div class="button__icons">
            <span class="button__icon button__icon--1">
              {% render 'icon-filter' %}
            </span>
            <span class="button__icon button__icon--2">
              {% render 'icon-filter' %}
            </span>
          </div>
          <div class="button__content">
            <span class="button__label" data-label="{{- button_label -}}">
              {{- button_label -}}
            </span>
            <div class="count-bubble">
              {%- if total_active_values > 0 -%}{{ total_active_values }}{%- endif -%}
            </div>
          </div>
          <div class="animated-button-circle"></div>
        </div>
      </summary>
      <facet-filters-form>
        <form id="FacetFiltersFormMobile" class="mobile-facets">
          <div class="mobile-facets__inner color-{{ color_scheme }}">
            <div class="mobile-facets__header color-{{ header_color_scheme }}">
              <span class="mobile-facets__heading body-xl">
                {%- if enable_filtering and enable_sorting -%}
                  {{ 'products.facets.filter_and_sort' | t }}
                {%- elsif enable_filtering -%}
                  {{ 'products.facets.filter' | t }}
                {%- elsif enable_sorting -%}
                  {{ 'products.facets.sort_button' | t }}
                {%- endif -%}
              </span>
              <button
                type="button"
                class="mobile-facets__close mobile-facets__close--no-js focus-inset color-{{ header_color_scheme }}"
              >
                {% render 'icon-modal-close' %}
              </button>
            </div>
            <div class="mobile-facets__main">
              {% if enable_filtering %}
                {%- for filter in results.filters -%}
                  {% liquid
                    assign presentation = filter.presentation | default: default_presentation
                  %}
                  {% case filter.type %}
                    {% when 'boolean', 'list' %}
                      {% liquid
                        assign is_color_filter = false

                        # for metafields color
                        for value in filter.values
                          if settings.enable_color_swatch and presentation == 'swatch' and value.swatch.color != blank
                            assign is_color_filter = true
                          endif
                        endfor

                        # for custom option color
                        assign color_trigger = settings.trigger_swatch | strip | newline_to_br | split: '<br />'
                        assign name_filter = filter.label | handle | strip
                        for item in color_trigger
                          assign item_temp = item | handle | strip
                          if settings.enable_color_swatch and name_filter == item_temp
                            assign is_color_filter = true
                          endif
                        endfor
                      %}
                      <details
                        id="Details-Mobile-{{ forloop.index }}-{{ section.id }}"
                        class="mobile-facets__details js-filter"
                        data-index="mobile-{{ forloop.index }}"
                      >
                        <summary
                          class="mobile-facets__summary"
                        >
                          <span class="mobile-facets__filter-label body-normal">{{ filter.label | escape }}</span>
                          <span class="mobile-facets__arrow">{% render 'icon-caret' %}</span>
                        </summary>
                        <div id="FacetMobile-{{ forloop.index }}-{{ section.id }}" class="mobile-facets__submenu">
                          <button
                            class="mobile-facets__close-button focus-inset no-js-hidden"
                            aria-expanded="true"
                            type="button"
                          >
                            <div class="mobile-facets__close-button-icon">
                              {% render 'icon-caret' %}
                            </div>
                            <span class="mobile-facets__close-button-label body-normal">
                              {{ filter.label | escape }}
                            </span>
                          </button>
                          <ul
                            class="
                              mobile-facets__list list-unstyled
                              {% if is_color_filter -%} mobile-facets__list--color
                              {% elsif presentation == 'image' %} mobile-facets__list--image {%- endif -%}
                            "
                            role="list"
                            style="--image_filter_columns: {{ image_filter_columns }};"
                          >
                            {%- for value in filter.values -%}
                              {% liquid
                                if is_color_filter
                                  if presentation == 'swatch'
                                    assign swatch = value.swatch
                                    assign init_color_value = value.label | handle | strip
                                    if swatch.image != blank
                                      assign color_image = swatch.image | image_url: width: 60
                                      assign color_value = 'url(' | append: color_image | append: ') no-repeat center/cover'
                                    elsif swatch.color != blank
                                      assign color_value = 'rgb(' | append: swatch.color.rgb | append: ')'
                                    endif
                                  else
                                    assign init_color_value = value.value | handle | strip
                                    assign color_value = init_color_value | remove: '-'
                                  endif

                                  # overwrite from custom colors textarea
                                  if settings.custom_colors != blank
                                    assign custom_colors_string = settings.custom_colors | strip
                                    assign custom_colors_obj = custom_colors_string | newline_to_br | split: '<br />'

                                    for obj in custom_colors_obj
                                      assign obj_strip = obj | strip
                                      assign obj_key = obj_strip | split: ':' | first
                                      assign obj_value = obj_strip | split: ':' | last
                                      assign obj_color_name = obj_key | handle | strip

                                      if init_color_value == obj_color_name
                                        assign obj_color_value = obj_value | strip
                                        if obj_color_value contains 'gradient'
                                          assign color_value = obj_color_value
                                        else
                                          assign color_value = obj_color_value | remove: '-'
                                        endif
                                        break
                                      endif
                                    endfor
                                  endif
                                endif
                              %}
                              <li
                                class="
                                  mobile-facets__item
                                  {% if is_color_filter -%} mobile-facets__item--color
                                  {% elsif presentation == 'image' %} mobile-facets__item--image {%- endif -%}
                                "
                                {% if is_color_filter %}
                                  style="--border-radius: {{ settings.swatch_border_radius }}px; --swatch-color: {{ color_value }};"
                                {% endif %}
                              >
                                <input
                                  class="mobile-facets__checkbox"
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  id="Filter-{{ filter.label | escape }}-mobile-{{ forloop.index }}"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                  {% if value.count == 0 and value.active == false %}
                                    disabled
                                  {% endif %}
                                >
                                <label
                                  for="Filter-{{ filter.label | escape }}-mobile-{{ forloop.index }}"
                                  class="
                                    mobile-facets__label{% if value.count == 0 and value.active == false %} mobile-facets__label--disabled{% endif %}
                                    {%- if is_color_filter -%} facet-checkbox facet-checkbox--color
                                    {% elsif presentation == 'image' %} facet-checkbox facet-checkbox--image {%- endif -%}
                                  "
                                >
                                  {%- if presentation == 'image' -%}
                                    <div
                                      class="facets__image-wrapper"
                                      style="--image_filter_ratio: {{ image_filter_ratio }}; --image_filter_fit: {{ image_filter_fit }};"
                                    >
                                      {% liquid
                                        if image_filter_ratio == '3/4'
                                          assign settings_aspect_ratio = 0.75
                                        elsif block.settings.aspect_ratio == '3/2'
                                          assign settings_aspect_ratio = 1.5
                                        else
                                          assign settings_aspect_ratio = 1
                                        endif

                                        assign calc_ratio = 1.1

                                        if value.image.aspect_ratio > settings_aspect_ratio
                                          assign calc_ratio = value.image.aspect_ratio | divided_by: settings_aspect_ratio | round: 2
                                        endif

                                        if image_filter_fit == 'contain'
                                          assign calc_ratio = 1
                                        endif
                                      %}
                                      {%- capture sizes -%}
                                        {%- if image_filter_columns == 1 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 568px), (min-width: 990px) calc({{ calc_ratio }} * 584px), (min-width: 750px) calc({{ calc_ratio }} * 95vw), (min-width: 576px) calc({{ calc_ratio }} * 95vw), calc({{ calc_ratio }} * 95vw)
                                        {%- elsif image_filter_columns == 2 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 278px), (min-width: 990px) calc({{ calc_ratio }} * 286px), (min-width: 750px) calc({{ calc_ratio }} * 49vw), (min-width: 576px) calc({{ calc_ratio }} * 48vw), calc({{ calc_ratio }} * 49vw)
                                        {%- elsif image_filter_columns == 3 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 182px), (min-width: 990px) calc({{ calc_ratio }} * 187px), (min-width: 750px) calc({{ calc_ratio }} * 33vw), (min-width: 576px) calc({{ calc_ratio }} * 32vw), calc({{ calc_ratio }} * 33vw)
                                        {%- elsif image_filter_columns == 4 -%}
                                          (min-width: 1200px) calc({{ calc_ratio }} * 133px), (min-width: 990px) calc({{ calc_ratio }} * 137px), (min-width: 750px) calc({{ calc_ratio }} * 25vw), (min-width: 576px) calc({{ calc_ratio }} * 23vw), calc({{ calc_ratio }} * 21vw)
                                        {%- endif -%}
                                      {%- endcapture -%}
                                      {%- if value.image -%}
                                        {{
                                          value.image
                                          | image_url: width: value.image.width
                                          | image_tag:
                                            class: 'facets__image',
                                            alt: value.alt,
                                            widths: '100, 140, 160, 180, 200, 220, 278, 296, 350, 400, 450, 568, 750, 800, 912, 1100, 1800',
                                            sizes: sizes,
                                            loading: 'lazy',
                                            fetchpriority: 'low'
                                        }}
                                      {%- endif -%}
                                    </div>
                                  {%- else -%}
                                    <span class="facet-checkbox__checkbox">
                                      {% render 'icon-checkmark' %}
                                    </span>
                                  {%- endif -%}
                                  <span class="facet-checkbox__label body-normal">
                                    {{ value.label | escape }}
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>

                          <div class="no-js-hidden mobile-facets__footer">
                            <facet-remove>
                              <a
                                href="{{ filter.url_to_remove }}"
                                class="mobile-facets__clear button button--transparent focus-inset"
                              >
                                <div class="button__content">
                                  <span class="button__label" data-label="{{- 'products.facets.clear' | t -}}">
                                    {{- 'products.facets.clear' | t -}}
                                  </span>
                                </div>
                                <span class="animated-button-circle"></span>
                              </a>
                            </facet-remove>
                            <button
                              type="button"
                              class="button button--primary focus-inset"
                            >
                              <div class="button__content">
                                <span class="button__label" data-label="{{- 'products.facets.apply' | t -}}">
                                  {{- 'products.facets.apply' | t -}}
                                </span>
                              </div>
                              <span class="animated-button-circle"></span>
                            </button>
                          </div>
                        </div>
                      </details>
                    {% when 'price_range' %}
                      <details
                        id="Details-Mobile-{{ forloop.index }}-{{ section.id }}"
                        class="mobile-facets__details js-filter"
                        data-index="mobile-{{ forloop.index }}"
                      >
                        <summary class="mobile-facets__summary">
                          <span class="mobile-facets__filter-label body-normal">{{ filter.label | escape }}</span>
                          <span class="mobile-facets__arrow">{% render 'icon-caret' %}</span>
                        </summary>
                        <div id="FacetMobile-{{ forloop.index }}-{{ section.id }}" class="mobile-facets__submenu">
                          <button
                            class="mobile-facets__close-button focus-inset no-js-hidden"
                            aria-expanded="true"
                            type="button"
                          >
                            <div class="mobile-facets__close-button-icon">
                              {% render 'icon-caret' %}
                            </div>
                            <span class="mobile-facets__close-button-label body-normal">
                              {{ filter.label | escape }}
                            </span>
                          </button>

                          <price-range class="facets__price">
                            <p class="mobile-facets__info">
                              {{- 0 | money | replace: ',', '' }} ‒
                              {{ filter.range_max | money | replace: ',', '' -}}
                            </p>

                            <div class="facets__price-wrapper">
                              <div class="field">
                                <label
                                  class="field__label body-small"
                                  for="Mobile-Filter-{{ filter.label | escape }}-GTE"
                                >
                                  {{- 'products.facets.from' | t -}}
                                </label>
                                <div class="field__input-wrapper">
                                  <span class="field__currency">{{ cart.currency.symbol }}</span>
                                  <input
                                    class="field__input"
                                    name="{{ filter.min_value.param_name }}"
                                    id="Mobile-Filter-{{ filter.label | escape }}-GTE"
                                    {% if filter.min_value.value %}
                                      value="{{ min_value | ceil }}"
                                    {% endif %}
                                    type="number"
                                    placeholder="0"
                                    min="0"
                                    max="{{ max_value | ceil }}"
                                    step="1"
                                    autocomplete="off"
                                    tabindex="0"
                                  >
                                </div>
                              </div>
                              <div class="field">
                                <label
                                  class="field__label body-small"
                                  for="Mobile-Filter-{{ filter.label | escape }}-LTE"
                                >
                                  {{- 'products.facets.to' | t -}}
                                </label>
                                <div class="field__input-wrapper">
                                  <span class="field__currency">{{ cart.currency.symbol }}</span>
                                  <input
                                    class="field__input"
                                    name="{{ filter.max_value.param_name }}"
                                    id="Mobile-Filter-{{ filter.label | escape }}-LTE"
                                    {% if filter.max_value.value %}
                                      value="{{ max_value | ceil }}"
                                    {% endif %}
                                    type="number"
                                    min="0"
                                    max="{{ filter_range_max | ceil }}"
                                    step="1"
                                    placeholder="{{ filter_range_max | ceil }}"
                                    tabindex="0"
                                  >
                                </div>
                              </div>
                            </div>
                            <div
                              class="facets__range no-js-hidden"
                              style="--range-min: {{ range_min }}%; --range-max: {{ range_max }}%"
                            >
                              <label class="visually-hidden" for="Filter-{{ filter.label | escape }}-Min-mobile">
                                {{- 'products.facets.from' | t -}}
                              </label>
                              <input
                                dir="ltr"
                                type="range"
                                value="{{ min_value | ceil }}"
                                min="0"
                                max="{{ filter_range_max | ceil }}"
                                step="1"
                                class="field__range"
                                id="Filter-{{ filter.label | escape }}-Min-mobile"
                              >
                              <label class="visually-hidden" for="Filter-{{ filter.label | escape }}-Max-mobile">
                                {{- 'products.facets.to' | t -}}
                              </label>
                              <input
                                dir="ltr"
                                type="range"
                                value="{{ max_value | ceil }}"
                                min="0"
                                max="{{ filter_range_max | ceil }}"
                                step="1"
                                class="field__range"
                                id="Filter-{{ filter.label | escape }}-Max-mobile"
                              >
                            </div>
                          </price-range>
                          <div class="no-js-hidden mobile-facets__footer">
                            <facet-remove>
                              <a
                                href="{{ filter.url_to_remove }}"
                                class="mobile-facets__clear button button--transparent focus-inset"
                              >
                                <div class="button__content">
                                  <span class="button__label" data-label="{{- 'products.facets.clear' | t -}}">
                                    {{- 'products.facets.clear' | t -}}
                                  </span>
                                </div>
                                <span class="animated-button-circle"></span>
                              </a>
                            </facet-remove>

                            <button
                              type="button"
                              class="button button--primary focus-inset"
                            >
                              <div class="button__content">
                                <span class="button__label" data-label="{{- 'products.facets.apply' | t -}}">
                                  {{- 'products.facets.apply' | t -}}
                                </span>
                              </div>
                              <span class="animated-button-circle"></span>
                            </button>
                          </div>
                        </div>
                      </details>
                  {% endcase %}
                {%- endfor -%}
              {% endif %}

              {%- if enable_sorting -%}
                <div class="mobile-facets__details js-filter" data-index="mobile-{{ forloop.index }}">
                  <div class="mobile-facets__summary">
                    <div class="mobile-facets__sort">
                      <label class="mobile-facets__sort-label body-normal" for="SortBy-mobile">
                        {{- 'products.facets.sort_by_label' | t -}}
                      </label>
                      <div class="select field">
                        <select
                          name="sort_by"
                          class="select__select focus-inset"
                          id="SortBy-mobile"
                          aria-describedby="a11y-refresh-page-message"
                        >
                          {%- for option in results.sort_options -%}
                            <option
                              value="{{ option.value | escape }}"
                              {% if option.value == sort_by %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ option.name | escape }}
                            </option>
                          {%- endfor -%}
                        </select>
                        {% render 'icon-caret' %}
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              <div class="mobile-facets__footer">
                <button
                  type="submit"
                  class="button button--primary focus-inset mobile-facets__footer__button"
                >
                  <div class="button__content">
                    <span class="button__label" data-label="{{- 'products.facets.apply' | t -}}">
                      {{- 'products.facets.apply' | t -}}
                    </span>
                  </div>
                  <span class="animated-button-circle"></span>
                </button>
                <facet-remove>
                  <a href="{{ results_url }}" class="mobile-facets__clear button button--transparent focus-inset">
                    <div class="button__content">
                      <span class="button__label" data-label="{{- 'products.facets.clear_all' | t -}}">
                        {{- 'products.facets.clear_all' | t -}}
                      </span>
                    </div>
                    <span class="animated-button-circle"></span>
                  </a>
                </facet-remove>
              </div>
            </div>

            {% if results.current_vendor or results.current_type %}
              <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
            {% endif %}

            {%- if results.terms -%}
              <input type="hidden" name="q" value="{{ results.terms | escape }}">
              <input name="options[prefix]" type="hidden" value="last">
            {%- endif -%}
          </div>
        </form>
      </facet-filters-form>
    </details>
  </menu-drawer>

  <div class="active-facets active-facets-mobile medium-hide large-up-hide">
    {%- for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        <facet-remove>
          <a href="{{ value.url_to_remove }}" class="active-facets__button focus-inset">
            <span class="active-facets__button-inner">
              <span class="body-normal">{{- value.label | escape -}}</span>
              {% render 'icon-facets-remove' %}
              <span class="visually-hidden">{{- 'products.facets.clear_filter' | t -}}</span>
            </span>
          </a>
        </facet-remove>
      {%- endfor -%}

      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != null or filter.max_value.value != null -%}
          <facet-remove>
            <a href="{{ filter.url_to_remove }}" class="active-facets__button focus-inset">
              <span class="active-facets__button-inner body-normal">
                <span>
                  {%- if filter.min_value.value -%}
                    {{ filter.min_value.value | money }}
                  {%- else -%}
                    {{ 0 | money }}
                  {%- endif -%}
                  —
                  {% if filter.max_value.value %}
                    {{ filter.max_value.value | money }}
                  {% else -%}
                    {{ filter.range_max | money }}
                  {%- endif -%}
                </span>
                {% render 'icon-facets-remove' %}
                <span class="visually-hidden">{{- 'products.facets.clear_filter' | t -}}</span>
              </span>
            </a>
          </facet-remove>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    <facet-remove>
      <a href="{{ results_url }}" class="active-facets__button-remove focus-inset">
        <span>{{- 'products.facets.clear_all' | t -}}</span>
      </a>
    </facet-remove>
  </div>

  <span id="ProductCount" class="visibility-hidden">
    {%- if results.all_products_count and results.products_count -%}
      {%- if results.products_count == results.all_products_count -%}
        {{- 'products.facets.product_count_simple' | t: count: results.all_products_count -}}
      {%- else -%}
        {{-
          'products.facets.product_count'
          | t: product_count: results.products_count, count: results.all_products_count
        -}}
      {%- endif -%}
    {%- else -%}
      {{- 'templates.search.results' | t: terms: results.terms, count: results.results_count -}}
    {%- endif -%}
  </span>
</div>
