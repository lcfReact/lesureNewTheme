{% liquid
  assign is_show_socials = false

  if section.settings.enable_social and settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_linkedin_link != blank
    assign is_show_socials = true
  endif
%}

<header-drawer data-breakpoint="tablet">
  <details class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span class="header__icon-wrapper">
        {% render 'icon-hamburger' %}
      </span>
    </summary>
    <div
      id="menu-drawer"
      class="menu-drawer motion-reduce color-{{ section.settings.color_scheme_modal }}"
      tabindex="-1"
    >
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__top container">
          <button class="header__modal-close-button" type="button" aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon-close' %}
          </button>
          <div class="menu-drawer__logo">
            {% render 'header-logo', tag: 'span', logo_image: section.settings.logo_burger %}
          </div>
          <div class="menu-drawer__cart">
            {% render 'header-cart', id: 'burger' %}
          </div>
        </div>
        <div class="menu-drawer__main">
          <div class="menu-drawer__navigation-container container">
            <nav class="menu-drawer__navigation">
              <ul class="menu-drawer__menu" role="list">
                {%- for link in section.settings.menu.links -%}
                  <li class="menu-drawer__menu-item">
                    {%- if link.links != blank -%}
                      <details>
                        <summary class="menu-drawer__menu-summary focus-inset">
                          <a
                            href="{{ link.url }}"
                            class="menu-drawer__menu-link focus-inset{% if link.current %} menu-drawer__menu-link--active{% endif %}"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                            {% if settings.links_blank and link.type == 'http_link' %}
                              target="_blank"
                            {% endif %}
                            tabindex="0"
                            data-handle="{{ link.handle }}"
                          >
                            {{- link.title | escape -}}
                          </a>
                          {% render 'icon-caret-mobile-menu' %}
                        </summary>
                        <div
                          class="menu-drawer__submenu motion-reduce"
                          tabindex="-1"
                        >
                          <div class="menu-drawer__inner-submenu">
                            <ul
                              class="menu-drawer__menu list-menu"
                              role="list"
                              tabindex="-1"
                            >
                              {%- for childlink in link.links -%}
                                <li class="menu-drawer__menu-item">
                                  {%- if childlink.links == blank -%}
                                    <a
                                      href="{{ childlink.url }}"
                                      class="menu-drawer__menu-link focus-inset{% if childlink.current %} menu-drawer__menu-link--active{% endif %} childlink"
                                      {% if childlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                      {% if settings.links_blank and childlink.type == 'http_link' %}
                                        target="_blank"
                                      {% endif %}
                                      tabindex="0"
                                    >
                                      {{- childlink.title | escape -}}
                                    </a>
                                  {%- else -%}
                                    <details>
                                      <summary class="menu-drawer__menu-summary focus-inset childlink">
                                        <a
                                          href="{{ childlink.url }}"
                                          class="menu-drawer__menu-link focus-inset{% if childlink.current %} menu-drawer__menu-link--active{% endif %}"
                                          {% if childlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                          {% if settings.links_blank and childlink.type == 'http_link' %}
                                            target="_blank"
                                          {% endif %}
                                          tabindex="0"
                                        >
                                          {{- childlink.title | escape -}}
                                        </a>
                                        {% render 'icon-caret-mobile-menu' %}
                                      </summary>
                                      <div
                                        id="childlink-{{ childlink.title | escape }}"
                                        class="menu-drawer__submenu motion-reduce"
                                      >
                                        <ul
                                          class="menu-drawer__menu list-menu"
                                          role="list"
                                          tabindex="-1"
                                        >
                                          {%- for grandchildlink in childlink.links -%}
                                            <li class="menu-drawer__menu-item grandchildlink">
                                              <a
                                                href="{{ grandchildlink.url }}"
                                                class="menu-drawer__menu-link focus-inset{% if grandchildlink.current %} menu-drawer__menu-link--active{% endif %}"
                                                {% if grandchildlink.current %}
                                                  aria-current="page"
                                                {% endif %}
                                                {% if settings.links_blank and grandchildlink.type == 'http_link' %}
                                                  target="_blank"
                                                {% endif %}
                                                tabindex="0"
                                              >
                                                {{- grandchildlink.title | escape -}}
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      </div>
                                    </details>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </div>
                      </details>
                    {%- else -%}
                      <a
                        href="{{ link.url }}"
                        class="menu-drawer__menu-link focus-inset{% if link.current %} menu-drawer__menu-link--active{% endif %}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                        {% if settings.links_blank and link.type == 'http_link' %}
                          target="_blank"
                        {% endif %}
                        tabindex="0"
                        data-handle="{{ link.handle }}"
                      >
                        {{- link.title | escape -}}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </div>
        </div>

        <div class="menu-drawer__bottom container">
          {%- if is_show_socials -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_twitter_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-twitter' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.twitter' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_facebook_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-facebook' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.facebook' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_pinterest_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-pinterest' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.pinterest' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_instagram_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-instagram' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.instagram' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_tiktok_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-tiktok' -%}
                    <span class="visually-hidden">
                      {{ 'general.social.links.tiktok' | t }}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_tumblr_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-tumblr' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.tumblr' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_snapchat_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-snapchat' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.snapchat' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_youtube_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-youtube' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.youtube' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_vimeo_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-vimeo' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.vimeo' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_linkedin_link != blank -%}
                <li class="list-social__item">
                  <a
                    href="{{ settings.social_linkedin_link }}"
                    {% if settings.links_blank %}
                      target="_blank"
                    {% endif %}
                    class="list-social__link"
                    aria-describedby="a11y-external-message"
                    tabindex="0"
                  >
                    {%- render 'icon-linkedin' -%}
                    <span class="visually-hidden">
                      {{- 'general.social.links.linkedin' | t -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.enable_search
            or shop.customer_accounts_enabled
            or section.settings.enable_country_selector
            or section.settings.enable_language_selector
          -%}
            <div class="menu-drawer__bottom-main">
              {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
                <div class="menu-drawer__localization-wrapper">
                  {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
                    <div class="header__localization menu-drawer__localization">
                      <localization-form>
                        {%- form 'localization', id: 'HeaderCountryFormMobile', class: 'localization-form' -%}
                          <div class="no-js-hidden">
                            <div class="disclosure">
                              <button
                                type="button"
                                class="header__localization-button disclosure__button localization-selector body-small focus-inset"
                                aria-expanded="false"
                                aria-controls="HeaderCountryListMobile"
                              >
                                {%- if section.settings.show_country_flag -%}
                                  <span class="currency-flag currency-country" aria-hidden="true">
                                    {{- localization.country | image_url: width: 40 | image_tag: class: 'currency-flag-img' -}}
                                  </span>
                                {%- endif -%}
                                <span class="currency-country">
                                  {{- localization.country.currency.iso_code -}}
                                  {{- localization.country.currency.symbol -}}
                                </span>
                                {% render 'icon-caret' %}
                              </button>
                              <div class="disclosure__list-wrapper color-background-1 background" hidden>
                                <ul
                                  id="HeaderCountryListMobile"
                                  role="list"
                                  class="disclosure__list list-unstyled"
                                >
                                  {%- for country in localization.available_countries -%}
                                    <li
                                      class="disclosure__item{% if country.iso_code == localization.country.iso_code %} disclosure__item--active{% endif %}"
                                      tabindex="-1"
                                    >
                                      <a class="link link--text disclosure__link body-small caption-large{% if country.iso_code == localization.country.iso_code %} disclosure__link--active{% endif %} focus-inset" href="#"{% if country.iso_code == localization.country.iso_code %} aria-current="true"{% endif %} data-value="{{ country.iso_code }}">
                                          {%- if section.settings.show_country_flag -%}
                                            <span class="currency-flag" aria-hidden="true">
                                              {{- country | image_url: width: 40 | image_tag: class: 'currency-flag-img' -}}
                                            </span>
                                          {%- endif -%}
                                          <span class="disclosure__country-name">
                                            {{ country.name }}
                                          </span>
                                          <span class="localization-form__currency">({{ country.currency.iso_code }} {{ country.currency.symbol }})</span>
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            </div>
                            <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                          </div>
                        {%- endform -%}
                      </localization-form>
                    </div>
                  {%- endif -%}
                  {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                    <div class="header__localization menu-drawer__localization header__localization--language">
                      <localization-form>
                        {%- form 'localization', id: 'HeaderLanguageFormMobile', class: 'localization-form' -%}
                          <div class="no-js-hidden">
                            <div class="disclosure">
                              <button
                                type="button"
                                class="header__localization-button header__localization-lang-button disclosure__button localization-selector body-small focus-inset"
                                aria-expanded="false"
                                aria-controls="HeaderLanguageListMobile"
                              >
                                <span class="value">
                                  {{- localization.language.iso_code | upcase -}}
                                </span>
                                {% render 'icon-caret' -%}
                              </button>
                              <div class="disclosure__list-wrapper color-background-1 background" hidden>
                                <ul
                                  id="HeaderLanguageListMobile"
                                  role="list"
                                  class="disclosure__list list-unstyled"
                                >
                                  {%- for language in localization.available_languages -%}
                                    <li
                                      class="disclosure__item{% if language.iso_code == localization.language.iso_code %} disclosure__item--active{% endif %}"
                                      tabindex="-1"
                                    >
                                      <a
                                        class="disclosure__link body-small {% if language.iso_code == localization.language.iso_code %} disclosure__link--active{% endif %} focus-inset"
                                        href="#"
                                        hreflang="{{ language.iso_code }}"
                                        lang="{{ language.iso_code }}"
                                        {% if language.iso_code == localization.language.iso_code %}
                                          aria-current="true"
                                        {% endif %}
                                        data-value="{{ language.iso_code }}"
                                      >
                                        <span>
                                          {{ language.endonym_name | capitalize }}
                                        </span>
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            </div>
                            <input
                              type="hidden"
                              name="locale_code"
                              value="{{ localization.language.iso_code }}"
                            >
                          </div>
                        {%- endform -%}
                      </localization-form>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.enable_search or shop.customer_accounts_enabled -%}
                <div class="menu-drawer__search-and-account">
                  {%- if section.settings.enable_search -%}
                    {% render 'header-search', section: section, additional_id: 'HeaderDrawer' %}
                  {%- endif -%}

                  {%- if shop.customer_accounts_enabled -%}
                    {% render 'header-account' %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </details>
</header-drawer>
