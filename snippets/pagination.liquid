{% comment %}
  Renders a set of links for paginated results. Must be used within paginate tags.

  Usage:
  {% paginate results by 2 %}
    {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
  {% endpaginate %}

  Accepts:
  - paginate: {Object}
  - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
  - class: {String} (optional) Appended to container element's class attribute
{% endcomment %}

{{ 'component-pagination.css' | asset_url | stylesheet_tag }}

{%- if paginate.parts.size > 0 -%}
  <div class="{{ class | default: 'pagination-wrapper' }} no-js-block" data-page="{{ paginate.current_page }}">
    <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
      <ul class="pagination__list list-unstyled" role="list">
        {%- if paginate.previous -%}
          <li>
            <a
              href="{{ paginate.previous.url }}{{ anchor }}"
              class="pagination__item-btn pagination__item-btn--prev motion-reduce"
              aria-label="{{ 'general.pagination.previous' | t }}"
            >
              <div class="pagination__item-btn__content">
                <div class="pagination__item-btn__icons">
                  <span class="pagination__item-btn__icon pagination__item-btn__icon--1">
                    {% render 'icon-btn-arrow' %}
                  </span>
                  <span class="pagination__item-btn__icon pagination__item-btn__icon--2">
                    {% render 'icon-btn-arrow' %}
                  </span>
                </div>
              </div>
              <span class="pagination__item-btn__circle"></span>
            </a>
          </li>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          <li>
            {%- if part.is_link -%}
              <a
                href="{{ part.url }}{{ anchor }}"
                class="pagination__item pagination__item--link"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                <span class="body-normal" title="{{ part.title }}"> {{ part.title }}</span>
              </a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <span
                  class="pagination__item pagination__item--current body-normal"
                  aria-current="page"
                  aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                >
                  {{- part.title -}}
                </span>
              {%- else -%}
                <span class="pagination__item body-normal">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}

        {%- if paginate.next -%}
          <li>
            <a
              href="{{ paginate.next.url }}{{ anchor }}"
              class="pagination__item-btn pagination__item-btn--next motion-reduce"
              aria-label="{{ 'general.pagination.next' | t }}"
            >
              <div class="pagination__item-btn__content">
                <div class="pagination__item-btn__icons">
                  <span class="pagination__item-btn__icon pagination__item-btn__icon--1">
                    {% render 'icon-btn-arrow' %}
                  </span>
                  <span class="pagination__item-btn__icon pagination__item-btn__icon--2">
                    {% render 'icon-btn-arrow' %}
                  </span>
                </div>
              </div>
              <span class="pagination__item-btn__circle"></span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
{%- endif -%}
