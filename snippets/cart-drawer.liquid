{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

<cart-drawer
  class="drawer{% if cart == empty %} is-empty{% endif %}"
  style="--cart-bg: {{ settings.cart_drawer_background | default: '#F7F3E8' }}; --cart-upsell-bg: {{ settings.cart_upsell_background | default: '#E6D8F7' }}; --cart-btn: {{ settings.cart_button_background | default: '#F5D400' }}; --cart-btn-text: {{ settings.cart_button_text | default: '#171717' }}; --cart-progress: {{ settings.cart_progress_color | default: '#6B4CFF' }};"
>
  <style>
    .drawer {
      visibility: hidden;
    }
  </style>
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="drawer__overlay"></div>
    <button
      type="button"
      class="cart-drawer__close-btn"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {% render 'icon-modal-close' %}
    </button>
    <div
      class="drawer__inner color-{{ settings.drawer_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t: count: cart.item_count }}"
      tabindex="-1"
    >
      {% comment %} DRAWER HEADER {% endcomment %}
      <div class="drawer__header color-{{ settings.drawer_header_color_scheme }}">
        <div class="drawer__header-title body-xl">
          {{ 'general.cart.item_added' | t: count: cart.item_count }}
        </div>
        <button
          type="button"
          class="drawer__header-close focus-inset modal-close-button focus-inset body-normal"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-modal-close' %}
        </button>
      </div>

      {% comment %} DRAWER FREE SHIPPING {% endcomment %}
      {%- if cart != empty and settings.show_shipping -%}
        {% render 'cart-shipping-slider', cart: cart %}
      {%- endif -%}

      {% comment %} DRAWER CART EMPTY BLOCK {% endcomment %}
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="drawer__empty-wrapper">
            <p class="drawer__empty-title body-xl">
              {%- if settings.title_empty_cart != blank -%}
                {{ settings.title_empty_cart }}
              {%- else -%}
                {{ 'general.cart.empty_cart' | t }}
              {%- endif -%}
            </p>
            {% if settings.text_empty_cart != blank %}
              <p class="drawer__empty-desc body-normal">{{ settings.text_empty_cart }}</p>
            {%- endif -%}
            {% liquid
              assign button_label = 'general.cart.button_label' | t
              if settings.button_label_empty_cart != blank
                assign button_label = settings.button_label_empty_cart
              endif
              assign button_link = routes.all_products_collection_url
              if settings.button_link_empty_cart != blank
                assign button_link = settings.button_link_empty_cart
              endif
              assign upsell_heading_empty = settings.cart_upsell_heading_empty
              if upsell_heading_empty == blank
                assign upsell_heading_empty = 'general.cart.upsell_heading_empty' | t
              endif
            %}
            <a class="cart-drawer__continue" href="{{ button_link }}">{{ button_label }}</a>
            {%- if customer == blank -%}
              <p class="cart-drawer__login">
                {{ 'general.cart.login_prompt' | t }}
                <a href="{{ routes.account_login_url }}">{{ 'general.cart.login_link' | t }}</a>
              </p>
            {%- endif -%}
          </div>
          {% render 'cart-drawer-upsell', heading: upsell_heading_empty %}
        </div>
      {%- endif -%}

      {% comment %} DRAWER CART ITEMS {% endcomment %}
      <cart-drawer-items class="{% if cart == empty %}is-empty{% endif %}">
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                {%- for item in cart.items -%}
                  <div
                    id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                    class="cart-item cart-item--drawer"
                  >
                    <div class="cart-item__inner-top">
                      {% liquid
                        case settings.cart_image_ratio
                          when 'landscape'
                            assign ratio = '4/3'
                            assign settings_aspect_ratio = 1.33
                          when 'portrait'
                            assign ratio = '106/131'
                            assign settings_aspect_ratio = 0.8
                          when 'square'
                            assign ratio = '1/1'
                            assign settings_aspect_ratio = 1
                        endcase

                        assign aspect_ratio = ratio | split: '/'
                        assign temp = aspect_ratio[0] | append: '.0'
                        assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2

                        assign calc_ratio = 1

                        if settings.cart_image_fit == 'cover' and item.image.aspect_ratio > settings_aspect_ratio
                          assign calc_ratio = item.image.aspect_ratio | divided_by: settings_aspect_ratio | round: 2
                        endif
                      %}
                      {%- if item.image -%}
                        <div class="cart-item__left">
                          <div
                            class="cart-item__media"
                            style="padding-bottom: {{ padding_bottom }}%"
                          >
                            {%- capture img_sizes -%}
                              (min-width: 576px) calc({{ calc_ratio }} * 102px), calc({{ calc_ratio }} * 70px)
                            {%- endcapture -%}
                            {%- capture image_styles -%}
                              object-fit: {{ settings.cart_image_fit }};
                            {%- endcapture -%}
                            <a
                              href="{{ item.url }}"
                              class="cart-item__link focus-inset"
                              aria-label="{{ 'accessibility.product_link' | t }}"
                            ></a>
                            {{
                              item.image
                              | image_url: width: item.image.width
                              | image_tag:
                                loading: 'lazy',
                                widths: '70, 102, 140, 204, 210, 306, 550, 750, 990, 1200, 1500, 1800, 2000',
                                sizes: img_sizes,
                                class: 'cart-item__image',
                                style: image_styles
                            }}
                          </div>
                        </div>
                      {%- else -%}
                        <div class="cart-item__left">
                          <div class="cart-item__media" style="padding-bottom: {{ padding_bottom }}%">
                            <a
                              href="{{ item.url }}"
                              class="cart-item__link focus-inset"
                              aria-label="{{ 'accessibility.product_link' | t }}"
                            >
                              {{ 'image' | placeholder_svg_tag: 'cart-item__image placeholder-svg' }}
                            </a>
                          </div>
                        </div>
                      {%- endif -%}

                      <div class="cart-item__details">
                        <div class="cart-item__details-wrapper">
                          <div class="cart-item__info">
                            <div class="cart-item__line">
                              <div class="cart-item__line-group">
                                {%- if settings.cart_show_vendor -%}
                                  <div class="cart-item__vendor body-xs">
                                    {% if settings.enable_vendor_link %}
                                      {{ item.product.vendor | link_to_vendor: class: 'focus-inset' }}
                                    {% else %}
                                      {{ item.product.vendor }}
                                    {% endif %}
                                  </div>
                                {% endif %}

                                <a href="{{ item.url }}" class="cart-item__name focus-inset">
                                  {{ item.product.title | escape }}
                                </a>
                              </div>

                              <div class="cart-item__price-wrapper h6">
                                {%- if item.original_price != item.final_price -%}
                                  <div class="cart-item__discounted-prices">
                                    <span class="visually-hidden">
                                      {{ 'products.product.price.sale_price' | t }}
                                    </span>
                                    <span class="cart-item__final-price cart-item__final-price_sale">
                                      {% if settings.currency_code_enabled %}
                                        {{ item.final_line_price | money_with_currency }}
                                      {% else %}
                                        {{ item.final_line_price | money }}
                                      {% endif %}
                                    </span>
                                    <span class="visually-hidden">
                                      {{ 'products.product.price.regular_price' | t }}
                                    </span>
                                    <s class="cart-item__old-price">
                                      {% if settings.currency_code_enabled %}
                                        {{- item.original_line_price | money_with_currency -}}
                                      {% else %}
                                        {{- item.original_line_price | money -}}
                                      {% endif %}
                                    </s>
                                  </div>
                                {%- else -%}
                                  <div class="cart-item__final-price">
                                    {% if settings.currency_code_enabled %}
                                      {{ item.original_line_price | money_with_currency }}
                                    {% else %}
                                      {{ item.original_line_price | money }}
                                    {% endif %}
                                  </div>
                                {%- endif -%}

                                {%- if item.variant.available and item.unit_price_measurement -%}
                                  <div class="unit-price">
                                    <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                                    {% if settings.currency_code_enabled %}
                                      {{ item.variant.unit_price | money_with_currency }}
                                    {% else %}
                                      {{ item.variant.unit_price | money }}
                                    {% endif %}
                                    <span aria-hidden="true">/</span>
                                    <span class="visually-hidden"
                                      >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                                    >
                                    {%- if item.unit_price_measurement -%}
                                      {% render 'unit-price', line_item: item %}
                                    {%- endif -%}
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>

                            {% comment %} render options {% endcomment %}
                            {%- if item.product.has_only_default_variant == false -%}
                              <p class="cart-item__variant">
                                {%- for option in item.options_with_values -%}
                                  {{- option.value -}}
                                  {%- unless forloop.last -%}, {% endunless -%}
                                {%- endfor -%}
                              </p>
                            {%- endif -%}

                            {% comment %} render properties {% endcomment %}
                            {%- if item.properties != blank -%}
                              <dl class="product-option__group">
                                {%- for property in item.properties -%}
                                  {%- assign property_first_char = property.first | slice: 0 -%}
                                  {%- if property.last != blank and property_first_char != '_' -%}
                                    <div class="product-option body-xs">
                                      <dt>{{ property.first }}:</dt>
                                      <dd>
                                        {%- if property.last contains '/uploads/' -%}
                                          <a
                                            href="{{ property.last }}"
                                            class="link"
                                            target="_blank"
                                          >
                                            {{ property.last | split: '/' | last }}
                                          </a>
                                        {%- else -%}
                                          {{ property.last }}
                                        {%- endif -%}
                                      </dd>
                                    </div>
                                  {%- endif -%}
                                {%- endfor -%}
                              </dl>
                            {%- endif -%}

                            {% comment %} render selling_plan_allocation {% endcomment %}
                            {%- if item.selling_plan_allocation != blank -%}
                              <p class="product-option body-xs">
                                {{ item.selling_plan_allocation.selling_plan.name }}
                              </p>
                            {%- endif -%}

                            {% comment %} render discounts {% endcomment %}
                            {%- if item.line_level_discount_allocations.size != 0 -%}
                              <ul
                                class="discounts list-unstyled"
                                role="list"
                                aria-label="{{ 'customer.order.discount' | t }}"
                              >
                                {%- for discount in item.line_level_discount_allocations -%}
                                  {% liquid
                                    if settings.currency_code_enabled
                                      assign discount_total = discount.discount_application.total_allocated_amount | money_with_currency
                                    else
                                      assign discount_total = discount.discount_application.total_allocated_amount | money
                                    endif
                                  %}
                                  <li class="discounts__discount">
                                    {%- render 'icon-discount' -%}
                                    {{ discount.discount_application.title }}
                                    (-{{ discount_total }})
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        </div>

                        <div
                          id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                          class="cart-item__error"
                          role="alert"
                        >
                          <small class="cart-item__error-text"></small>
                          {% render 'icon-error' %}
                        </div>

                        <div class="cart-item__bottom">
                          <div class="cart-item__bottom-controls">
                            <div class="cart-item__quantity-wrapper">
                              <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                                {{ 'products.product.quantity.label' | t }}
                              </label>
                              <quantity-input class="quantity quantity--cart">
                                <button
                                  class="quantity__button no-js-hidden focus-inset"
                                  name="minus"
                                  type="button"
                                >
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.decrease'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  {% render 'icon-minus' %}
                                </button>
                                <input
                                  class="quantity__input focus-inset"
                                  type="number"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  min="{{ item.variant.quantity_rule.min | default: 0 }}"
                                  {% if item.variant.quantity_rule.max %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment | default: 1 }}"
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                  id="Quantity-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                <button
                                  class="quantity__button no-js-hidden focus-inset"
                                  name="plus"
                                  type="button"
                                >
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.increase'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  {% render 'icon-plus' %}
                                </button>
                              </quantity-input>
                            </div>

                            <cart-remove-button
                              id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                              <button
                                type="button"
                                class="body-xs focus-inset"
                                aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                              >
                                <span>{% render 'icon-remove' %}</span>
                              </button>
                            </cart-remove-button>
                          </div>

                          {% if item.quantity > 1 %}
                            <div class="cart-item__total-price">
                              <div class="cart-item__price-wrapper h6">
                                {%- if item.original_line_price != item.final_line_price -%}
                                  <dl class="cart-item__discounted-prices">
                                    <dt class="visually-hidden">
                                      {{ 'products.product.price.sale_price' | t }}
                                    </dt>
                                    <dd class="cart-item__final-price cart-item__final-price_sale">
                                      {% if settings.currency_code_enabled %}
                                        {{ item.final_line_price | money_with_currency }}
                                      {% else %}
                                        {{ item.final_line_price | money }}
                                      {% endif %}
                                    </dd>
                                    <dt class="visually-hidden">
                                      {{ 'products.product.price.regular_price' | t }}
                                    </dt>
                                    <dd>
                                      <s class="cart-item__old-price">
                                        {% if settings.currency_code_enabled %}
                                          {{ item.original_line_price | money_with_currency }}
                                        {% else %}
                                          {{ item.original_line_price | money }}
                                        {% endif %}
                                      </s>
                                    </dd>
                                  </dl>
                                {%- else -%}
                                  <span class="cart-item__final-price">
                                    {% if settings.currency_code_enabled %}
                                      {{ item.original_line_price | money_with_currency }}
                                    {% else %}
                                      {{ item.original_line_price | money }}
                                    {% endif %}
                                  </span>
                                {%- endif -%}
                              </div>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>

                    <div class="loading-overlay hidden">
                      <div class="loading-overlay__spinner">
                        {% render 'icon-loading' %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {%- endif -%}
            <p
              id="CartDrawer-LiveRegionText"
              class="visually-hidden"
              role="status"
            ></p>
            <p
              id="CartDrawer-LineItemStatus"
              class="visually-hidden"
              aria-hidden="true"
              role="status"
            >
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
        {%- if cart != empty -%}
          {% liquid
            assign upsell_heading = settings.cart_upsell_heading
            if upsell_heading == blank
              assign upsell_heading = 'general.cart.upsell_heading' | t
            endif
          %}
          {% render 'cart-drawer-upsell', heading: upsell_heading %}
        {%- endif -%}
      </cart-drawer-items>

      {% comment %} DRAWER FOOTER {% endcomment %}
      <div class="drawer__footer">
        <div class="cart-drawer__footer">
          <div class="totals" role="status">
            <div class="totals__main">
              <div class="totals__text">
                <p class="totals__subtotal body-normal">
                  {{- 'sections.cart.subtotal' | t -}}
                </p>
              </div>

              <div class="totals__subtotal-value body-normal">
                <span>{{ cart.total_price | money_with_currency }}</span>
                <div class="loading-overlay hidden">
                  <div class="loading-overlay__spinner">
                    {% render 'icon-loading' %}
                  </div>
                </div>
              </div>
            </div>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul
                class="discounts list-unstyled"
                role="list"
                aria-label="{{ 'customer.order.discount' | t }}"
              >
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount">
                    {%- render 'icon-discount' -%}
                    {{ discount.title }}
                    (-
                    {%- if settings.currency_code_enabled %}
                      {{ discount.total_allocated_amount | money_with_currency }}
                    {% else %}
                      {{ discount.total_allocated_amount | money }}
                    {% endif -%}
                    )
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>

        {%- if settings.show_cart_note_drawer or settings.show_discount_code_field_drawer -%}
          <div class="cart-drawer__fields">
            {%- if settings.show_cart_note_drawer -%}
              <details id="Details-CartDrawer-Note" class="cart__note-details">
                <summary class="cart__note-summary">
                  <span class="cart__note-summary-text body-xs">
                    {{- 'sections.cart.note' | t -}}
                  </span>
                  <div class="cart__note-summary-icon">
                    {% render 'icon-caret' %}
                  </div>
                </summary>
                <cart-note class="cart__note field h5">
                  <label for="CartDrawer-note" class="visually-hidden">
                    {{- 'sections.cart.note' | t -}}
                  </label>
                  <textarea
                    class="text-area field__input"
                    name="note"
                    id="CartDrawer-note"
                    placeholder="{{- 'sections.cart.note_placeholder' | t -}}"
                  >{{ cart.note }}</textarea>

                  <span class="cart__note-loading">
                    {% render 'icon-loading' %}
                  </span>
                  <span class="cart__note-success">
                    {% render 'icon-success' %}
                  </span>
                </cart-note>
              </details>
            {%- endif -%}

            {%- if settings.show_discount_code_field_drawer -%}
              <details id="Details-CartDrawer-Discount" class="cart__note-details">
                <summary class="cart__note-summary">
                  <span class="cart__note-summary-text body-xs">
                    {{- 'general.cart.discount_code_label' | t -}}
                  </span>
                  <div class="cart__note-summary-icon">
                    {% render 'icon-caret' %}
                  </div>
                </summary>
                {% render 'cart-discount-code', cart: cart, section_id: 'cart-drawer' %}
              </details>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="cart-drawer__bottom">
          <noscript>
            <button
              type="submit"
              class="cart__update-button button button--tertiary focus-inset"
              form="CartDrawer-Form"
            >
              {{ 'sections.cart.update' | t }}
            </button>
          </noscript>
          <div class="cart-drawer__buttons">
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="cart__checkout-button button button--primary focus-inset"
              name="checkout"
              form="CartDrawer-Form"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              <div class="button__content">
                <span class="button__label" data-label="{{- 'sections.cart.proceed_checkout' | t -}}">
                  {{- 'sections.cart.proceed_checkout' | t -}}
                </span>
              </div>
              <span class="animated-button-circle"></span>
            </button>
          </div>
          <p class="cart-drawer__tax-note">{{ 'sections.cart.drawer_tax_note' | t }}</p>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isIE() {
      const ua = window.navigator.userAgent;
      const msie = ua.indexOf('MSIE ');
      const trident = ua.indexOf('Trident/');

      return msie > 0 || trident > 0;
    }

    if (!isIE()) return;
    const cartSubmitInput = document.createElement('input');
    cartSubmitInput.setAttribute('name', 'checkout');
    cartSubmitInput.setAttribute('type', 'hidden');
    document.querySelector('#cart').appendChild(cartSubmitInput);
    document.querySelector('#checkout').addEventListener('click', function (event) {
      document.querySelector('#cart').submit();
    });
  });
</script>
