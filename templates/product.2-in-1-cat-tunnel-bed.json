    "collapsible_content_QWr3Hx": {
      "type": "collapsible-content",
      "blocks": {
        "accordion_j47PCH": {
          "type": "accordion",
          "settings": {
            "question": "Is there a weight limit for Lesure litter box?",
            "answer": "<p>Must be used with cats weighing at least 3.3 lbs (1.5 kg) and taller than 6 inches.<br/><br/></p>",
            "opened": true
          }
        },
        "accordion_8Qax64": {
          "type": "accordion",
          "settings": {
            "question": "How does it keep my cat safe?",
            "answer": "<p>Equipped with 6 sweeping infrared sensors for instant safety, day or night. The Pinch-Free Rotation System keeps gear movement within a safe angle, preventing pinching for a worry-free cat experience.</p>",
            "opened": false
          }
        },
        "accordion_W9TKJ8": {
          "type": "accordion",
          "settings": {
            "question": "What types of cat litter should I use for Lesure litter box?",
            "answer": "<p>Comes with two litter sifters: Vertical Strip Mesh for tofu/mixed litter, Butterfly Mesh for mineral/bentonite litter.</p>",
            "opened": false
          }
        },
        "accordion_J8WUh9": {
          "type": "accordion",
          "settings": {
            "question": "How do I train my cat to use Lesure litter box?",
            "answer": "<p>Most cats adapt easily, but some may need time to get used to the new litter box. Follow these tips to help your cat transition smoothly:</p><ol><li><strong>Place Side by Side: </strong>Keep the new litter box next to the old one. Allow your cat to use both for at least a week (longer if needed, depending on temperament).</li><li><strong>Mix in Familiar Litter: </strong>Add a small amount of old litter to the new box to create a familiar scent.</li><li><strong>Adjust Cleaning Frequency: </strong>Reduce cleaning of the old litter box, since cats prefer clean litter.</li><li><strong>Remove the Old Box: </strong>Once your cat consistently uses the new box, remove the old one.<br/><br/></li></ol>",
            "opened": false
          }
        }
      },
